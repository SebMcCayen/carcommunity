{
  "name": "@carcommunity/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./auth": {
      "types": "./dist/auth.d.ts",
      "default": "./dist/auth.js"
    },
    "./feature-flags": {
      "types": "./dist/feature-flags.d.ts",
      "default": "./dist/feature-flags.js"
    },
    "./live-location": {
      "types": "./dist/live-location.d.ts",
      "default": "./dist/live-location.js"
    },
    "./users": {
