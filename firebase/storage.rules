rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // -------------------------------------------------------------------------
    // Helper functions
    // -------------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // Mirrors the Firestore rules helpers: suspension is a server-managed
    // custom claim and always overrides feature access.
    function isNotSuspended() {
      return !('suspended' in request.auth.token) || request.auth.token.suspended != true;
    }

    function isActiveMember() {
      return isAuthenticated() && request.auth.token.activeMember == true && isNotSuspended();
    }

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    function isUnderMB(mb) {
      return request.resource.size <= mb * 1024 * 1024;
    }

    // -------------------------------------------------------------------------
    // Deny-all catch-all (rules below override for specific paths)
    // -------------------------------------------------------------------------
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Profile images:  profileImages/{userId}/{imageId}
    // Owner may upload images up to 5 MB. Any authenticated user may read.
    // -------------------------------------------------------------------------
    match /profileImages/{userId}/{imageId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) && isImage() && isUnderMB(5);
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Vehicle images:  vehicleImages/{userId}/{imageId}
    // Owner may upload images up to 10 MB. Any authenticated user may read.
    // -------------------------------------------------------------------------
    match /vehicleImages/{userId}/{imageId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) && isImage() && isUnderMB(10);
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Ride route data:  rideRoutes/{userId}/{rideId}/{filename}   (Phase 9d)
    // route.bin (binary, polyline-encoded + optionally gzipped) and
    // preview.png (static map image) both live under this owner+member-gated
    // prefix — route visuals are member-only (legacy parity: routeOverview is
    // withheld from non-members; drives saved during a previous membership
    // keep their Firestore metadata readable, but route files stay gated).
    // The former world-readable ridePreviewImages/ prefix is retired: ride
    // previews reveal the private route shape.
    // Max 50 MB per file. drives.delete removes this prefix with the drive.
    // -------------------------------------------------------------------------
    match /rideRoutes/{userId}/{rideId}/{filename} {
      allow read: if isOwner(userId) && isActiveMember();
      allow write: if isOwner(userId) && isActiveMember() && isUnderMB(50) &&
        (request.resource.contentType.matches('application/(octet-stream|gzip|x-gzip)')
          || isImage());
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Company images (admin-managed):  companyImages/{companyId}/{imageId}
    // Any authenticated user may read. Only admins may write.
    // -------------------------------------------------------------------------
    match /companyImages/{companyId}/{imageId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Offer images (admin-managed):  offerImages/{companyId}/{imageId}
    // Any authenticated user may read. Only admins may write.
    // -------------------------------------------------------------------------
    match /offerImages/{companyId}/{imageId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
