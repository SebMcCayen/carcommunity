rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper functions
    // -------------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Suspension is a server-managed custom claim set by admin.suspendUser
    // (cleared by admin.restoreAccess). Suspension always overrides feature
    // access; an absent claim means not suspended (the `in` guard is required
    // because reading a missing token property is an error, not undefined).
    function isNotSuspended() {
      return !('suspended' in request.auth.token) || request.auth.token.suspended != true;
    }

    // Admin role is granted via server-managed Firebase custom claims only
    // (admin.setAdminRole callable). Clients must never set or modify this
    // claim. A suspended admin loses admin access (suspension overrides all
    // feature access, per packages/shared canAccessAdminFeatures).
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true && isNotSuspended();
    }

    // Active member: subscription entitlement verified by backend and stored
    // as a custom claim. Clients must not self-elevate this claim.
    // Suspension always overrides entitlement (canAccessMemberFeatures).
    function isActiveMember() {
      return isAuthenticated() && request.auth.token.activeMember == true && isNotSuspended();
    }

    // Returns true when the incoming write does not touch any field that
    // must only be modified by backend (Cloud Functions / Admin SDK).
    // onboardingCompletedAt is written by auth.completeOnboarding with a
    // server timestamp — clients must not self-complete onboarding.
    function noProtectedUserFieldsChanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'admin', 'activeMember', 'suspended', 'deleted', 'entitlement', 'onboardingCompletedAt']);
    }

    // Returns true when a create request does not set any protected field.
    function noProtectedUserFieldsSet() {
      return !request.resource.data.keys()
        .hasAny(['role', 'admin', 'activeMember', 'suspended', 'deleted', 'entitlement', 'onboardingCompletedAt']);
    }

    // Consent timestamps on userPrivate are backend-written audit records
    // (auth.completeOnboarding); clients must never set or modify them.
    function noConsentTimestampsChanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['ageConfirmedAt', 'termsAcceptedAt', 'privacyPolicyAcceptedAt']);
    }

    function noConsentTimestampsSet() {
      return !request.resource.data.keys()
        .hasAny(['ageConfirmedAt', 'termsAcceptedAt', 'privacyPolicyAcceptedAt']);
    }

    // -------------------------------------------------------------------------
    // Deny-all catch-all (rules below override for specific paths)
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // users – public profile
    // Document ID == Firebase UID.
    // -------------------------------------------------------------------------
    match /users/{userId} {
      // Any authenticated user may read the public profile.
      allow read: if isAuthenticated();
      // Owner may create their own profile without setting protected fields.
      allow create: if isOwner(userId) && isNotSuspended() && noProtectedUserFieldsSet();
      // Owner may update display fields but must not touch protected fields.
      // Suspended users may not edit their profile (suspension overrides
      // feature access); they retain read access to their own data.
      allow update: if isOwner(userId) && isNotSuspended() && noProtectedUserFieldsChanged();
      // Admins have unrestricted access.
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // userPrivate – sensitive data (contact details, settings, push tokens)
    // Document ID == Firebase UID.
    // Owner-only. Admin access must use the Admin SDK (backend-only); no
    // privileged client-side read is permitted for this collection.
    // Consent timestamps are backend-written compliance records — owner may
    // not set, modify, or delete them (deletion is a backend account-deletion
    // workflow, not a client write).
    // -------------------------------------------------------------------------
    match /userPrivate/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && noConsentTimestampsSet();
      allow update: if isOwner(userId) && noConsentTimestampsChanged();
      // No client deletes: account deletion is handled by backend functions.
    }

    // -------------------------------------------------------------------------
    // vehicles – user's garage
    // Each document carries a `userId` field with the owning UID.
    // -------------------------------------------------------------------------
    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isNotSuspended()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && isNotSuspended()
        && resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // rides – saved drive history
    // Each document carries a `userId` field. Route GPS data lives in Cloud
    // Storage; only the storage path is recorded here, not GPS coordinates.
    // -------------------------------------------------------------------------
    match /rides/{rideId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && isNotSuspended()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && isNotSuspended()
        && resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // friends – accepted friendship records
    // Document carries `userId` (list owner) and `friendId`.
    // -------------------------------------------------------------------------
    match /friends/{friendId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || resource.data.friendId == request.auth.uid);
      allow create: if isAuthenticated() && isNotSuspended()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // friendRequests – pending friend requests
    // Document carries `senderId` and `receiverId`.
    // -------------------------------------------------------------------------
    match /friendRequests/{requestId} {
      allow read: if isAuthenticated() &&
        (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if isAuthenticated() && isNotSuspended()
        && request.resource.data.senderId == request.auth.uid;
      // Receiver may accept or decline.
      allow update: if isAuthenticated() && isNotSuspended()
        && resource.data.receiverId == request.auth.uid;
      // Sender may cancel.
      allow delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // events – community calendar
    // -------------------------------------------------------------------------
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // companies – partner companies
    // -------------------------------------------------------------------------
    match /companies/{companyId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // offers – partner offers and promotions
    // -------------------------------------------------------------------------
    match /offers/{offerId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // announcements – community announcements
    // -------------------------------------------------------------------------
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // hazards – road hazard reports
    // -------------------------------------------------------------------------
    match /hazards/{hazardId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isNotSuspended()
        && request.resource.data.reportedBy == request.auth.uid;
      // Only admins may modify or remove hazard records.
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // communityMessages – event and community chat messages
    // -------------------------------------------------------------------------
    match /communityMessages/{messageId} {
      allow read: if isAuthenticated();
      // Only active members may post; the message must carry the poster's UID.
      allow create: if isActiveMember() && request.resource.data.userId == request.auth.uid;
      // Sender may delete their own message.
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // moderationReports – abuse and content reports
    // Any authenticated user may submit a report; only admins may read them.
    // -------------------------------------------------------------------------
    match /moderationReports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.reportedBy == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // errorReports – client error telemetry
    // -------------------------------------------------------------------------
    match /errorReports/{reportId} {
      allow create: if isAuthenticated();
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // adminAuditEvents – backend-written audit log
    // Immutable records written exclusively by the Admin SDK (admin callables).
    // No client writes — not even by admins — so audit entries can never be
    // forged, altered, or deleted from a client.
    // -------------------------------------------------------------------------
    match /adminAuditEvents/{eventId} {
      allow read: if isAdmin();
      // No client writes allowed.
    }

    // -------------------------------------------------------------------------
    // moderationActions – backend-written moderation records
    // Immutable records written exclusively by the Admin SDK
    // (admin.suspendUser / admin.restoreAccess). Admin-only read; no client
    // writes — not even by admins.
    // -------------------------------------------------------------------------
    match /moderationActions/{actionId} {
      allow read: if isAdmin();
      // No client writes allowed.
    }

    // -------------------------------------------------------------------------
    // accountDeletionRequests – user-initiated account deletion
    // Document ID == Firebase UID of the requesting user.
    // Deliberately NOT gated on suspension: suspended users retain access to
    // support and account-deletion paths (migration plan, Phase 8 definition
    // of done). The same applies to userPrivate, moderationReports, and
    // errorReports above.
    // -------------------------------------------------------------------------
    match /accountDeletionRequests/{requestId} {
      allow create: if isOwner(requestId);
      allow read: if isOwner(requestId);
      // Admins may read all requests and update status (e.g. mark as processed).
      // Account deletion itself is handled by backend Cloud Functions.
      allow read, update: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // subscriptions – subscription entitlement records
    // Written exclusively by Cloud Functions after receipt verification.
    // Clients must never write to this collection.
    // -------------------------------------------------------------------------
    match /subscriptions/{userId} {
      allow read: if isOwner(userId);
      allow read, write: if isAdmin();
      // No client writes allowed.
    }
  }
}
