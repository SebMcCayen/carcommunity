rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper functions
    // -------------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Suspension is a server-managed custom claim set by admin.suspendUser
    // (cleared by admin.restoreAccess). Suspension always overrides feature
    // access; an absent claim means not suspended (the `in` guard is required
    // because reading a missing token property is an error, not undefined).
    function isNotSuspended() {
      return !('suspended' in request.auth.token) || request.auth.token.suspended != true;
    }

    // Admin role is granted via server-managed Firebase custom claims only
    // (admin.setAdminRole callable). Clients must never set or modify this
    // claim. A suspended admin loses admin access (suspension overrides all
    // feature access, per packages/shared canAccessAdminFeatures).
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true && isNotSuspended();
    }

    // Active member: subscription entitlement verified by backend and stored
    // as a custom claim. Clients must not self-elevate this claim.
    // Suspension always overrides entitlement (canAccessMemberFeatures).
    //
    // ---- MEMBER GATING SWITCH (Firestore rules layer) ----------------------
    // Member gating is currently DISABLED so every feature is testable without
    // a subscription. The entitlement term is dropped from the return below;
    // the isAuthenticated() and isNotSuspended() terms are DELIBERATELY KEPT —
    // isActiveMember() bundles the suspension guard for every call site, and
    // dropping the helper wholesale would silently un-suspend suspended users
    // (exactly the regression Copilot caught in PR #428's storage.rules).
    //
    // TO RE-LOCK: restore the activeMember term, i.e. replace the return below
    // with:
    //   return isAuthenticated() && request.auth.token.activeMember == true
    //     && isNotSuspended();
    // then redeploy rules. This switch is INDEPENDENT of the callable-layer
    // switch in functions/src/shared/memberGating.ts, of storage.rules /
    // database.rules.json, AND of the Android UI switch in
    // apps/android/.../config/MemberGating.kt — all FIVE must be flipped
    // together (memberGating.ts is the authoritative runbook).
    function isActiveMember() {
      return isAuthenticated() && isNotSuspended();
    }

    // ---- users/{uid} owner-write validation (Phase 9a) ----------------------
    // Owner writes are whitelist-based: only the keys listed in
    // validUserProfileCreate/Update may be set or changed. All protected
    // fields (role, admin, activeMember, suspended, deleted, entitlement,
    // onboardingCompletedAt) are backend-managed via the Admin SDK and are
    // rejected by omission from the whitelist. Field shapes follow
    // contracts/schemas/user-profile.schema.json.

    function validDisplayName(data) {
      return data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120;
    }

    // avatarPath must point into the caller's own Cloud Storage prefix
    // (profileImages/{uid}/...).
    function validAvatarPath(data, uid) {
      return data.avatarPath is string
        && data.avatarPath.size() <= 500
        && data.avatarPath.matches('profileImages/' + uid + '/.+');
    }

    function validBio(data) {
      return data.bio is string && data.bio.size() <= 500;
    }

    // ---- Social handles (facebook / instagram / youtube) -------------------
    // THE SERVER-SIDE AUTHORITY. There is no callable in front of a profile
    // edit — the owner writes users/{uid} directly — so these rules, and not
    // the Android SocialLinks check, are what actually stops a hostile client.
    //
    // A HANDLE is stored, never a URL. The clients build
    // https://www.facebook.com/{h}, https://www.instagram.com/{h} and
    // https://www.youtube.com/@{h} from a constant host, so a link on a public
    // profile is STRUCTURALLY incapable of pointing at a foreign host: there is
    // no field a scheme, an authority, userinfo or a port could be written
    // into, and the patterns below admit none of those characters anyway.
    // That is why there is no host allowlist here — the allowlist lives in the
    // client-side parser, which only decides which pasted URLs it is willing to
    // read a handle OUT of. What reaches Firestore is a bare handle or nothing.
    //
    // matches() is a FULL-string match, and the classes are ASCII-only, so
    // control characters, whitespace, ':' '/' '@' '?' '#' and every non-ASCII
    // look-alike are rejected by construction. An absent key is allowed: that
    // is how a member CLEARS a platform (FieldValue.delete()), and it is the
    // only representation of "unset" — an empty string is refused by minimum
    // size, so the public profile can decide on presence alone.
    //
    // These patterns are mirrored verbatim in
    // apps/android/.../profile/SocialLinks.kt and in
    // contracts/schemas/user-profile.schema.json. Change one, change all three.

    function validFacebookHandle(data) {
      return !('facebook' in data)
        || (data.facebook is string
            && data.facebook.size() >= 1
            && data.facebook.size() <= 50
            && data.facebook.matches('^[a-z0-9][a-z0-9.-]{0,49}$'));
    }

    function validInstagramHandle(data) {
      return !('instagram' in data)
        || (data.instagram is string
            && data.instagram.size() >= 1
            && data.instagram.size() <= 30
            && data.instagram.matches('^[a-z0-9_][a-z0-9._]{0,29}$'));
    }

    // YouTube handles are DISPLAYED with their case, so unlike the other two
    // they are not folded — hence the only pattern here that admits upper case.
    function validYoutubeHandle(data) {
      return !('youtube' in data)
        || (data.youtube is string
            && data.youtube.size() >= 3
            && data.youtube.size() <= 30
            && data.youtube.matches('^[A-Za-z0-9][A-Za-z0-9._-]{2,29}$'));
    }

    // Client-written timestamps must be the server timestamp sentinel
    // (FieldValue.serverTimestamp() resolves to request.time).
    function isServerTimestamp(value) {
      return value == request.time;
    }

    function validUserProfileFields(keys, uid) {
      let data = request.resource.data;
      return (!keys.hasAny(['displayName']) || validDisplayName(data))
        && (!keys.hasAny(['avatarPath']) || validAvatarPath(data, uid))
        && (!keys.hasAny(['bio']) || validBio(data))
        && (!keys.hasAny(['facebook']) || validFacebookHandle(data))
        && (!keys.hasAny(['instagram']) || validInstagramHandle(data))
        && (!keys.hasAny(['youtube']) || validYoutubeHandle(data))
        && (!keys.hasAny(['updatedAt']) || isServerTimestamp(data.updatedAt));
    }

    // Owner update: only whitelisted keys may change; changed keys are validated.
    // There is no owner create: users/{uid} is provisioned exclusively by the
    // backend (onUserCreate trigger + auth.completeOnboarding fallback). A
    // client-created partial doc would make the idempotent trigger a
    // permanent no-op and skip backend-managed defaults.
    function validUserProfileUpdate(uid) {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      return keys.hasOnly([
          'displayName', 'avatarPath', 'bio',
          'facebook', 'instagram', 'youtube',
          'updatedAt'
        ])
        && validUserProfileFields(keys, uid);
    }

    // ---- userPrivate/{uid} owner-write validation (Phase 9a) ----------------
    // The whitelist excludes the consent timestamps (licenceConfirmedAt, the
    // legacy ageConfirmedAt, termsAcceptedAt, privacyPolicyAcceptedAt) —
    // backend-written compliance records (auth.completeOnboarding) that clients
    // can never set or modify.

    function validUserPrivateFields(keys) {
      let data = request.resource.data;
      return (!keys.hasAny(['email']) || (data.email is string && data.email.size() <= 320))
        && (!keys.hasAny(['phone']) || (data.phone is string && data.phone.size() <= 32))
        && (!keys.hasAny(['notificationPreferences']) || data.notificationPreferences is map)
        && (!keys.hasAny(['anonymousPartnerStatsOptIn']) || data.anonymousPartnerStatsOptIn is bool)
        && (!keys.hasAny(['updatedAt']) || isServerTimestamp(data.updatedAt));
    }

    // ---- events/{eventId}/rsvps/{uid} validation (Phase 9b) ------------------
    // Validates the RESULTING document (covers create and update uniformly):
    // exactly a status from the contract enum plus a server-timestamp
    // updatedAt (contracts/schemas/events.schema.json eventRsvpStatus).
    function validRsvpDocument() {
      let data = request.resource.data;
      return data.keys().hasOnly(['status', 'updatedAt'])
        && data.keys().hasAll(['status', 'updatedAt'])
        && data.status in ['going', 'maybe', 'not_going']
        && isServerTimestamp(data.updatedAt);
    }

    // No owner create (backend provisioning only — see users note above).
    function validUserPrivateUpdate() {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      return keys.hasOnly(['email', 'phone', 'notificationPreferences',
          'anonymousPartnerStatsOptIn', 'updatedAt'])
        && validUserPrivateFields(keys);
    }

    // ---- DM message read gate (membership + mutual block) --------------------
    // This is a CONFIDENTIALITY boundary, so it FAILS CLOSED: the shape of the
    // conversation document is validated before the counterparty is derived from
    // it, rather than assumed. A malformed `members` (not a list, not exactly two
    // entries, or non-string entries) denies the read outright instead of
    // producing a counterparty that might be the wrong uid — with three members,
    // for example, "whichever isn't me" is ambiguous and could resolve to someone
    // the caller has NOT blocked, silently reopening a blocked thread.
    //
    // Only conversations/{pairId} documents written by dm.sendMessage exist (no
    // client writes), and it always writes exactly two uids, so this is a guard
    // against a future shape change rather than a live hole. Denying is the safe
    // side: a genuinely broken conversation is unreadable, not leaky.
    //
    // `get()` results are cached within a request, so the membership check and
    // the counterparty derivation share ONE read: 1 get + 2 exists = 3 of the
    // 10-document-access budget a query gets.
    function dmMembers(pairId) {
      return get(/databases/$(database)/documents/conversations/$(pairId)).data.members;
    }

    function dmWellFormed(members) {
      return members is list
        && members.size() == 2
        && members[0] is string
        && members[1] is string;
    }

    // True when NEITHER party has blocked the other. Both directions are checked
    // because blocking is mutual invisibility: the blocker stops seeing the
    // blocked party's messages AND vice versa.
    function dmNotBlockedWith(other) {
      return !exists(/databases/$(database)/documents/userBlocks/$(request.auth.uid)/blocked/$(other))
        && !exists(/databases/$(database)/documents/userBlocks/$(other)/blocked/$(request.auth.uid));
    }

    // The whole gate for conversations/{pairId}/messages: a well-formed two-party
    // conversation, the caller is one of the two, and the pair is not blocked.
    function dmMessagesReadable(pairId) {
      let members = dmMembers(pairId);
      return dmWellFormed(members)
        && request.auth.uid in members
        && dmNotBlockedWith(members[0] == request.auth.uid ? members[1] : members[0]);
    }

    // -------------------------------------------------------------------------
    // Deny-all catch-all (rules below override for specific paths)
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // users – public profile
    // Document ID == Firebase UID.
    // -------------------------------------------------------------------------
    match /users/{userId} {
      // Any authenticated user may read the public profile.
      allow read: if isAuthenticated();
      // No owner create: users/{uid} is provisioned exclusively by the
      // backend (onUserCreate trigger + auth.completeOnboarding fallback).
      // Owner may update whitelisted display fields only, with field-level
      // validation (Phase 9a). Suspended users may not edit their profile
      // (suspension overrides feature access); they retain read access.
      allow update: if isOwner(userId) && isNotSuspended() && validUserProfileUpdate(userId);
      // Admins have unrestricted access.
      allow read, write: if isAdmin();

      // Badges (Phase 9f + tiered ladders) — users/{uid}/badges/{badgeKey}.
      // Awarded by the backend only (automatic tier evaluators +
      // badges.awardHelpfulMember).
      //
      // PUBLIC READ — a deliberate product decision (2026-07): an earned badge
      // is a trophy meant to be shown off, so any authenticated user may read
      // it. That is the SAME gate as the users/{uid} profile document the
      // badges hang off and the /vehicles garage rendered beside them on a
      // member profile, so the read-only member-profile screen renders as one
      // consistent page. Deliberately NOT isActiveMember(): neither the profile
      // nor the garage it accompanies is member-gated, and gating only the
      // awards would leave a half-rendered profile.
      //
      // WHAT BECOMES PUBLIC IS THE TROPHY, NOT THE TELEMETRY. Firestore has no
      // field-level read security, so EVERY field of an award document is
      // public: { badgeKey, name, description, iconIdentifier, ladder, tier,
      // source, awardedAt } — the catalog text for the badge, plus that a
      // threshold was crossed and when. The awarding admin's UID is
      // deliberately NOT written here (it lives in adminAuditEvents); see
      // buildBadgeDocument. The raw counters it was crossed against (streak
      // length, lifetime distance driven, events attended, crowns collected)
      // live on badgeProgress/{uid}, which stays denied to EVERY client,
      // including the owner (see that block below). Widening this rule
      // therefore exposes rungs reached, never the activity totals behind them.
      //
      // AND IT IS PER-MEMBER, NOT A GLOBAL INDEX. This grant does NOT make
      // badges enumerable across users via collectionGroup('badges'). Firestore
      // authorises a collection group query only from a rule written against a
      // recursive-wildcard path (match /{path=**}/badges/{badgeKey}); a rule
      // nested under a concrete ancestor like /users/{userId} is never
      // consulted for one. The only recursive-wildcard rule in this file is the
      // deny-all catch-all above, so every client collection group query over
      // `badges` is denied — viewer, activeMember and admin alike. Do not add a
      // /{path=**}/badges/… grant: badges.adminSummary
      // (functions/src/badges/adminSummary.ts) and the functions.json contract
      // both state that no client can scan across members, and the emulator
      // test "no client can scan badges across members — collectionGroup is
      // denied" will fail if that stops being true.
      match /badges/{badgeKey} {
        allow read: if isAuthenticated();
        // No client writes — for the tiered ladders too. A tier is derived
        // exclusively from server-verified counters by the badges Firestore
        // triggers (functions/src/badges/progressTriggers.ts): there is no
        // callable and no client write path by which one could be forged,
        // and a badge is never revoked here. Not even the owner may write, so
        // a publicly readable wall can never become a self-minted one.
      }

      // Saved partner offers (Phase 9i) — a pure member bookmark. Document
      // ID == the saved offerId; the doc carries only { offerId, savedAt }.
      match /savedOffers/{offerId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isActiveMember()
          && request.resource.data.keys().hasOnly(['offerId', 'savedAt'])
          && request.resource.data.offerId == offerId
          && isServerTimestamp(request.resource.data.savedAt);
        allow delete: if isOwner(userId) && isActiveMember();
      }
    }

    // -------------------------------------------------------------------------
    // userPrivate – sensitive data (contact details, settings, push tokens)
    // Document ID == Firebase UID.
    // Owner-only. Admin access must use the Admin SDK (backend-only); no
    // privileged client-side read is permitted for this collection.
    // Consent timestamps are backend-written compliance records — owner may
    // not set, modify, or delete them (deletion is a backend account-deletion
    // workflow, not a client write).
    // -------------------------------------------------------------------------
    match /userPrivate/{userId} {
      allow read: if isOwner(userId);
      // No owner create: provisioned by backend alongside users/{uid}.
      // Owner updates are whitelist-based with field-level validation
      // (Phase 9a); consent timestamps are excluded from the whitelist.
      allow update: if isOwner(userId) && validUserPrivateUpdate();
      // No client deletes: account deletion is handled by backend functions.

      // Push token registrations. The document ID is the SHA-256 hash of the
      // FCM token and the document now also holds the RAW token, because FCM
      // addresses a device by the token itself — a hash-only registry can
      // never send (functions/src/notifications/notifications-core.ts).
      //
      // Consequently this collection is CLOSED TO CLIENTS ENTIRELY, reads
      // included. Owner-read was safe when the row was just a hash plus app
      // metadata; it is not worth keeping now that a read returns raw,
      // send-addressable tokens for every device the member owns. Nothing
      // needs it: the client learns its own token from the FCM SDK, and both
      // writes already go through the notifications.registerPushToken /
      // unregisterPushToken callables. Only the Admin SDK (which bypasses
      // these rules) touches this data.
      match /pushTokens/{tokenId} {
        allow read, write: if false;
      }
    }

    // -------------------------------------------------------------------------
    // userLifecycle – backend-only account-activity + inactivity state
    // Document ID == Firebase UID.
    // Holds lastLoginAt (auth.recordLogin) plus the inactivity-sweep fields
    // inactivityWarnedAt / inactivityDeleteAfter (account-cleanupInactive).
    // These are activity/lifecycle signals that MUST NOT leak on the public
    // users/{uid} profile (readable by any authenticated user), so they live
    // here instead. Owner + admin may read (the user sees their own last
    // login; the admin UI can display it); ALL client writes are denied —
    // every write is a trusted Admin SDK write, which bypasses these rules.
    // -------------------------------------------------------------------------
    match /userLifecycle/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // notifications/{uid}/items – durable in-app notification inbox
    // (Phase 9l). Owner-only read; deliberately NOT gated on suspension so
    // suspended users can still see the essential account notices that are
    // delivered to them (the backend writer enforces that suspended users
    // receive ONLY those categories). Backend-only writes: delivery goes
    // through writeInAppNotification, read-state through
    // notifications.markRead / markAllRead, and member-initiated removal
    // (the Android inbox's swipe-to-delete and "delete all") through
    // notifications.delete / notifications.deleteAll — keeping the backend
    // the sole authority for notification content and eligibility.
    // Removal is a callable rather than a client delete permission on
    // purpose: the callables address only notifications/{caller}/items,
    // derived from the authenticated uid, so ownership is structural. A
    // delete rule here would have to re-state that ownership in rules AND
    // open the collection to client writes, for no gain.
    // -------------------------------------------------------------------------
    match /notifications/{userId}/items/{notificationId} {
      allow read: if isOwner(userId);
      // No client writes — deletes go through the callables above.
    }

    // -------------------------------------------------------------------------
    // config – backend-controlled configuration (Phase 9m)
    // config/featureFlags is ONE flat document of camelCase boolean fields
    // (contracts/features/feature-flags.json is the canonical key list and
    // defaults). Any authenticated user may read it — clients fetch flag
    // state on launch/resume and fall back to contract defaults when the
    // document or a field is absent. All writes go through the audited
    // admin.setFeatureFlag callable (closed key namespace).
    // Every OTHER document under config/ (e.g. config/partnerInsights, the
    // privacy threshold) is deliberately NOT matched here and stays
    // backend-only.
    // -------------------------------------------------------------------------
    match /config/featureFlags {
      allow read: if isAuthenticated();
      // No client writes: admin.setFeatureFlag only.
    }

    // -------------------------------------------------------------------------
    // events – community calendar (Phase 9b)
    // Split-document model: events/{eventId} holds teaser-safe + operational
    // fields (title, approximateArea, status, rsvpCounts, ...) PLUS the event's
    // map location (locationName, latitude, longitude); the long description and
    // the precise street address are member-only and live in
    // events/{eventId}/details/private. All mutations go through the
    // events.* callables (Admin SDK) — no client writes, including admins, so
    // every admin lifecycle change carries an adminAuditEvents record.
    //
    // DELIBERATE PRIVACY CHANGE (2026-07): the coordinate pair + place name are
    // PUBLIC teaser data now, so every signed-in user sees event pins on the
    // community map. The teaser read gate below already served the whole teaser
    // document to any authenticated user while published/completed, so opening
    // location up needs no rule change here — the fields simply moved onto the
    // document that gate already covers. Only description + address remain
    // behind the details/private member gate.
    //
    // events.create is the one callable an active MEMBER may drive (their
    // event is stamped createdByRole: 'member' + createdByUserId and published
    // straight away; admins moderate it afterwards via events.cancel — see
    // functions/src/events/events-core.ts). That does NOT loosen anything
    // here: members still cannot write events/{eventId} directly, so the
    // server-side validation, the isOfficial lock and the per-member rate
    // limit can never be bypassed by talking to Firestore.
    // -------------------------------------------------------------------------
    match /events/{eventId} {
      // Published AND completed events are visible to non-admin users
      // (contracts/schemas/events.schema.json eventStatus). Member-created
      // events are published, so they are readable on exactly the same terms
      // as organiser-created ones — no read-rule change needed.
      //
      // `completed` is readable because the events-autoClose sweep
      // (functions/src/events/scheduled.ts) now makes that status the normal
      // end state of EVERY event a few hours after it finishes, rather than a
      // rare admin action. Keeping it admin-only would make each event vanish
      // from members the morning after — including for the attendees who
      // RSVP'd — and would break any teaser read that outlives the event (a
      // detail screen opened from a push notification, an archive/past list).
      // This exposes nothing new about who-can-read: the same teaser document
      // was already readable by the same users while published. It now also
      // carries the map location (locationName + coordinates), which is a
      // DELIBERATE product decision (see the block header) — event pins are
      // public to every signed-in user. The long description and the precise
      // street address stay in details/private, which stays published-gated
      // below (an ended event closes its detail, roster and chat).
      // `draft` and `cancelled` remain admin-only.
      allow read: if (isAuthenticated()
          && resource.data.status in ['published', 'completed'])
        || isAdmin();
      // No client writes: events.create/update/publish/cancel/complete only.

      // Member-gated detail document (long description + precise street
      // address). The map location moved to the public teaser above; this
      // document no longer holds coordinates. The match is pinned to the
      // single `private` document so nothing else ever added under details/
      // inherits member read access.
      match /details/private {
        allow read: if isAdmin()
          || (isActiveMember()
            && get(/databases/$(database)/documents/events/$(eventId)).data.status == 'published');
        // No client writes: managed by the events.* callables.
      }

      // RSVPs — active members write their own answer directly; the
      // events-onRsvpWrite trigger maintains events/{eventId}.rsvpCounts.
      // Document ID == responding user's UID. Legacy has no RSVP deletion;
      // members change their answer instead (going/maybe/not_going).
      // Group drive roster (Phase 11). Member-readable for published
      // events (owner may always read their own record); ALL writes via
      // the groupDrive.* callables so join preconditions (published +
      // RSVP going|maybe + not ended) are enforced server-side.
      match /groupDriveParticipants/{userId} {
        allow read: if isAdmin() || isOwner(userId)
          || (isActiveMember()
            && get(/databases/$(database)/documents/events/$(eventId)).data.status == 'published');
        // No client writes: groupDrive.join / updateStatus / leave only.
      }

      match /rsvps/{userId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && isActiveMember()
          && get(/databases/$(database)/documents/events/$(eventId)).data.status == 'published'
          && validRsvpDocument();
        // No client deletes.
      }

      // Chat messages (Phase 9c) — read requires chat eligibility: active
      // member + published event + a going/maybe RSVP (legacy
      // canReadEventChat). Removed messages stay readable but their body is
      // blanked by events.removeChatMessage, so no removed text can leak.
      //
      // MODERATION FIELDS ARE FUNCTION-WRITE-ONLY: the whole document (message,
      // moderationState, hiddenAt, reportCount, allowedAt/By, removedAt/By) is
      // written ONLY by the events.* callables + the events-onMessageReportCreate
      // auto-hide trigger via the Admin SDK — this block has NO `allow write`, so
      // every client write (including forging/clearing a moderation flag) is
      // denied by default. Clients CAN read moderationState to render the
      // 'Show reported message' (auto_hidden) / moderator-removed (removed)
      // placeholders; the auto-hide/allow/remove decisions never touch the client.
      match /messages/{messageId} {
        allow read: if isAdmin()
          || (isActiveMember()
            && get(/databases/$(database)/documents/events/$(eventId)).data.status == 'published'
            && get(/databases/$(database)/documents/events/$(eventId)/rsvps/$(request.auth.uid))
              .data.status in ['going', 'maybe']);
      }

      // Message reports — moderation queue, backend/admin-only. Written via
      // events.reportChatMessage (reporter identities stay private); no
      // client reads or writes at all (admin app uses callables/Admin SDK).
      match /messageReports/{reportId} {
        allow read, write: if false;
      }
    }

    // -------------------------------------------------------------------------
    // vehicles – user's garage
    // Each document carries a `userId` field with the owning UID.
    // -------------------------------------------------------------------------
    // All writes go through the garage.* callables (Phase 9e): per-user vehicle
    // cap, strict no-VIN schema validation, registrationPlate normalisation,
    // and storage cleanup on delete
    // cannot be enforced on direct client writes, so writes stay callable-only
    // even though managing your own garage is no longer member-gated (the ungate
    // lives in the callable's requireActiveActor check, NOT here — opening direct
    // owner writes would bypass the cap and validation). The document stays
    // authenticated-readable by design. `registrationPlate` is stored here
    // ON PURPOSE — a DELIBERATELY PUBLIC, user-entered field (Seb product
    // decision). Note the read below is `isAuthenticated()`, i.e. ANY signed-in
    // user: it is NOT limited to members and is NOT withdrawn from suspended
    // accounts, so the plate is wider than "shown to other members". Narrowing
    // it later means changing this read rule, not just the UI. VIN / insurance /
    // location remain out (docs/firebase-data-model.md). These rules do not
    // field-validate the vehicle doc (all writes are callable-only), so adding
    // the plate needs no rule change here.
    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated();
      // No client writes: garage.addVehicle/updateVehicle/deleteVehicle only.
    }

    // -------------------------------------------------------------------------
    // rides – saved drive history (Phase 9d)
    // Each document carries a `userId` field. Route GPS data lives in Cloud
    // Storage (rideRoutes/{uid}/{rideId}/, member-gated); only the storage
    // path is recorded here, never GPS coordinates. All writes go through
    // callables: drives.save computes the stats server-side (a client write
    // could forge distance/duration) and drives.delete removes the storage
    // files with the document. Owner list/read works without membership —
    // drives saved during a previous membership stay accessible.
    // -------------------------------------------------------------------------
    match /rides/{rideId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // No client writes: drives.save / drives.delete callables only.
      allow read: if isAdmin();
    }

    // friendRequests – the ONLY match block for this collection is the
    // callable-only friend-graph model below (fromUid/toUid). An earlier
    // senderId/receiverId scaffold that granted direct client create/update/
    // delete was removed: Firestore rules are ADDITIVE, so leaving it in place
    // gave clients a path to forge/modify friendRequests (setting senderId to
    // themselves) and bypass the friend.* callables — breaking the
    // callable-only-write invariant of the new model. No production code (app,
    // admin web, or functions) ever used the senderId/receiverId shape.

    // -------------------------------------------------------------------------
    // userBlocks – directional user blocking (blocking.block / blocking.unblock)
    // userBlocks/{blockerUid}/blocked/{blockedUid}: the owner reads their own
    // blocked list (never who has blocked them — that would leak private
    // blocking decisions). All writes go through the blocking.* callables so
    // the denormalized displayName, idempotency, and self-block/not-found rules
    // stay backend-enforced. Admin does NOT read blocks (no surveillance).
    // -------------------------------------------------------------------------
    match /userBlocks/{blockerId}/blocked/{blockedId} {
      allow read: if isOwner(blockerId);
      // No client writes: blocking.block / blocking.unblock callables only.
    }

    // -------------------------------------------------------------------------
    // blockVisibility – the SYMMETRIC mirror of the block graph
    // (functions/src/blocking/block-visibility.ts), maintained solely by the
    // blocking-onBlockWrite trigger.
    //
    // blockVisibility/{uid}.hiddenUids is the UNION of "uids this user blocked"
    // and "uids that blocked this user". It exists because the chat surfaces
    // need the second half and userBlocks cannot give it to them: that half
    // lives in the OTHER party's owner-read-only subcollection, so the client
    // cannot read it at all and the server can only reach it with one point read
    // per candidate. One document read (or one snapshot listener) replaces that.
    //
    // Owner-only read, no client writes. The document carries uids and nothing
    // else — no displayName, no direction, no timestamp — so it never says who
    // blocked whom, only that the pair is mutually hidden. That is still a
    // deliberate, documented weakening of "a block never reveals itself to its
    // target": the product requires the blocked party to stop seeing the
    // blocker, which is observable from the missing messages regardless.
    // -------------------------------------------------------------------------
    match /blockVisibility/{userId} {
      allow read: if isOwner(userId);
      // No client writes: the blocking-onBlockWrite trigger only.
    }

    // -------------------------------------------------------------------------
    // Friends – friend graph (friend.sendRequest / respondRequest / remove /
    // list). Messaging/DMs are a SEPARATE follow-up, not modelled here.
    //
    // users/{uid}/friends/{friendUid}: an established friendship, written for
    // BOTH sides on accept. The owner reads their own friends list; a
    // friendship never leaks who else a user is friends with. All writes go
    // through the friend.* callables so the denormalized displayName/avatarPath
    // and the two-sided invariant stay backend-controlled.
    //
    // friendRequests/{requestId}: a directional request whose id is a
    // deterministic hash of the (fromUid, toUid) pair (friendRequestId in
    // friends-core.ts), matched below as {requestId}. Readable by the sender
    // (fromUid) and the recipient (toUid) only — a request never leaks to third
    // parties. All writes go through the friend.* callables (nickname
    // resolution, block checks, auto-accept, status transitions).
    // -------------------------------------------------------------------------
    match /users/{userId}/friends/{friendId} {
      allow read: if isOwner(userId);
      // No client writes: friend.respondRequest / friend.remove callables only.
    }

    match /friendRequests/{requestId} {
      allow read: if isAuthenticated()
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
      // No client writes: friend.sendRequest / friend.respondRequest callables
      // only.
    }

    // -------------------------------------------------------------------------
    // conversations – 1:1 direct messages between FRIENDS (dm.sendMessage /
    // dm.listConversations / dm.getMessages / dm.markRead).
    //
    // conversations/{pairId} (pairId = the two participant UIDs sorted +
    // joined by `__`) carries members:[uidLow,uidHigh], denormalized
    // memberProfiles, a lastMessage preview, per-member unread + lastReadAt
    // maps. A member of the pair reads their own conversation; it never leaks
    // to a third party. All writes go through the dm.* callables (friendship +
    // block checks, unread accounting, the userPrivate/{uid}.dmUnreadTotal
    // aggregate) — no client writes. Messages inherit the same member gate via
    // a parent lookup.
    // -------------------------------------------------------------------------
    match /conversations/{pairId} {
      // NOTE: no block check here, deliberately. The inbox is a LIST query
      // (members array-contains uid), and Firestore rules are not filters — a
      // condition that varies per document fails the ENTIRE query rather than
      // dropping the offending row, so a block gate here would break the inbox
      // of anyone who has one blocked thread. The blocked row is instead
      // dropped by dm.listConversations (server) and by the client's inbox
      // listener, and the trigger blanks the document's `lastMessage` preview
      // (functions/src/dm/blockedConversation.ts) so the copy that is still
      // delivered carries no counterparty content.
      allow read: if isAuthenticated() && request.auth.uid in resource.data.members;
      // No client writes: dm.* callables only.

      match /messages/{messageId} {
        // Blocking IS rules-enforced here, and this is the one chat surface
        // where it can be: every message in a conversation belongs to the SAME
        // pair, so the block condition is CONSTANT across the query and the
        // rules-are-not-filters problem above does not arise — the whole listen
        // is denied, which is exactly the intent. The Android thread listener
        // already renders PERMISSION_DENIED as an empty thread.
        //
        // Both directions: the caller having blocked the counterparty, or the
        // counterparty having blocked the caller, each hides the thread.
        // dmMessagesReadable also carries the membership check and fails closed
        // on a malformed conversation — see its definition above.
        allow read: if isAuthenticated() && dmMessagesReadable(pairId);
        // No client writes: dm.sendMessage callable only.
      }
    }

    // -------------------------------------------------------------------------
    // convoys – friend convoys (convoy.create / convoy.respond / convoy.start /
    // convoy.end / convoy.list). The FOUNDATION for the convoy + 3-channel-chat
    // epic; chat channels are a SEPARATE follow-up, not modelled here.
    //
    // convoys/{convoyId} carries ownerUid (the CURRENT LEADER — mutable: it
    // TRANSFERS when a leader leaves), createdByUid (immutable, and what the
    // Konvojledare badge credits), leadershipTransfers (the record of those
    // hand-overs), status (forming|active|ended), a memberUids:[owner,
    // ...invitees] array, a members map keyed by uid ({role, inviteStatus,
    // invitedAt, joinedAt}), denormalized memberProfiles, and a summary computed
    // on end. Any member of the convoy (owner or invitee, via memberUids) reads
    // it — so an invitee sees the roster + each member's inviteStatus (the green
    // dot) and, once ended, the summary. It never leaks to a third party. ALL
    // writes go through the convoy.* callables (friend + block checks at invite
    // time, invite responses, lifecycle transitions, summary computation) — no
    // client writes, so membership and status can never be forged. Live positions
    // are NOT stored here: accepted members share GPS through the live-location
    // domain (RTDB liveLocation/{uid}/latest).
    //
    // THE TWO EXITS (leave / end-for-everyone) are enforced ENTIRELY in the
    // callables, and the reason this block needs no per-field condition for them
    // is that there is no client write at all — strictly stronger than any
    // field-level rule could be:
    //  - only a member may leave THEMSELVES: convoy.leave removes request.auth.uid
    //    and accepts no target uid, so there is no shape of the request in which
    //    one member removes another;
    //  - only the LEADER (ownerUid) may end the convoy for everyone: convoy.end is
    //    leader-gated (a member who is not the leader gets permission-denied and
    //    has Leave instead). There is no admin override on convoys today;
    //  - a client cannot write memberUids, members, ownerUid, createdByUid or
    //    status directly — no `allow write` rule exists here, so every such
    //    attempt is denied whoever makes it (pinned by the convoy emulator tests).
    // -------------------------------------------------------------------------
    match /convoys/{convoyId} {
      // Active members only (isActiveMember carries the suspension override) AND
      // in the convoy's memberUids — a suspended / no-longer-entitled member
      // loses read access even while still listed in memberUids. A member who has
      // LEFT is removed from memberUids by convoy.leave, so this one condition is
      // also what revokes their convoy read AND (via the convoyChats rule below)
      // their chat access the instant they leave — while the chat history itself
      // is left untouched for the members still in it.
      allow read: if isActiveMember()
        && resource.data.memberUids is list
        && request.auth.uid in resource.data.memberUids;
      // No client writes: the convoy.* callables only (create / respond / start /
      // end / leave / invite / setDestination / clearDestination).
    }

    // -------------------------------------------------------------------------
    // communityChat – the single APP-WIDE chat channel (communityChat.post /
    // communityChat.list / communityChat.markRead). One of the THREE product
    // chats (community / convoy / friends-DMs; friends chat is the conversations
    // block above).
    //
    // A fixed channel doc communityChat/{channelId} ('global') with a `messages`
    // subcollection: communityChat/global/messages/{id} {senderUid, text,
    // createdAt, senderDisplayName, senderAvatarPath, mentionedUids}. Any ACTIVE
    // MEMBER reads the channel (it is the app's town square); ALL writes go
    // through the communityChat.* callables — no client writes, so authorship,
    // the denormalized sender profile, and mentionedUids can't be forged. That
    // last one matters: mentionedUids is what the @mention notification producer
    // acted on (server-validated — deliverable members only, blocked pairs
    // removed), so a client able to write it could notify anyone at will.
    // The per-user unread marker is NOT here: it lives at
    // userPrivate/{uid}.communityChatLastReadAt (owner-only, userPrivate block).
    // -------------------------------------------------------------------------
    match /communityChat/{channelId} {
      // The channel doc itself carries no member-visible payload; the roster is
      // the whole membership. Reads happen at the messages level below.
      allow read: if isActiveMember();
      // No client writes: communityChat.post callable only.

      match /messages/{messageId} {
        allow read: if isActiveMember();
        // No client writes: communityChat.post callable only.
      }
    }

    // -------------------------------------------------------------------------
    // convoyChats – the per-CONVOY chat channel (convoyChat.post /
    // convoyChat.list / convoyChat.markRead). One of the THREE product chats.
    // convoyChats/{convoyId}/messages/{id} carries the same denormalized message
    // shape as community.
    //
    // Readable ONLY by an ACCEPTED member of the parent convoy: a get() of
    // convoys/{convoyId} must show the caller in memberUids AND
    // members[uid].inviteStatus == 'accepted' (the owner is seeded accepted). A
    // still-invited / declined member or a third party cannot read the channel,
    // so it never leaks. ALL writes go through the convoyChat.post callable
    // (which re-checks accepted membership) — no client writes.
    //
    // The per-user unread markers are NOT here either: like community's single
    // marker they live in the userPrivate block, as the map
    // userPrivate/{uid}.convoyChatLastReadAt (keyed by convoy id, owner-only
    // readable, written only by convoyChat.markRead — the field is outside the
    // owner-update whitelist, so a client cannot forge or clear one).
    // -------------------------------------------------------------------------
    match /convoyChats/{convoyId}/messages/{messageId} {
      allow read: if isAuthenticated()
        && request.auth.uid in
          get(/databases/$(database)/documents/convoys/$(convoyId)).data.memberUids
        && get(/databases/$(database)/documents/convoys/$(convoyId))
          .data.members[request.auth.uid].inviteStatus == 'accepted';
      // No client writes: convoyChat.post callable only.
    }

    // (events rules live in the Phase 9b block above — teaser/detail split.)

    // -------------------------------------------------------------------------
    // companies – partner companies (Phase 9i)
    // Public while ACTIVE (list, detail, map markers); draft/paused/ended
    // are admin territory via the Admin SDK. All writes go through the
    // audited partners.* admin callables.
    // -------------------------------------------------------------------------
    match /companies/{companyId} {
      // Public while ACTIVE; admins additionally read draft/paused/ended for
      // the admin portal (Phase 13f). All writes via the audited partners.*
      // admin callables.
      allow read: if (isAuthenticated() && resource.data.status == 'active') || isAdmin();
      // No client writes.
    }

    // -------------------------------------------------------------------------
    // offers – partner offers, THREE-TIER privacy (Phase 9i)
    // Teaser document: all authenticated users while ACTIVE (title,
    // teaserText, type — never the description, terms, or code).
    // details/member: active members while the offer is active.
    // secret/code: fully backend-only — the discount code is served
    // exclusively by partners.showOfferCode and never readable directly.
    // -------------------------------------------------------------------------
    match /offers/{offerId} {
      // Teaser: authenticated while ACTIVE; admins additionally read
      // draft/paused/ended/expired for the admin portal (Phase 13f).
      allow read: if (isAuthenticated() && resource.data.status == 'active') || isAdmin();
      // No client writes.

      match /details/member {
        // Active members while the offer is active; admins read it for the
        // admin offer-detail view (Phase 13f) — this holds description/terms/
        // discount fields, but NEVER the discount code (secret/code below
        // stays fully backend-only).
        allow read: if isAdmin()
          || (isActiveMember()
            && get(/databases/$(database)/documents/offers/$(offerId)).data.status == 'active');
        // No client writes.
      }

      match /secret/{secretId} {
        allow read, write: if false;
      }
    }

    // -------------------------------------------------------------------------
    // billboards – sponsored map billboards (Phase 9k)
    // Authenticated read while ACTIVE (map markers + detail); all writes go
    // through the audited billboards.* admin callables — activation is a
    // six-point safety gate and requires an active sponsoring partner.
    // -------------------------------------------------------------------------
    match /billboards/{billboardId} {
      // Authenticated users see billboards that are BOTH active and inside
      // their availability window (map markers + detail); admins additionally
      // see drafts/paused/ended for the admin portal (Phase 13d). All writes
      // still go through the audited billboards.* callables.
      //
      // THIS is where "if it isn't activated it shouldn't be shown" is
      // enforced. The client also filters, but only as a latency cover for the
      // seconds between a window closing and the sweep noticing — a member who
      // ignores the client entirely and reads Firestore directly still cannot
      // fetch a draft, a paused, an expired or a not-yet-started billboard.
      //
      // Why the window is not compared here against request.time: a `list` is
      // evaluated SYMBOLICALLY, against the QUERY's constraints rather than
      // against each returned document, so any field this rule reads that the
      // query does not also filter on is undefined and fails the whole query.
      // A rule comparing availableFrom/availableUntil against request.time
      // would therefore not hide expired billboards — it would make the layer
      // unreadable for everyone. The window is instead resolved server-side
      // into `mapVisible` (billboards/scheduled.ts + the lifecycle callables).
      //
      // CONSEQUENCE, and the thing to preserve when editing this rule: the
      // member query MUST constrain every field named here. It issues
      // `where status == 'active' and mapVisible == true` (see
      // FirebaseBillboardsRepository) against the matching composite index.
      // Adding a condition here without adding the matching `where` there does
      // not tighten anything — it takes the layer down.
      //
      // Both conditions are required, so the two fields must AGREE. That fails
      // CLOSED, and because the query carries the same pair, it does so WITHOUT
      // a "one bad document blanks the layer" failure mode: a document somehow
      // holding mapVisible=true while paused would never enter the result set.
      // The sweep's repair pass fixes such a document within one interval.
      allow read:
        if (isAuthenticated() &&
            resource.data.status == 'active' &&
            resource.data.mapVisible == true)
           || isAdmin();
      // No client writes — `mapVisible` in particular is Admin-SDK-only, so a
      // client cannot flag itself a billboard to look at.
    }

    // -------------------------------------------------------------------------
    // partnerInsightsEvents / partnerInsights – privacy-critical (Phase 9j)
    // Raw events hold partner-scoped user hashes and expire after 7 days;
    // aggregates enforce the minimum-contributor threshold. NEITHER is ever
    // client-readable — clients only write through the
    // partnerInsights.recordInteraction callable, and partner-facing views
    // arrive via the admin app (Admin SDK) in a later phase.
    // -------------------------------------------------------------------------
    match /partnerInsightsEvents/{eventId} {
      allow read, write: if false;
    }

    match /partnerInsights/{aggregateId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // metrics – community growth snapshots (admin-only, server-written)
    // One bounded document per day (`metrics/{YYYY-MM-DD}`) of PII-free
    // aggregate totals, written ONLY by the scheduled metrics-captureDaily job
    // (Admin SDK, which bypasses these rules). The admin web app reads the
    // series to chart growth. No client ever writes; only an admin may read.
    // -------------------------------------------------------------------------
    match /metrics/{date} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // partnerApplications – contact data, never client-readable (Phase 9i)
    // Written via partners.submitApplication; reviewed via
    // partners.reviewApplication (admin). No client access at all.
    // -------------------------------------------------------------------------
    match /partnerApplications/{applicationId} {
      // Contact data — admins read it for the application review queue
      // (Phase 13f); written via partners.submitApplication and reviewed via
      // partners.reviewApplication. No non-admin client access.
      allow read: if isAdmin();
      // No client writes.
    }

    // -------------------------------------------------------------------------
    // announcements – community announcements
    // -------------------------------------------------------------------------
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // managedCredentials – admin token / credential renewal tracker
    // Internal operational records of tracked secrets/tokens (their expiry and
    // rotation dates — never the secret values themselves). Admin-only on BOTH
    // read and write: members must never see this collection. Written directly
    // from the admin portal (features/credentials); no field-validating
    // callable exists, so the client module is the write-side shape gatekeeper.
    // -------------------------------------------------------------------------
    match /managedCredentials/{credentialId} {
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // hazards – road hazard reports
    // -------------------------------------------------------------------------
    match /hazards/{hazardId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isNotSuspended()
        && request.resource.data.reportedBy == request.auth.uid;
      // Only admins may modify or remove hazard records.
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // incidents – crowd-sourced incidents / roadwork map layer (navigation)
    // Any signed-in user reads ACTIVE, unexpired incidents (the shared Waze-
    // style map layer must be visible to ALL users, not only members). The
    // read is double-gated: status == 'active' AND expiresAt still in the
    // future, so an expired doc is hidden immediately even before the sweep
    // deletes it. ALL writes go through the member-gated incidents.* callables
    // (report / remove) and the Trafikverket importer via the Admin SDK — no
    // client writes, so a member cannot forge another user's report, backdate
    // expiry, or spoof the Trafikverket source.
    // -------------------------------------------------------------------------
    match /incidents/{incidentId} {
      allow read: if isAuthenticated()
        && resource.data.status == 'active'
        && resource.data.expiresAt > request.time;
      // No client writes — incidents.report / incidents.remove /
      // incidents.confirm / incidents.reportCleared (callables).
      //
      // The `confirmations/{uid}` and `clearVotes/{uid}` sub-collections (the
      // one-per-user confirm and "it's gone" ledgers, written by
      // incidents.confirm and incidents.reportCleared) are deliberately NOT
      // matched here: this block does not recurse into sub-collections, so the
      // deny-all catch-all governs them and they stay callable-only —
      // unreadable and unwritable by clients. That is intended: a member must
      // not be able to forge a vote, enumerate who voted what, extend an
      // incident's life by writing the confirmation ledger, or take a live
      // hazard off everyone's map by writing the clear ledger. `clearVotes`
      // additionally stores the voter's POSITION as proof of presence, which is
      // exactly the kind of thing no other member may read. The vote state a
      // client needs comes back from the callables themselves and from
      // listNearby (confirmationCount / clearedCount / reportedCleared on each
      // incident).
    }

    // -------------------------------------------------------------------------
    // incidentListRateLimits – per-user fixed-window counter for
    // incidents.listNearby (runaway / abuse guard). Deterministic doc id
    // `{uid}_{epochMinute}`; incidents.listNearby reads it by id and bumps it
    // with FieldValue.increment via the Admin SDK before doing the geoCell
    // reads. Fully backend-only: never client-readable or client-writable, so a
    // member cannot inspect or reset their own throttle. `expireAt` carries a
    // Firestore TTL policy so spent windows self-delete. (The deny-all default
    // would already cover it; the intent is stated explicitly, mirroring
    // liveSessions / crownHuntAwardGuards.)
    // -------------------------------------------------------------------------
    match /incidentListRateLimits/{windowId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // incidentClearRateLimits – per-user fixed-window counter for
    // incidents.reportCleared ("it's gone" votes). Same mechanism, same
    // backend-only posture and same `expireAt` TTL as incidentListRateLimits
    // above, in a SEPARATE collection so a burst of map refreshes can never
    // consume a member's ability to report a hazard cleared. Never
    // client-readable or client-writable: a member must not be able to inspect
    // or reset their own vote throttle.
    // -------------------------------------------------------------------------
    match /incidentClearRateLimits/{windowId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // incidentClearVoteRisk – backend-only anti-fraud scores for REJECTED
    // incidents.reportCleared votes. Mirrors eventAttendanceRisk /
    // crownHuntClaimRisk: risk scores and reason categories are for admins, and
    // returning them to a client would tell an abuser precisely which signal
    // tripped and what to change next time.
    // -------------------------------------------------------------------------
    match /incidentClearVoteRisk/{voteId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // memberSearchRateLimits – per-user fixed-window counter for
    // userSearch.members (the member typeahead). Same shape and same reasoning
    // as incidentListRateLimits above: deterministic doc id
    // `{uid}_{epochMinute}`, read by id and bumped with FieldValue.increment via
    // the Admin SDK before the displayNameLower range scan, `expireAt` carrying
    // a Firestore TTL policy so spent windows self-delete. Fully backend-only —
    // a member must not be able to inspect or reset their own throttle, which is
    // the entire point of putting the search behind a callable.
    // -------------------------------------------------------------------------
    match /memberSearchRateLimits/{windowId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // liveSessions – nearby live-sharer DISCOVERY index (live location)
    // A lightweight, geo-cell-indexed Firestore doc per ACTIVE standalone
    // sharer (liveSessions/{uid}), written ONLY by the live.* callables via the
    // Admin SDK (live.updatePosition writes/refreshes it; startSession /
    // stopSession / hideMeNow / the TTL sweep delete it). The high-frequency
    // position STREAM stays in RTDB (liveLocation/{uid}/latest); this doc is
    // only the queryable index.
    //
    // NO client access at all. Discovery is served by live.listNearby (a
    // callable — the Admin SDK bypasses these rules), which applies the
    // self / blocked / expired exclusions server-side; a raw client listener
    // would leak every nearby sharer's coordinate with none of those checks and
    // is not needed, since the viewer streams live updates through the existing
    // per-uid RTDB liveLocation/{uid}/latest read (which DOES enforce blocking +
    // suspension). Reads and writes are both denied here (defence in depth; the
    // deny-all catch-all would cover it, but the intent is stated explicitly).
    // -------------------------------------------------------------------------
    match /liveSessions/{sharerUid} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // crownHuntPoints – Kronjakt reward points (Phase 9h)
    // Members read ACTIVE points (map display); drafts/paused/ended are
    // admin-territory via the Admin SDK. All writes go through the
    // safety-gated crownHunt.* admin callables — activation requires an
    // explicit safe-location confirmation and an audited approval note.
    // -------------------------------------------------------------------------
    match /crownHuntPoints/{pointId} {
      // Members read ACTIVE points (map display); admins additionally read
      // drafts/paused/ended for the admin portal (Phase 13e). All writes go
      // through the safety-gated crownHunt.* admin callables.
      allow read: if (isActiveMember() && resource.data.status == 'active') || isAdmin();
      // No client writes.
    }

    // -------------------------------------------------------------------------
    // crownHuntClaims – every claim attempt (Phase 9h)
    // Document ID = SHA-256-scoped idempotency key. Owner-only read (claim
    // history); all writes go through crownHunt.submitClaim. Risk data is
    // NOT here — see crownHuntClaimRisk below.
    // -------------------------------------------------------------------------
    match /crownHuntClaims/{claimId} {
      // Owner reads their own claim history; admins read every claim for the
      // review queue (Phase 13e). Anti-fraud risk data stays backend-only in
      // crownHuntClaimRisk (below) — this grant does not expose it.
      allow read: if (isActiveMember() && resource.data.userId == request.auth.uid) || isAdmin();
      // No client writes.
    }

    // -------------------------------------------------------------------------
    // crownHuntClaimRisk – anti-fraud scores and reasons (Phase 9h)
    // Fully backend-only: risk thresholds and reasons must never reach
    // mobile clients (legacy rule), so they live apart from the
    // owner-readable claim records.
    // -------------------------------------------------------------------------
    match /crownHuntClaimRisk/{claimId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // crownHuntAwardGuards / crownHuntDailyClaims – award-race guards (9h)
    // Fully backend-only. Deterministic documents (IDs independent of the
    // client idempotency key) that crownHunt.submitClaim reads and writes
    // INSIDE the award transaction to enforce the repeat rule and daily cap
    // under concurrency. Never client-readable or client-writable.
    // -------------------------------------------------------------------------
    match /crownHuntAwardGuards/{guardId} {
      allow read, write: if false;
    }

    match /crownHuntDailyClaims/{counterId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // crownSpawns – AUTO-SPAWNED Kronjakt crowns (spawn engine)
    // Machine-placed, short-lived crowns written ONLY by the scheduled
    // crownHunt-spawnCrowns, and mutated only by crownHunt.claimSpawn and the
    // crownHunt-sweepSpawns TTL sweep — all via the Admin SDK.
    //
    // Members READ live, unexpired crowns directly (the map layer queries
    // `cellKey in [...] && status == 'live' && expiresAt > now`, served by the
    // composite index in firestore.indexes.json). The same two conditions are
    // required HERE, so a claimed or expired crown disappears from every client
    // the moment it is written — claiming sets expiresAt to the claim instant
    // precisely so this rule hides it before the sweep gets to it.
    //
    // NO client writes. A crown is a reward-bearing document: a client that
    // could write one could mint Kronpoäng at a coordinate of its choosing.
    // -------------------------------------------------------------------------
    match /crownSpawns/{spawnId} {
      allow read: if (isActiveMember()
                      && resource.data.status == 'live'
                      && resource.data.expiresAt > request.time)
                  || isAdmin();
      // No client writes.
    }

    // -------------------------------------------------------------------------
    // crownSpawnCells – ADMIN ALLOW-LIST of areas the spawner may place in
    // The human half of the auto-spawn safety model. An auto-spawned crown has
    // no per-point safe-location confirmation (no human ever saw the
    // coordinate), so an admin approves the ~1.1 km CELL instead and the
    // spawner reads ONLY approved cells. Writes go exclusively through the
    // audited, admin-gated crownHunt.setSpawnCellApproval callable.
    //
    // Admin-readable (the approval map in the admin portal); NOT
    // member-readable — the allow-list is an operational safety artefact, not
    // game content, and exposing "approved but currently empty" would tell a
    // client exactly where to wait for the next spawn. Members see crowns, not
    // the grid.
    // -------------------------------------------------------------------------
    match /crownSpawnCells/{cellKey} {
      allow read: if isAdmin();
      // No client writes — approval is a callable, so it is always audited.
    }

    // -------------------------------------------------------------------------
    // crownCellActivity – aggregate ACTIVITY heat used to size spawn density
    // BACKEND-ONLY, both directions. One document per grid cell plus a
    // `recentUsers/{hash}` sub-collection holding one `lastSeenAt` per DISTINCT
    // user, keyed by a CELL-SCOPED SHA-256 pseudonym (no uid, no coordinate, no
    // trace — the same person is a different identifier in every cell, so the
    // documents cannot be joined into a route). Written only by the Admin SDK,
    // from live.updatePosition, and only for members with an active live-
    // sharing session who are moving slowly.
    //
    // Denied to clients even though it is pseudonymous: it still describes
    // where people gather and when, no client has any use for it (the spawner
    // is the only consumer), and a member who could read it could predict where
    // crowns are about to appear.
    // -------------------------------------------------------------------------
    match /crownCellActivity/{cellKey} {
      allow read, write: if false;

      match /recentUsers/{userHash} {
        allow read, write: if false;
      }
    }

    // -------------------------------------------------------------------------
    // crownSpawnClaims – every auto-spawn claim ATTEMPT
    // Document ID = the namespaced SHA-256-scoped idempotency key. Owner-only
    // read (collection history); all writes go through crownHunt.claimSpawn.
    // Risk data is NOT here — see crownSpawnClaimRisk below.
    // -------------------------------------------------------------------------
    match /crownSpawnClaims/{claimId} {
      allow read: if (isActiveMember() && resource.data.userId == request.auth.uid) || isAdmin();
      // No client writes.
    }

    // -------------------------------------------------------------------------
    // crownSpawnClaimRisk – anti-fraud scores and reasons for spawn claims
    // Fully backend-only, for the same reason as crownHuntClaimRisk: risk
    // thresholds and reason labels must never reach mobile clients, so they
    // live apart from the owner-readable claim records.
    // -------------------------------------------------------------------------
    match /crownSpawnClaimRisk/{claimId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // crownSpawnDailyClaims – per-user/per-UTC-day spawn-claim counter
    // Backend-only. A deterministic document (ID independent of the client
    // idempotency key) that crownHunt.claimSpawn reads and increments INSIDE
    // the award transaction, so the daily cap holds under concurrency. Never
    // client-readable or client-writable — a member must not be able to inspect
    // or reset their own cap.
    // -------------------------------------------------------------------------
    match /crownSpawnDailyClaims/{counterId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Kronjakt STATISTICS + LEADERBOARD + SEASONS (read-optimised aggregates)
    //
    // Every collection below is maintained EXCLUSIVELY by backend triggers and
    // the scheduled season rollover (Admin SDK). No client ever writes them, so
    // every write rule is `false`. The READ audience differs by collection and
    // that is the whole security surface of this slice:
    //
    //  - crownHuntLeaderboardEntries/{scope}__{uid} — the public leaderboard, a
    //    flat collection with a `scope` field ('alltime' | seasonId). Any
    //    authenticated member may read it (leaderboards are public within the
    //    app). The client filters by scope, orders by points, and resolves
    //    display names from the public user profiles it can already read. Ranks
    //    are global; a blocked member is not filtered out — their standing is a
    //    fact.
    //  - crownHuntUserStats/{uid} — a member's own rich stats (streak, rarity
    //    breakdown, rarest crown, seasonsWon). Readable ONLY by that member and
    //    admins: it is the one place per-user activity detail lives.
    //  - crownHuntSeasons/{seasonId} — season metadata + finalized standings and
    //    winners. Member-readable so the social screen can show past champions.
    //  - crownHuntSpawnStats / crownHuntCellStats — admin dashboard aggregates
    //    including WHERE crowns spawn (the heat-map). Admin-only: publishing the
    //    per-cell map to members would tell a client where to wait for spawns.
    // -------------------------------------------------------------------------
    match /crownHuntLeaderboardEntries/{entryId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /crownHuntUserStats/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    match /crownHuntSeasons/{seasonId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /crownHuntSpawnStats/{scope} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /crownHuntCellStats/{cellKey} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Backend-only exactly-once markers for the stats triggers/rollover
    // (crownHuntStatFolds, crownHuntSpawnFolds, crownHuntSeasonWinCredits).
    // Never client-readable or client-writable.
    match /crownHuntStatFolds/{foldId} {
      allow read, write: if false;
    }
    match /crownHuntSpawnFolds/{foldId} {
      allow read, write: if false;
    }
    match /crownHuntSeasonWinCredits/{seasonId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // pointsLedger – Kronpoäng balances and append-only ledger (Phase 9g)
    // ALL writes are backend transactions (creditPoints/debitPoints + the
    // points.admin* callables) — clients never calculate or write balances,
    // entries are never edited or deleted, and a balance can never go negative.
    //
    // READ SPLIT (2026-08): the ledger DOCUMENT and its ENTRIES have different
    // audiences.
    //
    //  - The DOCUMENT (`pointsLedger/{uid}`) carries ONLY the denormalized
    //    balance {balance, updatedAt} — no per-transaction detail. The balance
    //    is public PROFILE info now: Seb asked (2026-08) that a member's
    //    Kronpoäng be visible on their profile to any other member, exactly like
    //    the badge wall (users/{uid}/badges) and the garage (/vehicles) rendered
    //    beside it. So the document is readable by any authenticated user. That
    //    is the SAME isAuthenticated() gate those two already use, so the
    //    read-only member-profile screen renders as one consistent page.
    //    Firestore has no field-level read security, but this document has
    //    nothing to hide field-by-field: {balance, updatedAt} IS the number the
    //    profile shows. Block invisibility is enforced a layer up, identically
    //    to badges/vehicles: MemberProfileCoordinator withholds the WHOLE
    //    profile (this balance included) when the viewer has blocked the target,
    //    so there is no rules-layer block term here — matching the existing
    //    public-profile reads rather than diverging from them.
    //
    //  - The ENTRIES (`pointsLedger/{uid}/entries/{id}`) are the append-only
    //    ledger: every credit and debit, each with its source and reason. That
    //    is a running activity log ("Sparad körning", "Märke upplåst",
    //    "Kronjakt") and stays OWNER-ONLY — the profile shows the balance, never
    //    the statement behind it. This is deliberately UNCHANGED.
    // -------------------------------------------------------------------------
    match /pointsLedger/{userId} {
      // Public balance: the denormalized {balance, updatedAt} document is
      // readable by any authenticated user (public profile info). Entries below
      // stay owner-only.
      //
      // `get`, NOT `read`: this is a per-uid single-document read (the profile
      // fetches pointsLedger/{targetUid} by id), so only `get` is granted. `list`
      // is deliberately withheld — granting `read` would ALSO authorise a QUERY
      // of the whole `pointsLedger` collection, letting any authenticated client
      // enumerate and scrape every member's balance. The owner reads their own
      // balance by id too (a get), so nothing legitimately needs `list` here.
      allow get: if isAuthenticated();
      // No client writes.

      match /entries/{entryId} {
        allow read: if isOwner(userId);
        // No client writes: append-only via backend transactions.
      }
    }

    // -------------------------------------------------------------------------
    // POINTS ECONOMY (Phase 20) — the earning rules on top of the 9g ledger.
    //
    // The single invariant across every collection below: points are
    // SERVER-AUTHORITATIVE. A member may READ the state that explains their own
    // balance (their streak, their attendance evidence) and may write NONE of
    // it. Everything is written by the economy award engine
    // (functions/src/points/economy-award.ts) and its triggers/callables
    // through the Admin SDK, which bypasses these rules.
    //
    // If any of these ever became client-writable the whole economy would be
    // forgeable in one line of client code — a member could zero their own
    // daily-cap counter, set a 400-day streak, or mark themselves present at an
    // event they never attended. Hence: no `allow write` anywhere in this
    // block, for anyone, including admins (the admin app reads points through
    // the points.admin* callables).
    // -------------------------------------------------------------------------

    // pointsStreaks – the member's daily-open streak (lastOpenDay, streak,
    // longestStreak). Owner-readable so the app can show "dag 5 i rad" without
    // a callable round-trip; backend-only writes, so the streak that drives the
    // 1.0x–1.7x multiplier cannot be set by the client that benefits from it.
    match /pointsStreaks/{userId} {
      allow read: if isOwner(userId);
      // No client writes: points.recordDailyOpen only.
    }

    // pointsDailyTotals / pointsWeeklyDriving – the cap counters
    // ({uid}__{YYYY-MM-DD} and {uid}__{w-YYYY-MM-DD}). Fully backend-only:
    // these ARE the DAILY_POINTS_CAP and WEEKLY_DRIVING_POINTS_CAP ceilings,
    // read and incremented inside the award transaction. Not even
    // owner-readable — a member has no use for the raw counter, and exposing
    // it would leak exactly how close the ceiling is to anyone building a
    // grinding script.
    match /pointsDailyTotals/{counterId} {
      allow read, write: if false;
    }

    match /pointsWeeklyDriving/{counterId} {
      allow read, write: if false;
    }

    // pointsRuleCounters – per-rule limit counters
    // ({uid}__{ruleKey}__{day|eventId|all}) enforcing 1/day, 2/day, 3/day,
    // 1/event and once-ever. Backend-only for the same reason.
    match /pointsRuleCounters/{counterId} {
      allow read, write: if false;
    }

    // pointsLedgerFolds – exactly-once markers for folding Kronjakt crown
    // awards into the daily cap (points/economyTriggers.ts onLedgerEntryCreated).
    // Pure bookkeeping; backend-only.
    match /pointsLedgerFolds/{foldId} {
      allow read, write: if false;
    }

    // pointsEconomyRateLimit – per-minute call counters for the two
    // client-facing economy callables ({uid}__{action}__{epochMinute}).
    // Backend-only; a Firestore TTL policy on `expireAt` reaps spent windows.
    match /pointsEconomyRateLimit/{windowId} {
      allow read, write: if false;
    }

    // eventAttendance – geofence + dwell attendance evidence, one document per
    // (eventId, uid). OWNER-READABLE so a member can see their own check-in
    // progress ("8 of 10 minutes"), and — critically — NEVER client-writable:
    // the samples in this document are the proof that decides a 50 KP award,
    // so a client write would be a self-service attendance certificate.
    // The samples are raw member coordinates, so the document also carries an
    // `expireAt` and is reaped by a Firestore TTL policy after 90 days
    // (ATTENDANCE_EVIDENCE_RETENTION_MS) — long enough to settle a dispute
    // about the award, not a permanent location record. Deleting it cannot
    // re-open the award: the ledger idempotency key, the per-event rule
    // counter and the host tally guard all outlive it, none with a TTL.
    match /eventAttendance/{attendanceId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      // No client writes: events.checkIn only.
    }

    // eventAttendanceRisk – anti-fraud scores and reasons for rejected
    // check-in samples. A SEPARATE collection from eventAttendance for exactly
    // the reason crownHuntClaimRisk is separate from crownHuntClaims: the
    // attendance record is owner-readable, and risk thresholds/reasons must
    // never reach a mobile client — telling someone which signal tripped is
    // telling them what to change. Fully backend-only.
    match /eventAttendanceRisk/{attendanceId} {
      allow read, write: if false;
    }

    // eventAttendanceCounts – verified-attendee tally per event plus its
    // `counted/{uid}` exactly-once guards; feeds the 3-attendee
    // event_host_success award. Backend-only: it is a count of who was
    // physically present, which is nobody's business but the backend's.
    match /eventAttendanceCounts/{eventId} {
      allow read, write: if false;

      match /counted/{userId} {
        allow read, write: if false;
      }
    }

    // -------------------------------------------------------------------------
    // badgeProgress – backend-only achievement counters (Phase 9f + ladders)
    //
    // Maintained by events.complete (completedEventsAttended → first_event /
    // five_events / Träffräv) and by the badges Firestore triggers
    // (functions/src/badges/progressTriggers.ts): crownsCollected,
    // lifetimeDistanceMeters, bestDayStreak, convoysLed, vehiclesInGarage.
    //
    // DENIED TO EVERY CLIENT — read included, owner included. Two separate
    // reasons, and both still hold now that users/{uid}/badges is public:
    //
    //  1. ANTI-ABUSE. Every ladder threshold is tested against these numbers,
    //     so if a client could write one it could mint any badge. The Admin SDK
    //     (which bypasses rules) is the only writer.
    //  2. PRIVACY. Badges are the showpiece; these counters are not. Publish
    //     the trophies, not the telemetry — an award says a rung was reached,
    //     while `bestDayStreak`, `lifetimeDistanceMeters`,
    //     `completedEventsAttended` and `crownsCollected` are a running log of
    //     how much someone drives, when they open the app and where they go.
    //     Making the badge wall readable widened exactly one collection and
    //     deliberately did NOT widen this one, not even to its owner.
    // -------------------------------------------------------------------------
    match /badgeProgress/{userId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // badgeSweepState – backend-only cursor for the badges-evaluateBacklog
    // scheduled sweep (functions/src/badges/scheduled.ts). No client access.
    // -------------------------------------------------------------------------
    match /badgeSweepState/{docId} {
      allow read, write: if false;
    }

    // (event chat rules live in the Phase 9c messages/messageReports blocks
    // above — the old communityMessages scaffold collection is retired.)

    // -------------------------------------------------------------------------
    // moderationReports – the ONE abuse/content moderation queue. Admin-only
    // read; admin status-only update; NO client writes at all.
    //
    // The Phase 9o `allow create` (any authenticated user could write a report
    // document directly, with the rules doing field validation) is REMOVED: the
    // three report callables — chatchannels.reportMessage (community + convoy
    // channel messages), dm.reportMessage (1:1 DMs) and moderation.reportUser
    // (a person, not a message) — are now the only write path, alongside the
    // pre-existing events.reportChatMessage for event chat. A direct client
    // create bypassed every guarantee those callables provide: it checked no
    // eligibility on the surface being reported (you could report a message in
    // a convoy you were never in, or a DM you are not party to), enforced no
    // per-reporter rate limit, deduplicated nothing, snapshotted nothing, and
    // let a client aim an arbitrary targetId at anyone. Nothing in the app used
    // it — the admin module only reads and resolves.
    //
    // Documents keep the legacy field names and status vocabulary
    // (reportedBy / targetType / targetId / reason / details /
    // status pending|reviewed|dismissed / createdAt) so the existing admin
    // queue renders and resolves them unchanged, and carry added fields the
    // scaffold had no room for: surface + scopeId (which chat, which convoy or
    // conversation), reportedUserId (pivot "every report against this person"),
    // occurrences (this reporter's tally), and `snapshot` — a copy of the
    // reported message's text + author + createdAt taken at report time.
    //
    // The snapshot is why reads stay admin-only. It is necessary: DM messages
    // are readable only by the two participants (the rules give admins no read
    // path into conversations, by design) and channel messages are TTL-deleted
    // after 30/120 days, so a report holding only ids would be unactionable or
    // blank. It is exactly ONE message — the one the reporter escalated —
    // never a thread and never a history. Reporter identities are likewise
    // never client-readable (mirrors events/{eventId}/messageReports).
    // -------------------------------------------------------------------------
    match /moderationReports/{reportId} {
      allow read: if isAdmin();
      // No client writes: chatchannels.reportMessage / dm.reportMessage /
      // moderation.reportUser only.
      // Admin review updates may ONLY move the status through the review
      // vocabulary — reporter identity, target, and reason are immutable.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['pending', 'reviewed', 'dismissed'];
      // No deletes: reports are review records (admins resolve via status).
    }

    // -------------------------------------------------------------------------
    // diagnosticsReports – crash/error telemetry (Phase 9n)
    // Admin-only read. ALL writes go through the diagnostics.submitReport
    // callable so the privacy sanitization (tokens/credentials/coordinates/
    // stack traces stripped) runs server-side on every report — a direct
    // client create would bypass it. Replaces the Phase 8 errorReports
    // scaffold (retired: unsanitized client creates, absent from the
    // migration mapping).
    // -------------------------------------------------------------------------
    match /diagnosticsReports/{reportId} {
      allow read: if isAdmin();
      // No client writes: diagnostics.submitReport only.
    }

    // moderationUserSummaries – per-reported-user aggregate
    // ({reporterCount, totalSubmissions, lastReportedAt}), maintained in the same
    // transaction as a moderation.reportUser write. Exists so the admin queue
    // can answer "how many DIFFERENT people have reported this person" in one
    // document read instead of a scan. Admin-only read: the counts are a
    // moderation signal about a member, and exposing "you have been reported by
    // N people" to anyone (least of all the reported user) would be both a
    // harassment vector and a way to probe who reported whom.
    match /moderationUserSummaries/{userId} {
      allow read: if isAdmin();
      // No client writes: moderation.reportUser only.
    }

    // feedbackReports – "Report a problem" record of record (Android)
    // Admin-only read. The PRIVATE record: carries the reporter's uid, the
    // typed text, client context, and the cross-referenced GitHub issue
    // number/url/status. ALL writes go through the feedback.reportIssue
    // callable, which files the public GitHub issue without attaching the
    // caller's uid or any server-side account identifier (user-typed text is
    // public; the in-app UI warns against including personal info) — a direct
    // client create would bypass that safety, so none is allowed.
    match /feedbackReports/{reportId} {
      allow read: if isAdmin();
      // No client writes: feedback.reportIssue only.
    }

    // clientErrorReports – authenticated client-error record of record (Android)
    // Admin-only read. The PRIVATE record: carries the reporter's uid, the
    // (app-generated) error message/code, client context, the dedup fingerprint,
    // and the cross-referenced GitHub issue number/url/status. ALL writes go
    // through the errors.reportClientError callable (Admin SDK), which also
    // writes the adminAuditEvents entry and whose onClientErrorReport trigger
    // files the deduped PUBLIC issue without attaching the uid — a direct client
    // create would bypass that safety, so none is allowed.
    match /clientErrorReports/{reportId} {
      allow read: if isAdmin();
      // No client writes: errors.reportClientError only.
    }

    // clientErrorIssueLinks – client-error → GitHub issue dedup index (server-only)
    // Keyed by the error fingerprint. Written EXCLUSIVELY by the
    // errors-onClientErrorReport Firestore trigger (Admin SDK): it stores the
    // filed public issue number/url plus the occurrence tally so one unique
    // client error maps to one issue. Admin-only read for triage; NO client
    // writes — a client write could forge/spoof the dedup link or issue ref.
    match /clientErrorIssueLinks/{fingerprint} {
      allow read: if isAdmin();
      // No client writes: errors-onClientErrorReport (Admin SDK) only.
    }

    // serverErrorReports – BACKEND error record of record (never client-written)
    // Admin-only read. The PRIVATE record for an unhandled SERVER-side failure
    // (a scheduled sweep or trigger throwing): carries the FULL error message,
    // the trimmed stack trace, the call-site context and the dedup fingerprint.
    // This is deliberately the ONLY place that detail exists — the auto-filed
    // PUBLIC GitHub issue carries an allowlist (source, errorName, errorCode,
    // file:line frames, fingerprint) and never the message/stack, because server
    // error text embeds Firestore document paths (which contain uids), user
    // values and coordinates. Written EXCLUSIVELY by reportServerError via the
    // Admin SDK; NO client writes — a forged report would file a public issue.
    match /serverErrorReports/{reportId} {
      allow read: if isAdmin();
      // No client writes: errors/serverErrors.ts (Admin SDK) only.
    }

    // serverErrorIssueLinks – server-error → GitHub issue dedup index (server-only)
    // Keyed by the server-error fingerprint. Written EXCLUSIVELY by the
    // errors-onServerErrorReport Firestore trigger (Admin SDK): the filed public
    // issue number/url plus the occurrence tally, so one unique backend failure
    // maps to one issue however often it recurs. Admin-only read for triage; NO
    // client writes — a client write could forge/spoof the dedup link or issue
    // ref, or silence a real failure by pre-claiming its fingerprint.
    match /serverErrorIssueLinks/{fingerprint} {
      allow read: if isAdmin();
      // No client writes: errors-onServerErrorReport (Admin SDK) only.
    }

    // githubIssueBudget – global hourly auto-issue budget (backend-only)
    // One counter document per UTC hour (`YYYYMMDDHH`) shared by EVERY auto-issue
    // path (client errors, server errors). Charged transactionally before any
    // GitHub create; over the cap the create is skipped so a bad release cannot
    // dump hundreds of permanently world-readable issues onto the public repo.
    // FULLY backend-only — not even admins read it: it is pure rate-limiter
    // state with no triage value, and a readable counter would tell a client
    // exactly how much budget is left to exhaust.
    match /githubIssueBudget/{bucketId} {
      allow read, write: if false;
    }

    // signInIssueLinks – sign-in-failure → GitHub issue dedup index (server-only)
    // Keyed by the diagnostics report fingerprint. Written EXCLUSIVELY by the
    // diagnostics-onSignInFailure Firestore trigger (Admin SDK): it stores the
    // filed public GitHub issue number/url plus the occurrence tally
    // (count/firstSeenAt/lastSeenAt) so one unique sign-in error maps to one
    // issue. Admin-only read for triage; NO client writes — the trigger bypasses
    // rules via the Admin SDK, and a client write could forge/spoof the dedup
    // link or the issue reference.
    match /signInIssueLinks/{fingerprint} {
      allow read: if isAdmin();
      // No client writes: diagnostics-onSignInFailure (Admin SDK) only.
    }

    // -------------------------------------------------------------------------
    // adminAuditEvents – backend-written audit log
    // Immutable records written exclusively by the Admin SDK (admin callables).
    // No client writes — not even by admins — so audit entries can never be
    // forged, altered, or deleted from a client.
    // -------------------------------------------------------------------------
    match /adminAuditEvents/{eventId} {
      allow read: if isAdmin();
      // No client writes allowed.
    }

    // -------------------------------------------------------------------------
    // moderationActions – backend-written moderation records
    // Immutable records written exclusively by the Admin SDK
    // (admin.suspendUser / admin.restoreAccess). Admin-only read; no client
    // writes — not even by admins.
    // -------------------------------------------------------------------------
    match /moderationActions/{actionId} {
      allow read: if isAdmin();
      // No client writes allowed.
    }

    // -------------------------------------------------------------------------
    // accountDeletionRequests – user-initiated account deletion
    // Document ID == Firebase UID of the requesting user.
    // Deliberately NOT gated on suspension: suspended users retain access to
    // support and account-deletion paths (migration plan, Phase 8 definition
    // of done). The same applies to userPrivate and moderationReports above.
    // (Diagnostics submission is a public callable, unauthenticated allowed.)
    // -------------------------------------------------------------------------
    match /accountDeletionRequests/{requestId} {
      // Owner create remains as the low-tech fallback path; the canonical
      // entry point is the account.deleteAccount callable (Phase 9p),
      // which also disables the Auth user immediately. Shape-validated so
      // a client can never pre-mark a request processed.
      allow create: if isOwner(requestId)
        && request.resource.data.keys().hasOnly(['userId', 'reason', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['userId', 'status', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        // Server timestamp only: a client can neither backdate the request
        // (skipping the 30-day retention window) nor omit createdAt (which
        // would hide the request from the purge query forever).
        && isServerTimestamp(request.resource.data.createdAt)
        && (!request.resource.data.keys().hasAny(['reason'])
            || (request.resource.data.reason is string
                && request.resource.data.reason.size() <= 500));
      allow read: if isOwner(requestId);
      // Admins may read all requests and update status (e.g. mark as processed).
      // The hard purge is handled by the scheduled account-purgeDeleted.
      allow read, update: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // subscriptions – subscription entitlement records
    // Written exclusively by Cloud Functions after receipt verification.
    // Clients must never write to this collection.
    // -------------------------------------------------------------------------
    match /subscriptions/{userId} {
      allow read: if isOwner(userId);
      allow read: if isAdmin();
      // No client writes — not even admin clients (Phase 11 tightening,
      // matching the data model's "written by Cloud Functions only after
      // receipt verification"): subscription.verify /
      // admin.grantEntitlement are the only writers.
    }
  }
}
