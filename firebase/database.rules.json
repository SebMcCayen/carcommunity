{
  "rules": {
    ".read": false,
    ".write": false,
    "liveLocation": {
      "$uid": {
        "session": {
          ".read": "auth != null && auth.uid == $uid"
        },
        "latest": {
          ".read": "auth != null && auth.token.activeMember == true && auth.token.suspended != true && (auth.uid == $uid || (!root.child('liveLocationBlocks').child($uid).child(auth.uid).exists() && !root.child('liveLocationBlocks').child(auth.uid).child($uid).exists()))"
        }
      }
    },
    "liveLocationBlocks": {
      ".read": false,
      ".write": false
    },
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['online', 'lastSeen'])",
        "online": { ".validate": "newData.isBoolean()" },
        "lastSeen": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    }
  }
}
