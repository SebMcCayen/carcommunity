{
  "rules": {
    ".read": false,
    ".write": false,
    "liveLocations": {
      "$uid": {
        ".read": "auth != null && auth.token.activeMember == true",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasOnly(['lat', 'lng', 'timestamp']) && newData.child('lat').isNumber() && newData.child('lng').isNumber() && newData.child('timestamp').isNumber()"
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasOnly(['online', 'lastSeen']) && newData.child('online').isBoolean() && newData.child('lastSeen').isNumber()"
      }
    }
  }
}
