{
  "rules": {
    ".read": false,
    ".write": false,
    "liveLocations": {
      "$uid": {
        ".read": "auth != null && auth.token.activeMember == true && auth.token.suspended != true",
        ".write": "auth != null && auth.uid == $uid && auth.token.suspended != true",
        ".validate": "newData.hasChildren(['lat', 'lng', 'timestamp'])",
        "lat": { ".validate": "newData.isNumber()" },
        "lng": { ".validate": "newData.isNumber()" },
        "timestamp": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['online', 'lastSeen'])",
        "online": { ".validate": "newData.isBoolean()" },
        "lastSeen": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    }
  }
}
