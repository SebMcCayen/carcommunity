{
  "rules": {
    ".read": false,
    ".write": false,
    "liveLocation": {
      "$uid": {
        "session": {
          ".read": "auth != null && auth.uid == $uid"
        },
        // ---- MEMBER GATING SWITCH (Realtime Database rules layer) ----------
        // Member gating is currently DISABLED so live location is viewable
        // without a subscription. The `auth.token.activeMember == true &&`
        // term was removed from the non-owner branch below; the suspension
        // term and BOTH liveLocationBlocks direction checks are DELIBERATELY
        // KEPT — this one expression bundles all three guards.
        //
        // TO RE-LOCK: put `auth.token.activeMember == true && ` back at the
        // start of the non-owner branch, then redeploy database rules.
        // Independent of functions/src/shared/memberGating.ts, firestore.rules,
        // storage.rules AND the Android UI switch in
        // apps/android/.../config/MemberGating.kt — all FIVE switches must be
        // flipped together (memberGating.ts is the authoritative runbook).
        "latest": {
          ".read": "auth != null && (auth.uid == $uid || (auth.token.suspended != true && !root.child('liveLocationBlocks').child($uid).child(auth.uid).exists() && !root.child('liveLocationBlocks').child(auth.uid).child($uid).exists()))"
        }
      }
    },
    "liveLocationBlocks": {
      ".read": false,
      ".write": false
    },
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['online', 'lastSeen'])",
        "online": { ".validate": "newData.isBoolean()" },
        "lastSeen": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    }
  }
}
