{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SebMcCayen/carcommunity/contracts/schemas/events.schema.json",
  "title": "Events and RSVP contract",
  "description": "Language-neutral event and RSVP shapes shared by iOS, Android, backend, and admin. Values were originally sourced from packages/shared/src/events.ts; that package now serves only the admin web app, so this schema — not the TypeScript there — is the source of truth for the Firebase backend and the native clients, and the two deliberately diverge wherever a change lands in Firebase only. Teasers expose safe information PLUS the event's map location (place name + coordinates) to all authenticated users, so every signed-in user can see event pins on the community map (deliberate 2026-07 change from the earlier location-hidden teaser). The member-gated detail adds only the long description and the precise street address; admin shapes are admin/owner-only.",
  "$defs": {
    "eventStatus": {
      "type": "string",
      "enum": ["draft", "published", "cancelled", "completed"],
      "description": "Backend-managed event lifecycle state. Only published events are visible to non-admin users."
    },
    "eventRsvpStatus": {
      "type": "string",
      "enum": ["going", "maybe", "not_going"],
      "description": "A member's RSVP answer for an event."
    },
    "eventRsvpSummary": {
      "type": "object",
      "description": "Aggregated RSVP counts only — never exposes who RSVP'd.",
      "properties": {
        "going": { "type": "integer", "minimum": 0 },
        "maybe": { "type": "integer", "minimum": 0 },
        "not_going": { "type": "integer", "minimum": 0 }
      },
      "required": ["going", "maybe", "not_going"],
      "additionalProperties": false
    },
    "eventTeaser": {
      "type": "object",
      "description": "Public teaser: safe event information PLUS the map location. Visible to all authenticated users regardless of subscription. The place name and coordinate pair are deliberately public (2026-07) so every signed-in user can see the event as a pin on the community map. Still excludes the precise street address, the long description, and any personal data — those stay member-only on eventDetail.",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "startsAt": { "$ref": "common.schema.json#/$defs/isoTimestamp" },
        "endsAt": { "$ref": "common.schema.json#/$defs/nullableIsoTimestamp" },
        "approximateArea": {
          "type": ["string", "null"],
          "minLength": 1,
          "description": "Coarse area label (e.g. municipality) — the human-readable region, distinct from the exact pin below. Null (never empty) when the organiser gave none: the member create form dropped its input (2026-08)."
        },
        "locationName": {
          "type": ["string", "null"],
          "description": "Public place name for the map pin (e.g. 'Kungsbacka torg'). Null when the organiser set no name."
        },
        "latitude": {
          "type": ["number", "null"],
          "minimum": -90,
          "maximum": 90,
          "description": "Public map-pin latitude. Null (paired with longitude) when the event has no positioned pin."
        },
        "longitude": {
          "type": ["number", "null"],
          "minimum": -180,
          "maximum": 180,
          "description": "Public map-pin longitude. Null (paired with latitude) when the event has no positioned pin."
        },
        "isOfficial": { "type": "boolean" },
        "status": { "$ref": "#/$defs/eventStatus" }
      },
      "required": [
        "id",
        "title",
        "startsAt",
        "endsAt",
        "approximateArea",
        "locationName",
        "latitude",
        "longitude",
        "isOfficial",
        "status"
      ],
      "additionalProperties": false
    },
    "eventDetail": {
      "type": "object",
      "description": "Full event detail — the public teaser (including the map location) plus the member-only fields the private detail document adds: the long description and the precise street address. The location fields here mirror the now-public teaser (a composite full view); the member gate protects only description and address. Never exposes internal admin fields.",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "startsAt": { "$ref": "common.schema.json#/$defs/isoTimestamp" },
        "endsAt": { "$ref": "common.schema.json#/$defs/nullableIsoTimestamp" },
        "locationName": { "type": ["string", "null"] },
        "address": { "type": ["string", "null"] },
        "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
        "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
        "isOfficial": { "type": "boolean" },
        "status": { "$ref": "#/$defs/eventStatus" },
        "rsvpSummary": { "$ref": "#/$defs/eventRsvpSummary" },
        "currentUserRsvp": {
          "oneOf": [{ "$ref": "#/$defs/eventRsvpStatus" }, { "type": "null" }]
        }
      },
      "required": [
        "id",
        "title",
        "summary",
        "description",
        "startsAt",
        "endsAt",
        "locationName",
        "address",
        "latitude",
        "longitude",
        "isOfficial",
        "status",
        "rsvpSummary",
        "currentUserRsvp"
      ],
      "additionalProperties": false
    },
    "eventRsvpRequest": {
      "type": "object",
      "properties": {
        "status": { "$ref": "#/$defs/eventRsvpStatus" }
      },
      "required": ["status"],
      "additionalProperties": false
    },
    "eventRsvpData": {
      "type": "object",
      "description": "A member's stored RSVP. updatedAt is backend-written.",
      "properties": {
        "eventId": { "type": "string", "minLength": 1 },
        "userId": { "$ref": "common.schema.json#/$defs/uid" },
        "status": { "$ref": "#/$defs/eventRsvpStatus" },
        "updatedAt": { "$ref": "common.schema.json#/$defs/isoTimestamp" }
      },
      "required": ["eventId", "userId", "status", "updatedAt"],
      "additionalProperties": false
    },
    "adminEventSummary": {
      "type": "object",
      "description": "Admin-facing event summary with operational context. Only returned to admin/owner roles.",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/eventStatus" },
        "isOfficial": { "type": "boolean" },
        "startsAt": { "$ref": "common.schema.json#/$defs/isoTimestamp" },
        "endsAt": { "$ref": "common.schema.json#/$defs/nullableIsoTimestamp" },
        "approximateArea": { "type": ["string", "null"], "minLength": 1 },
        "rsvpCounts": { "$ref": "#/$defs/eventRsvpSummary" },
        "cancelledAt": { "$ref": "common.schema.json#/$defs/nullableIsoTimestamp" },
        "createdAt": { "$ref": "common.schema.json#/$defs/isoTimestamp" },
        "updatedAt": { "$ref": "common.schema.json#/$defs/isoTimestamp" }
      },
      "required": [
        "id",
        "title",
        "status",
        "isOfficial",
        "startsAt",
        "endsAt",
        "approximateArea",
        "rsvpCounts",
        "cancelledAt",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "adminEventDetail": {
      "type": "object",
      "description": "Full admin event detail — all fields including exact location. Only returned to admin/owner roles.",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "status": { "$ref": "#/$defs/eventStatus" },
        "startsAt": { "$ref": "common.schema.json#/$defs/isoTimestamp" },
        "endsAt": { "$ref": "common.schema.json#/$defs/nullableIsoTimestamp" },
        "approximateArea": { "type": ["string", "null"], "minLength": 1 },
        "locationName": { "type": ["string", "null"] },
        "address": { "type": ["string", "null"] },
        "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
        "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
        "isOfficial": { "type": "boolean" },
        "createdByUserId": {
          "oneOf": [{ "$ref": "common.schema.json#/$defs/uid" }, { "type": "null" }]
        },
        "createdAt": { "$ref": "common.schema.json#/$defs/isoTimestamp" },
        "updatedAt": { "$ref": "common.schema.json#/$defs/isoTimestamp" },
        "cancelledAt": { "$ref": "common.schema.json#/$defs/nullableIsoTimestamp" },
        "rsvpCounts": { "$ref": "#/$defs/eventRsvpSummary" }
      },
      "required": [
        "id",
        "title",
        "summary",
        "description",
        "status",
        "startsAt",
        "endsAt",
        "approximateArea",
        "locationName",
        "address",
        "latitude",
        "longitude",
        "isOfficial",
        "createdByUserId",
        "createdAt",
        "updatedAt",
        "cancelledAt",
        "rsvpCounts"
      ],
      "additionalProperties": false
    },
    "createEventRequest": {
      "type": "object",
      "description": "Event creation payload for events.create — sent by an active member or an admin/owner. `isOfficial` is honoured only for an admin caller; it is forced false on a member-created event. `publishNow` publishes the event on create (the community app, which has no draft/publish UI, always sends it); it only lifts an admin-created event from draft to published and is a no-op for a member. Omitted by admin-web, which keeps its draft-then-publish flow.",
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "startsAt": { "$ref": "common.schema.json#/$defs/isoTimestamp" },
        "endsAt": { "$ref": "common.schema.json#/$defs/nullableIsoTimestamp" },
        "approximateArea": { "type": "string", "minLength": 1 },
        "locationName": { "type": ["string", "null"] },
        "address": { "type": ["string", "null"] },
        "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
        "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
        "isOfficial": { "type": "boolean" },
        "publishNow": { "type": "boolean" }
      },
      "required": ["title", "startsAt"],
      "additionalProperties": false
    },
    "updateEventRequest": {
      "type": "object",
      "description": "Admin-only partial event update payload. All fields optional.",
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "startsAt": { "$ref": "common.schema.json#/$defs/isoTimestamp" },
        "endsAt": { "$ref": "common.schema.json#/$defs/nullableIsoTimestamp" },
        "approximateArea": { "type": "string", "minLength": 1 },
        "locationName": { "type": ["string", "null"] },
        "address": { "type": ["string", "null"] },
        "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
        "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
        "isOfficial": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "cancelEventRequest": {
      "type": "object",
      "description": "Admin-only event cancellation payload. Reason is required for audit logging.",
      "properties": {
        "reason": { "type": "string", "minLength": 1 }
      },
      "required": ["reason"],
      "additionalProperties": false
    }
  }
}
