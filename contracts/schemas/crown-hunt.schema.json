{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SebMcCayen/carcommunity/contracts/schemas/crown-hunt.schema.json",
  "title": "Kronjakt (Crown Hunt) contract",
  "description": "Language-neutral Kronjakt shapes shared by iOS, Android, backend, and admin. crownHuntPoint mirrors `crownHuntPoints/{pointId}` and crownHuntClaim mirrors `crownHuntClaims/{claimId}` (docs/firebase-data-model.md). The backend is the sole authority for eligibility, claims, and Kronpoäng awards — clients never calculate or award points, claims are never automatic, and awards commit atomically with the claim record. Risk scores/reasons are backend-only and never appear in these client-facing shapes. Firestore stores timestamps as native Timestamp values; this contract describes their ISO 8601 JSON serialization.",
  "$defs": {
    "crownHuntRepeatRule": {
      "type": "string",
      "enum": ["once", "daily", "weekly"]
    },
    "crownHuntPointStatus": {
      "type": "string",
      "enum": ["draft", "active", "paused", "ended"],
      "description": "Only active points are visible to members. Activation is a safety-gated admin step."
    },
    "crownHuntClaimResult": {
      "type": "string",
      "enum": [
        "awarded",
        "already_claimed",
        "outside_geofence",
        "moving_too_fast",
        "position_too_old",
        "point_inactive",
        "cooldown_active",
        "daily_limit_reached",
        "risk_review",
        "feature_disabled",
        "not_eligible"
      ],
      "description": "Eligibility failures are result codes with Swedish user messages, not errors (legacy parity)."
    },
    "crownHuntPoint": {
      "type": "object",
      "description": "Firestore `crownHuntPoints/{pointId}`. Active members read active points; all writes via admin crownHunt.* callables.",
      "properties": {
        "title": { "type": "string", "maxLength": 100, "description": "Optional label; empty string when the point has no title." },
        "description": { "type": ["string", "null"], "maxLength": 500 },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "geofenceRadiusMeters": { "type": "number", "minimum": 20, "maximum": 150 },
        "rewardPoints": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "repeatRule": { "$ref": "#/$defs/crownHuntRepeatRule" },
        "status": { "$ref": "#/$defs/crownHuntPointStatus" },
        "maxCollectors": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "How many distinct users may collect this crown. null = unlimited (default). A positive integer caps the headcount: the first N distinct collectors succeed, then the point is deactivated (status 'ended'). Clients may show remaining slots as maxCollectors - collectorCount."
        },
        "collectorCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Distinct users who have collected this crown so far. 0 for unlimited or freshly-created points; maintained by the backend only."
        },
        "availableFrom": { "$ref": "common.schema.json#/$defs/nullableIsoTimestamp" },
        "availableUntil": { "$ref": "common.schema.json#/$defs/nullableIsoTimestamp" },
        "approvedAt": { "$ref": "common.schema.json#/$defs/nullableIsoTimestamp" },
        "approvedByUserId": { "type": ["string", "null"] },
        "createdByUserId": { "$ref": "common.schema.json#/$defs/uid" },
        "createdAt": { "$ref": "common.schema.json#/$defs/isoTimestamp" },
        "updatedAt": { "$ref": "common.schema.json#/$defs/isoTimestamp" }
      },
      "required": [
        "title",
        "description",
        "latitude",
        "longitude",
        "geofenceRadiusMeters",
        "rewardPoints",
        "repeatRule",
        "status",
        "availableFrom",
        "availableUntil",
        "approvedAt",
        "approvedByUserId",
        "createdByUserId",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "crownHuntClaim": {
      "type": "object",
      "description": "Firestore `crownHuntClaims/{claimId}` — every claim ATTEMPT. Document ID = SHA-256(userId ':' idempotencyKey). Owner-only member read; written only by crownHunt.submitClaim. Risk data lives in the backend-only crownHuntClaimRisk collection, never here.",
      "properties": {
        "userId": { "$ref": "common.schema.json#/$defs/uid" },
        "pointId": { "type": "string" },
        "result": { "$ref": "#/$defs/crownHuntClaimResult" },
        "claimedAt": { "$ref": "common.schema.json#/$defs/isoTimestamp" },
        "distanceMeters": { "type": ["number", "null"], "minimum": 0 },
        "positionRecordedAt": { "$ref": "common.schema.json#/$defs/nullableIsoTimestamp" },
        "reportedSpeedMetersPerSecond": { "type": ["number", "null"] },
        "pointsAwarded": { "type": ["integer", "null"], "minimum": 1 },
        "balanceAfter": { "type": ["integer", "null"], "minimum": 0 },
        "pointsLedgerEntryId": { "type": ["string", "null"] },
        "createdAt": { "$ref": "common.schema.json#/$defs/isoTimestamp" }
      },
      "required": ["userId", "pointId", "result", "claimedAt", "createdAt"],
      "additionalProperties": false
    },
    "submitClaimRequest": {
      "type": "object",
      "description": "Input for crownHunt.submitClaim (member-only). The position must be fresh (<=60 s) and the reported speed at or below walking pace (~1.4 m/s) — claiming requires being safely stopped. Distance is always computed server-side.",
      "properties": {
        "pointId": { "type": "string", "minLength": 1, "maxLength": 300 },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "accuracyMeters": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 10000,
          "description": "Reported horizontal GPS accuracy. Client-supplied, so it is bounded: larger (or non-finite) values are rejected as invalid-argument, and the value that reaches the geofence buffer is clamped server-side — the buffered fence can never exceed twice the point's configured radius."
        },
        "speedMetersPerSecond": { "type": ["number", "null"] },
        "recordedAt": { "$ref": "common.schema.json#/$defs/isoTimestamp" },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Fresh per button press; retries of the same press reuse it and replay the stored result."
        },
        "platformIntegrityPassed": {
          "type": ["boolean", "null"],
          "description": "Play Integrity / App Attest placeholder — null until native integration."
        }
      },
      "required": ["pointId", "latitude", "longitude", "recordedAt", "idempotencyKey"],
      "additionalProperties": false
    },
    "submitClaimResponse": {
      "type": "object",
      "properties": {
        "result": { "$ref": "#/$defs/crownHuntClaimResult" },
        "pointsAwarded": { "type": ["integer", "null"] },
        "newBalance": { "type": ["integer", "null"] },
        "message": { "type": "string", "description": "Swedish user-facing message." }
      },
      "required": ["result", "pointsAwarded", "newBalance", "message"],
      "additionalProperties": false
    },
    "createPointRequest": {
      "type": "object",
      "description": "Input for crownHunt.createPoint (admin). Points are created as drafts. A Crown is a map collectable (Pokémon GO–style), not a titled document — no title/description is accepted; rewardPoints comes from a rarity tier chosen in the admin UI. The stored crownHuntPoint still carries title ('') and description (null) for reader back-compat.",
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "geofenceRadiusMeters": { "type": "number", "minimum": 20, "maximum": 150 },
        "rewardPoints": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "repeatRule": { "$ref": "#/$defs/crownHuntRepeatRule" },
        "maxCollectors": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "How many distinct users may collect this crown. null (or omitted) = unlimited (default, best for events). A positive integer caps the headcount: the first N distinct collectors succeed, then the point is deactivated. Independent of the rarity tier."
        },
        "availableFrom": { "$ref": "common.schema.json#/$defs/nullableIsoTimestamp" },
        "availableUntil": { "$ref": "common.schema.json#/$defs/nullableIsoTimestamp" }
      },
      "required": [
        "latitude",
        "longitude",
        "geofenceRadiusMeters",
        "rewardPoints",
        "repeatRule"
      ],
      "additionalProperties": false
    },
    "activatePointRequest": {
      "type": "object",
      "description": "Input for crownHunt.activatePoint (admin). Activation is a safety gate: the location must be explicitly confirmed safe and the approval note lands in the audit record.",
      "properties": {
        "pointId": { "type": "string", "minLength": 1 },
        "safeLocationConfirmed": { "type": "boolean", "const": true },
        "approvalNote": { "type": "string", "minLength": 3, "maxLength": 2000 }
      },
      "required": ["pointId", "safeLocationConfirmed", "approvalNote"],
      "additionalProperties": false
    },

    "crownHuntRarity": {
      "type": "string",
      "enum": ["common", "uncommon", "rare", "legendary"],
      "description": "Auto-spawned crown rarity, ascending. Hand-placed points have no rarity."
    },
    "crownHuntRarityCounts": {
      "type": "object",
      "description": "Per-rarity histogram. Absent keys read as 0.",
      "properties": {
        "common": { "type": "integer", "minimum": 0 },
        "uncommon": { "type": "integer", "minimum": 0 },
        "rare": { "type": "integer", "minimum": 0 },
        "legendary": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "crownHuntLeaderboardEntry": {
      "type": "object",
      "description": "One ranked leaderboard row. displayName is resolved from the public user profile at read time; seasonsWon is the member's lifetime championship count for 'N-time champion' display.",
      "properties": {
        "rank": { "type": "integer", "minimum": 1 },
        "uid": { "$ref": "common.schema.json#/$defs/uid" },
        "displayName": { "type": "string" },
        "points": { "type": "integer", "minimum": 0 },
        "crownsCollected": { "type": "integer", "minimum": 0 },
        "seasonsWon": { "type": "integer", "minimum": 0 }
      },
      "required": ["rank", "uid", "displayName", "points", "crownsCollected", "seasonsWon"],
      "additionalProperties": false
    },
    "crownHuntLeaderboardEntryDoc": {
      "type": "object",
      "description": "Firestore `crownHuntLeaderboardEntries/{scope}__{uid}` — the maintained per-scope counter (scope = 'alltime' | seasonId). Member-readable; ranks and names are composed by the reader.",
      "properties": {
        "scope": { "type": "string" },
        "uid": { "$ref": "common.schema.json#/$defs/uid" },
        "points": { "type": "integer", "minimum": 0 },
        "crownsCollected": { "type": "integer", "minimum": 0 },
        "updatedAt": { "$ref": "common.schema.json#/$defs/isoTimestamp" }
      },
      "required": ["scope", "uid", "points", "crownsCollected"],
      "additionalProperties": false
    },
    "crownHuntPersonalStats": {
      "type": "object",
      "description": "A member's own Kronjakt statistics (readable by that member and admins). points/crowns/rank/streak derive from the Kronpoäng ledger (both crown kinds); byRarity/rarest cover auto-spawned crowns only.",
      "properties": {
        "uid": { "$ref": "common.schema.json#/$defs/uid" },
        "allTime": {
          "type": "object",
          "properties": {
            "points": { "type": "integer", "minimum": 0 },
            "crownsCollected": { "type": "integer", "minimum": 0 },
            "rank": { "type": ["integer", "null"], "minimum": 1 }
          },
          "required": ["points", "crownsCollected", "rank"],
          "additionalProperties": false
        },
        "currentSeason": {
          "type": "object",
          "properties": {
            "seasonId": { "type": "string" },
            "points": { "type": "integer", "minimum": 0 },
            "crownsCollected": { "type": "integer", "minimum": 0 },
            "rank": { "type": ["integer", "null"], "minimum": 1 }
          },
          "required": ["seasonId", "points", "crownsCollected", "rank"],
          "additionalProperties": false
        },
        "byRarity": { "$ref": "#/$defs/crownHuntRarityCounts" },
        "rarestRarity": { "oneOf": [{ "$ref": "#/$defs/crownHuntRarity" }, { "type": "null" }] },
        "rarestAt": { "$ref": "common.schema.json#/$defs/nullableIsoTimestamp" },
        "streakCurrent": { "type": "integer", "minimum": 0 },
        "streakBest": { "type": "integer", "minimum": 0 },
        "lastCollectionAt": { "$ref": "common.schema.json#/$defs/nullableIsoTimestamp" },
        "seasonsWon": { "type": "integer", "minimum": 0, "description": "Lifetime first-place season finishes; grows every win." }
      },
      "required": ["uid", "allTime", "currentSeason", "byRarity", "streakCurrent", "streakBest", "seasonsWon"],
      "additionalProperties": false
    },
    "crownHuntAdminStats": {
      "type": "object",
      "description": "Admin dashboard totals for one scope ('alltime' | seasonId). Admin-only read.",
      "properties": {
        "scope": { "type": "string" },
        "spawnedTotal": { "type": "integer", "minimum": 0 },
        "collectedTotal": { "type": "integer", "minimum": 0 },
        "collectionRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "spawnedByRarity": { "$ref": "#/$defs/crownHuntRarityCounts" },
        "collectedByRarity": { "$ref": "#/$defs/crownHuntRarityCounts" },
        "activePlayers7d": { "type": "integer", "minimum": 0 },
        "activePlayers30d": { "type": "integer", "minimum": 0 }
      },
      "required": ["scope", "spawnedTotal", "collectedTotal", "collectionRate", "spawnedByRarity", "collectedByRarity", "activePlayers7d", "activePlayers30d"],
      "additionalProperties": false
    },
    "crownHuntCellStat": {
      "type": "object",
      "description": "Firestore `crownHuntCellStats/{cellKey}` — one 0.01° grid cell's spawn/collect counts for the admin heat/points map. cellKey is 'latIdx_lonIdx'; the cell centre is (latIdx*0.01, lonIdx*0.01). Admin-only read.",
      "properties": {
        "cellKey": { "type": "string" },
        "spawned": { "type": "integer", "minimum": 0 },
        "collected": { "type": "integer", "minimum": 0 },
        "spawnedByRarity": { "$ref": "#/$defs/crownHuntRarityCounts" },
        "collectedByRarity": { "$ref": "#/$defs/crownHuntRarityCounts" },
        "lastSpawnAt": { "$ref": "common.schema.json#/$defs/nullableIsoTimestamp" },
        "lastCollectAt": { "$ref": "common.schema.json#/$defs/nullableIsoTimestamp" }
      },
      "required": ["cellKey", "spawned", "collected"],
      "additionalProperties": false
    },
    "crownHuntSeasonStatus": {
      "type": "string",
      "enum": ["active", "ended"]
    },
    "crownHuntSeasonWinner": {
      "type": "object",
      "description": "A finalized podium finisher (top 3), with a displayName snapshot for the social screen.",
      "properties": {
        "rank": { "type": "integer", "minimum": 1, "maximum": 3 },
        "uid": { "$ref": "common.schema.json#/$defs/uid" },
        "displayName": { "type": "string" },
        "points": { "type": "integer", "minimum": 0 },
        "crownsCollected": { "type": "integer", "minimum": 0 }
      },
      "required": ["rank", "uid", "displayName", "points", "crownsCollected"],
      "additionalProperties": false
    },
    "crownHuntSeasonStanding": {
      "type": "object",
      "properties": {
        "rank": { "type": "integer", "minimum": 1 },
        "uid": { "$ref": "common.schema.json#/$defs/uid" },
        "points": { "type": "integer", "minimum": 0 },
        "crownsCollected": { "type": "integer", "minimum": 0 }
      },
      "required": ["rank", "uid", "points", "crownsCollected"],
      "additionalProperties": false
    },
    "crownHuntSeason": {
      "type": "object",
      "description": "Firestore `crownHuntSeasons/{seasonId}` (seasonId = 'YYYY-MM', one Europe/Stockholm calendar month). Member-readable. winners/topStandings populate only once status is 'ended' (scheduled rollover), so the social screen can show 'last month's champions'.",
      "properties": {
        "seasonId": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" },
        "period": { "type": "string", "const": "month" },
        "status": { "$ref": "#/$defs/crownHuntSeasonStatus" },
        "startAt": { "$ref": "common.schema.json#/$defs/isoTimestamp" },
        "endAt": { "$ref": "common.schema.json#/$defs/isoTimestamp" },
        "finalizedAt": { "$ref": "common.schema.json#/$defs/nullableIsoTimestamp" },
        "participantCount": { "type": ["integer", "null"], "minimum": 0 },
        "winners": { "type": "array", "items": { "$ref": "#/$defs/crownHuntSeasonWinner" } },
        "topStandings": { "type": "array", "items": { "$ref": "#/$defs/crownHuntSeasonStanding" } }
      },
      "required": ["seasonId", "period", "status", "startAt", "endAt"],
      "additionalProperties": false
    }
  }
}
