{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SebMcCayen/carcommunity/contracts/errors/errors.schema.json",
  "title": "Error codes registry schema",
  "description": "Meta-schema that errors.json must validate against. Enforced in CI.",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": { "type": "string" },
    "errorCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z]+(-[a-z]+)*$",
            "description": "Stable machine-readable code from the Firebase HttpsError vocabulary."
          },
          "meaning": { "type": "string", "minLength": 1 },
          "httpStatus": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          }
        },
        "required": ["code", "meaning", "httpStatus"],
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "errorCodes"],
  "additionalProperties": false
}
