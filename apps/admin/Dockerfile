# syntax=docker/dockerfile:1
# ── Build stage ────────────────────────────────────────────────────────────────
FROM node:24-alpine AS builder
WORKDIR /app

# Copy workspace root manifests first for better layer caching.
COPY package.json package-lock.json ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/admin/package.json ./apps/admin/

RUN npm ci --workspace @carcommunity/shared --workspace @carcommunity/admin

# Copy root TypeScript base config (extended by workspace tsconfigs).
COPY tsconfig.base.json ./

# Copy source needed for build.
COPY packages/shared ./packages/shared
COPY apps/admin ./apps/admin

RUN npm run build -w @carcommunity/shared \
 && npm run build -w @carcommunity/admin

# ── Runtime stage ──────────────────────────────────────────────────────────────
# Next.js standalone output bundles the required runtime; no full node_modules copy needed.
FROM node:24-alpine AS runner

RUN addgroup -S nodejs \
 && adduser -S appuser -G nodejs

WORKDIR /app

# Copy standalone server (includes the minimal node_modules Next.js bundled).
COPY --from=builder /app/apps/admin/.next/standalone ./

# Copy static assets into the expected location for the standalone server.
COPY --from=builder /app/apps/admin/.next/static ./apps/admin/.next/static

USER appuser

EXPOSE 3000

# The standalone server entry point is generated by Next.js at build time.
CMD ["node", "apps/admin/server.js"]
