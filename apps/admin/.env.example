# Admin portal environment configuration
# Copy to .env.local and fill in your values.
# Never commit real values to version control.

# Backend API base URL
VITE_API_URL=http://localhost:4000

# =========================
# Firebase Authentication
# =========================
# Firebase project configuration for the admin web portal.
# Copy values from the Firebase console → Project settings → Your apps.
# Never commit real values — use .env.local for local development.
VITE_FIREBASE_API_KEY=replace-with-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-with-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=replace-with-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
VITE_FIREBASE_APP_ID=replace-with-app-id
