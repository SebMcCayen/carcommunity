# Admin portal environment configuration
# Copy to .env.local and fill in your values.
# Never commit real values to version control.

# =========================
# Firebase (required)
# =========================
# Firebase project configuration for the admin web portal.
# Copy values from the Firebase console → Project settings → Your apps.
VITE_FIREBASE_API_KEY=replace-with-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-with-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=replace-with-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
VITE_FIREBASE_APP_ID=replace-with-app-id

# =========================
# App Check (production)
# =========================
# reCAPTCHA Enterprise site key; when unset, App Check is not initialized.
# See docs/app-check.md.
VITE_APPCHECK_SITE_KEY=
# Non-production builds only: App Check debug token for local testing.
VITE_APPCHECK_DEBUG_TOKEN=

# =========================
# Map location picker (optional)
# =========================
# Public Mapbox access token (pk.…) for the admin location picker. When set, the
# picker renders the Mapbox Standard style (mapbox://styles/mapbox/standard) —
# the SAME v3 style the member Android app uses — via Mapbox GL JS. When unset
# or empty, the picker degrades gracefully to manual latitude/longitude entry
# (no map, never a crash), so this is OPTIONAL and never blocks a build/deploy.
#
# pk. tokens are public-by-design (they ship in the client bundle); scope and
# referrer-restrict the token in the Mapbox account. Do NOT commit a real token.
# In production this is a GitHub Actions VARIABLE (not a secret): repo Settings →
# Environments → production → Variables → VITE_MAPBOX_TOKEN.
VITE_MAPBOX_TOKEN=

# =========================
# Local emulators (development only, ignored in production builds)
# =========================
# host:port of the Firestore emulator, e.g. 127.0.0.1:8080
VITE_FIRESTORE_EMULATOR_HOST=
# host:port of the Cloud Functions emulator, e.g. 127.0.0.1:5001
VITE_FUNCTIONS_EMULATOR_HOST=
