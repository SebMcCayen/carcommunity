# Admin portal environment configuration
# Copy to .env.local and fill in your values.
# Never commit real values to version control.

# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# Dev-only: x-dev-user header value for the backend dev auth mechanism.
# This is a JSON string matching the backend's dev auth context schema.
# Only used in non-production environments. Never set in production.
# Example:
#   NEXT_PUBLIC_DEV_AUTH_TOKEN={"userId":"replace-with-real-uuid","role":"admin","status":"active","subscriptionEntitlement":"none","sessionId":"dev-session"}
NEXT_PUBLIC_DEV_AUTH_TOKEN=
