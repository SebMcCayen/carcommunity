    "build": "expo export --platform android --platform ios --output-dir dist"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.8.1",
    "@react-navigation/native": "^7.1.19",
    "@react-navigation/native-stack": "^7.4.2",
    "expo": "~56.0.9",
    "expo-constants": "~18.0.8",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.7",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "~4.25.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^10.4.1",
    "eslint-config-expo": "~56.0.4",
    "jest": "^30.2.0",
    "jest-expo": "~56.0.4",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo"
  }
