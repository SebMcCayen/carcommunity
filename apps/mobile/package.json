{
  "name": "@carcommunity/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "build": "expo export --platform android --platform ios --output-dir dist"
  },
  "dependencies": {
    "@carcommunity/shared": "^0.1.0",
    "@react-native-google-signin/google-signin": "~16.1.2",
    "@react-navigation/bottom-tabs": "^7.18.3",
    "@react-navigation/native": "^7.1.19",
    "@react-navigation/native-stack": "^7.17.6",
    "@rnmapbox/maps": "^10.3.1",
    "expo": "~56.0.12",
    "expo-apple-authentication": "~56.0.4",
    "expo-constants": "~18.0.8",
    "expo-location": "~56.0.0",
    "expo-secure-store": "~56.0.0",
    "expo-status-bar": "~56.0.4",
    "expo-task-manager": "~56.0.0",
    "react": "19.2.7",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "~4.25.2"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.38.0",
    "eslint-config-expo": "~56.0.4",
    "jest": "^30.2.0",
    "jest-expo": "~56.0.5",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testEnvironment": "<rootDir>/jest-env.js",
    "moduleNameMapper": {
      "^@rnmapbox/maps$": "<rootDir>/__mocks__/@rnmapbox/maps.js",
      "^@react-native-google-signin/google-signin$": "<rootDir>/__mocks__/@react-native-google-signin/google-signin.js",
      "^expo-apple-authentication$": "<rootDir>/__mocks__/expo-apple-authentication.js",
      "^expo-location$": "<rootDir>/__mocks__/expo-location.js",
      "^expo-task-manager$": "<rootDir>/__mocks__/expo-task-manager.js",
      "^expo-secure-store$": "<rootDir>/__mocks__/expo-secure-store.js"
    }
  }
}
