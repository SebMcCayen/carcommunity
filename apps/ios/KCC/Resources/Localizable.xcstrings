    "onboarding.defaultMapBody": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När en annan app öppnar en kartplats – en delad pin eller en ”geo:”-länk – kan du låta KCC ta hand om den och navigera direkt här, utan att byta app. Android styr vilken app som öppnar dessa, så öppna appinställningarna för att göra KCC till ett alternativ och välj den (eller ange den som standard) när Android frågar. Valfritt – du kan hoppa över detta och ställa in det senare under Inställningar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When another app opens a map location — a shared pin or a “geo:” link — you can let KCC handle it and navigate right here, without switching apps. Android controls which app opens these, so open your app settings to make KCC an option, then pick it (or set it as the default) when Android asks. Optional — you can skip this and set it later under Settings."
          }
        }
      }
    },
