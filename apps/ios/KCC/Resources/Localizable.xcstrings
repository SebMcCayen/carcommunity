    "events.createPublicSiteHelp": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Eventet visas i eventlistan på kungsbackacarcommunity.se och får en publik eventsida som kan delas med icke-medlemmar. Endast titel, datum/tid, platsnamn och beskrivning visas — aldrig deltagare eller exakt adress. Du kan ångra dig senare."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The event appears in the event list on kungsbackacarcommunity.se and gets a public event page you can share with non-members. Only the title, date/time, place name and description are shown — never attendees or the exact address. You can change your mind later."
          }
        }
      }
