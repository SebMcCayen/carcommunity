    "batteryOptimization.body": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att din körning ska fortsätta spelas in när skärmen är av eller appen körs i bakgrunden, tillåt att appen körs utan batteribegränsningar. På Samsung-telefoner: ställ även in appens batterianvändning på \"Obegränsad\" (Inställningar › Batteri › Gränser för bakgrundsanvändning) så att den inte försätts i viloläge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To make sure a drive keeps recording when the screen is off or the app is in the background, allow it to run without battery limits. On Samsung phones, also set the app's battery usage to \"Unrestricted\" (Settings › Battery › Background usage limits) so it isn't put to sleep."
          }
        }
      }
    },
