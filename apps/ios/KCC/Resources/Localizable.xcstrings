    "welcome.step1Body": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är med! Här möts lokala bilentusiaster, kör och delar passionen. Här är en snabb rundtur innan du sätter igång."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're in! This is where local car enthusiasts meet, drive and share the passion. Here's a quick tour before you get started."
          }
        }
      }
    },
    "welcome.step1Title": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välkommen till gemenskapen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to the community"
          }
        }
      }
    },
    "welcome.step2Body": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utgå från kartan för att se vad som händer runt omkring dig, dela din liveposition med vänner och köra tillsammans i konvojer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start from the map to see what's happening around you, share your live location with friends, and roll out together in convoys."
          }
        }
      }
    },
    "welcome.step2Title": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartan är din utgångspunkt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The map is your home base"
          }
        }
      }
    },
    "welcome.step3Body": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett medlemskap ger dig tillgång till fler funktioner i appen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A membership gives you access to more features in the app."
          }
        }
      }
    },
    "welcome.step3Title": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås upp mer med medlemskap"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock more with membership"
          }
        }
      }
    },
    "welcome.step4Body": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slutför din profil så att andra känner igen dig, och lägg till din första bil i garaget."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish setting up your profile so others recognise you, and add your first car to your garage."
          }
        }
      }
    },
    "welcome.step4Title": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gör den till din"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make it yours"
          }
        }
      }
    },
