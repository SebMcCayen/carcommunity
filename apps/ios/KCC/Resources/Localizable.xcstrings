    "convoy.stopSessionLeaveEndsBody": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är med i en konvoj, men det finns ingen kvar att föra den vidare — att lämna avslutar den för alla. Sammanfattningen sparas."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're in a convoy, but there's no one left to carry it on — leaving ends it for everyone. The summary is saved."
          }
        }
      }
    },
    "convoy.stopSessionLeaveRunning": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låt den fortsätta"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave it running"
          }
        }
      }
    },
    "convoy.stopSessionMemberBody": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är med i en konvoj. Lämna den och avsluta din livedelning, eller fortsätt dela för att stanna kvar med gruppen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're in a convoy. Leave it and end your live session, or keep sharing to stay with the group."
          }
        }
      }
    },
    "convoy.stopSessionOwnerBody": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du leder en konvoj. Avsluta den för alla, eller lämna över den och låt den fortsätta för de andra. Oavsett vilket avslutas din livedelning."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're leading a convoy. End it for everyone, or hand it over and leave it running for the others. Either way your live session ends."
          }
        }
      }
    },
    "convoy.stopSessionOwnerEndOnlyBody": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du leder en konvoj, och det finns ingen kvar att lämna över den till — att avsluta din livedelning avslutar konvojen. Sammanfattningen sparas."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're leading a convoy, and there's no one left to hand it to — ending your live session ends the convoy. The summary is saved."
          }
        }
      }
    },
