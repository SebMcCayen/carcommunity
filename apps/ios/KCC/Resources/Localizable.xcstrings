    "crownHunt.emptyBody": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Samla kronor på kartan när du står stilla. Nya kronor dyker upp då och då – kika på kartan och håll utkik nästa gång du är ute och kör."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collect crowns on the map while you're stopped. New crowns appear now and then — check the map and keep an eye out next time you're out driving."
          }
        }
      }
    },
    "crownHunt.emptyHeadline": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga kronor i närheten just nu"
          }
        },
        "en": {
