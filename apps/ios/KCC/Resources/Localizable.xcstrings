    "auth.carQuote01": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Any customer can have a car painted any color that he wants so long as it is black.\" –Henry Ford"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Any customer can have a car painted any color that he wants so long as it is black.\" –Henry Ford"
          }
        }
      }
    },
    "auth.carQuote02": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Aerodynamics are for people who can't build engines.\" –Enzo Ferrari"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Aerodynamics are for people who can't build engines.\" –Enzo Ferrari"
          }
        }
      }
    },
    "auth.carQuote03": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\"I couldn't find the sports car of my dreams, so I built it myself.\" –Ferdinand Porsche"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"I couldn't find the sports car of my dreams, so I built it myself.\" –Ferdinand Porsche"
          }
        }
      }
