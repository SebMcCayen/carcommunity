    "portal.billboardExplanation": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Digitala billboards kan placeras längs trafikerade vägar eller andra platser där många bilar passerar. De visas i appens karta och länkar till er partnersida. Placering och logotyp granskas av CarCommunity."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Digital billboards can be placed along busy roads or other locations with passing cars. They appear on the app’s map and link to your partner page. CarCommunity reviews placement and logo."
          }
        }
      }
    },
