    "portal.logoRequirements": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekommenderat: 1024 × 1024 pixlar med luft runt logotypen. Bilden omvandlas till PNG, högst 5 MB och 16 megapixlar. Billboards granskas separat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommended: 1024 × 1024 pixels with clear space around the logo. The image is converted to PNG, up to 5 MB and 16 megapixels. Billboards are reviewed separately."
          }
        }
      }
    },
