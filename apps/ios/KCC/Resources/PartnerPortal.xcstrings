        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The draft is protected for your account on this device, can be restored for seven days and is excluded from backups. Old drafts are removed the next time this feature opens. The logo is not saved; select it again before submitting."
          }
        }
      }
    },
