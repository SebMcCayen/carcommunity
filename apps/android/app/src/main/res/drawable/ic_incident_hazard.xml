    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12.00,2.40 L22.60,20.80 L1.40,20.80 Z M11.00,9.00 L11.00,15.00 L13.00,15.00 L13.00,9.00 Z M11.00,16.50 L11.00,18.60 L13.00,18.60 L13.00,16.50 Z" />
</vector>
