<?xml version="1.0" encoding="utf-8"?>
<!--
  Crown glyph: FIVE_POINT — the RARE tier.

  Five points instead of three, each tipped with a ball, on a deeper band. The
  point COUNT is the cue that survives everything: it is legible in silhouette,
  at 32 dp, on a night basemap, and to a user with any colour-vision deficiency —
  which matters because this tier's indigo disc is the one closest in colour to
  the incidents layer's purple (see CrownMarkerStyle's "honest gap" note).

  Tinted at runtime (see CrownMarkerStyle.glyphColorArgb).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">
    <!-- Balls on the five tips. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M2.6,7.6m-1.4,0a1.4,1.4 0,1 1,2.8 0a1.4,1.4 0,1 1,-2.8 0Z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M7.3,5.4m-1.3,0a1.3,1.3 0,1 1,2.6 0a1.3,1.3 0,1 1,-2.6 0Z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M12,3.9m-1.6,0a1.6,1.6 0,1 1,3.2 0a1.6,1.6 0,1 1,-3.2 0Z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M16.7,5.4m-1.3,0a1.3,1.3 0,1 1,2.6 0a1.3,1.3 0,1 1,-2.6 0Z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M21.4,7.6m-1.4,0a1.4,1.4 0,1 1,2.8 0a1.4,1.4 0,1 1,-2.8 0Z" />
    <!-- The five-point body. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M2.6,8.6L5,12.4L7.3,6.5L9.7,11.6L12,5L14.3,11.6L16.7,6.5L19,12.4L21.4,8.6V16H2.6V8.6Z" />
    <!-- Band. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M2.6,17.4H21.4V20H2.6V17.4Z" />
</vector>
