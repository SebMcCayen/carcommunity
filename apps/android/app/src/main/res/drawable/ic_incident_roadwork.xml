<?xml version="1.0" encoding="utf-8"?>
<!--
  ROADWORK glyph: the standard European "men at work" figure — a person bent
  over a shovel, digging.

  This is the highest-volume category once the Trafikverket importer is feeding
  Swedish roadwork in, so it gets the most literal, most-recognised silhouette in
  the set. The human figure is unmistakable against the burst (accident),
  triangle (hazard), cap (police) and octagon (road closed).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Head. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M13.90,3.10 m-2.10,0 a2.10,2.10 0 1,0 4.20,0 a2.10,2.10 0 1,0 -4.20,0" />
    <!-- Hard hat brim. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M10.90,2.40 L16.90,2.40 L16.90,3.50 L10.90,3.50 Z" />
    <!-- Torso, bent forward over the work. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M14.60,5.60 L16.60,7.10 L11.90,12.20 L9.90,10.70 Z" />
    <!-- Back leg. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M15.80,10.20 L17.60,11.00 L16.10,19.40 L14.10,19.10 Z" />
    <!-- Front leg. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12.60,11.60 L14.40,12.60 L10.20,19.40 L8.40,18.40 Z" />
    <!-- Shovel shaft, running down to the blade. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M14.90,6.40 L15.90,7.40 L6.60,16.70 L5.60,15.70 Z" />
    <!-- Shovel blade in the ground. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M6.40,15.10 L8.20,16.90 L5.60,19.50 L3.80,17.70 Z" />
</vector>
