<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Live-location background sharing (Phase 12 slice 6). Runtime grant of the
         location + notification permissions is DEFERRED (no device available). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".KccApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KCC">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.KCC">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground service that streams GPS to live.updatePosition while a
             live-location session is active (Phase 12 slice 6). -->
        <service
            android:name=".location.LocationSharingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- FCM entry points: token rotation + message display (Phase 12
             slice 21, push portion). Only invoked by FCM, which requires
             google-services.json — inert in config-less CI builds. -->
        <service
            android:name=".push.KccMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
