<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Read-only connectivity check (normal permission, no runtime grant, no
         user-visible prompt). Used ONLY to suppress feature-health reports while
         the device is offline: a user in a tunnel or out of data cannot load map
         tiles, and filing a public GitHub issue for that would be a false
         positive. See diagnostics/NetworkStatus.kt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Live-location background sharing (Phase 12 slice 6). Runtime grant of the
         location + notification permissions is DEFERRED (no device available). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".KccApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KCC">

        <!-- Per-app language (AppCompat). android:localeConfig above lists the
             app's translated locales so Android 13+ shows a system "Language"
             screen for KCC; this service enables AppCompat's autoStoreLocales,
             which persists the in-app AppCompatDelegate.setApplicationLocales
             choice (Settings > Language) and re-applies it on every start,
             backporting the behaviour below Android 13 (minSdk 26). The service
             is a metadata holder only — enabled=false, exported=false; AppCompat
             reads its meta-data, it is never started. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Crashlytics data collection. Substituted per build type from
             app/build.gradle.kts: "true" for release, "false" for debug, so a
             developer's own crashes never pollute the production crash-free-users
             metric. Declaring it here — rather than only calling the runtime
             setter — is what covers a crash that happens BEFORE
             KccApplication#onCreate gets to run. KccApplication then sets the
             same value explicitly, from CrashTelemetryPolicy. -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="${crashlyticsCollectionEnabled}" />

        <!-- FCM display defaults: branded white-crown small icon (Android tints
             it) + Crown Gold accent. Consulted by messages that omit an explicit
             icon; the in-app builder (KccMessagingService) sets the same
             drawable. Inert without google-services.json. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/kcc_crown_gold" />

        <!-- windowSoftInputMode=adjustResize is REQUIRED, not cosmetic. Left
             unset, the window defaults to SOFT_INPUT_ADJUST_UNSPECIFIED and the
             framework is free to resolve it to legacy ADJUST_PAN — which it does
             on a window whose content draws behind the system bars. Pan moves the
             WHOLE window up by the keyboard height, and the chat composer ALSO
             pads itself by WindowInsets.ime, so the input travelled twice the
             keyboard's height and parked itself in the middle of the screen (and
             the message list scrolled off the top with it).

             Declaring adjustResize does not reinstate legacy resizing here:
             enableEdgeToEdge() sets decorFitsSystemWindows=false, under which the
             platform stops resizing/panning for the IME altogether and dispatches
             it purely as a WindowInsets.ime inset. The declaration's whole job is
             to take PAN off the table, leaving the app's own imePadding as the
             single thing that moves the composer. -->
        <!-- launchMode="singleTop": tapping a push reuses the running task and
             delivers the deep-link extras to onNewIntent instead of stacking a
             second MainActivity on top of the member's current screen. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.KCC"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Map-link handler. Makes KCC appear in Android's "Open with"
                 chooser (and be selectable as the "Always"/default) for map
                 links other apps fire — a browser's "geo:" result, a shared
                 pin, a "navigate to" deep link. This is a plain scheme handler
                 chosen through the chooser: Android has NO OS-level "default
                 navigator" role, so there is no autoVerify here (that is only
                 for http(s) App Links) and no claim to be one. MainActivity
                 parses the incoming URI (GeoUriParser) and drives the app's own
                 in-app navigate-here flow — see MapLinkNavigator. singleTop +
                 exported are already declared above, so a link delivered to a
                 running task arrives in onNewIntent. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- RFC 5870 map points ("geo:lat,lng"). -->
                <data android:scheme="geo" />
                <!-- The turn-by-turn deep link some apps emit. -->
                <data android:scheme="google.navigation" />
            </intent-filter>
        </activity>

        <!-- Foreground service that streams GPS to live.updatePosition while a
             live-location session is active (Phase 12 slice 6). -->
        <service
            android:name=".location.LocationSharingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- FCM entry points: token rotation + message display (Phase 12
             slice 21, push portion). Only invoked by FCM, which requires
             google-services.json — inert in config-less CI builds. -->
        <service
            android:name=".push.KccMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
