<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/debug_network_security">
        <!-- The Compose test host must declare the production Activity's initial
             keyboard policy before its window attaches. Setting this later can
             leave Android's legacy pan offset active beside Compose IME insets. -->
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:windowSoftInputMode="adjustResize" />
        <!-- System-bar acceptance needs the same pre-attachment setup as MainActivity. -->
        <activity
            android:name="com.kungsbackacarcommunity.app.design.SystemBarsTestActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
