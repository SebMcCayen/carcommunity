# =========================
# General app settings
# =========================
NODE_ENV=development
APP_NAME=replace-with-app-name
APP_PORT=3000
LOG_LEVEL=info

# =========================
# API
# =========================
API_BASE_URL=http://localhost:4000
API_REQUEST_TIMEOUT_MS=10000
# Random shared secret used for trusted internal service-to-service API calls
API_INTERNAL_TOKEN=replace-with-internal-token

# =========================
# Database
# =========================
DATABASE_URL=db-url-placeholder
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# =========================
# Mobile app public config
# =========================
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
EXPO_PUBLIC_SENTRY_DSN=https://replace-with-sentry-dsn

# =========================
# Mapbox
# =========================
# Keep separate values when server and mobile app should use different token scopes
MAPBOX_ACCESS_TOKEN=pk.test.mapbox-placeholder-token
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.test.mapbox-placeholder-token

# =========================
# Apple login
# =========================
APPLE_CLIENT_ID=com.example.placeholder
APPLE_TEAM_ID=replace-with-apple-team-id
APPLE_KEY_ID=replace-with-apple-key-id
APPLE_PRIVATE_KEY_BASE64=base64-encoded-private-key-placeholder

# =========================
# Google login
# =========================
GOOGLE_CLIENT_ID=google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=google-client-secret-placeholder
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=google-web-client-id.apps.googleusercontent.com

# =========================
# GitHub integration
# =========================
# Backend service only (do not expose in mobile/web public builds)
GITHUB_APP_ID=replace-with-github-app-id
GITHUB_APP_CLIENT_ID=github-app-client-id-placeholder
GITHUB_APP_CLIENT_SECRET=github-app-client-secret-placeholder
GITHUB_WEBHOOK_SECRET=github-webhook-secret-placeholder

# =========================
# Feature flags
# =========================
FEATURE_ENABLE_BETA=false
FEATURE_ENABLE_SOCIAL_LOGIN=true
FEATURE_ENABLE_MAPS=true