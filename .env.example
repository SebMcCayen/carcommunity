# =========================
# General app settings
# =========================
NODE_ENV=development
APP_NAME=replace-with-app-name
APP_PORT=3000
API_PORT=4000
LOG_LEVEL=info

# =========================
# API
# =========================
API_BASE_URL=http://localhost:4000
API_REQUEST_TIMEOUT_MS=10000
# Random shared secret used for trusted internal service-to-service API calls
API_INTERNAL_TOKEN=replace-with-internal-token

# =========================
# Database
# =========================
DATABASE_URL=db-url-placeholder
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# =========================
# Mobile app public config
# =========================
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
EXPO_PUBLIC_SENTRY_DSN=https://replace-with-sentry-dsn

# Auth mode: 'dev' uses placeholder login; 'native' enables real Apple/Google SDKs.
# Set to 'native' in production builds.
EXPO_PUBLIC_AUTH_MODE=dev

# =========================
# Google Sign-In (Android / iOS via Google)
# =========================
# Client IDs from Google Cloud Console — do NOT commit real values.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID must be the OAuth Web application client ID
# used for issuing/verifying Google ID tokens.
# TODO (production): Set these in EAS Secrets / your CI environment.
# TODO (production): Verify SHA fingerprints and package name in Google Cloud Console.
# TODO (production): Validate audience (aud) server-side for each client ID.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=replace-with-google-ios-client-id
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=replace-with-google-android-client-id
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=replace-with-google-web-client-id

# =========================
# Mapbox
# =========================
# Keep separate values when server and mobile app should use different token scopes
MAPBOX_ACCESS_TOKEN=pk.test.mapbox-placeholder-token
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.test.mapbox-placeholder-token

# =========================
# Mobile auth provider verification
# =========================
AUTH_VERIFICATION_MODE=placeholder
AUTH_APPLE_ALLOWED_AUDIENCES=replace-with-apple-audience
AUTH_APPLE_BUNDLE_ID=replace-with-apple-bundle-id
AUTH_APPLE_SERVICE_ID=replace-with-apple-service-id

# =========================
# Google login audience placeholders
# =========================
AUTH_GOOGLE_ALLOWED_CLIENT_IDS=replace-with-google-client-id

# =========================
# GitHub integration
# =========================
# Backend service only (do not expose in mobile/web public builds)
GITHUB_APP_ID=replace-with-github-app-id
GITHUB_APP_CLIENT_ID=github-app-client-id-placeholder
GITHUB_APP_CLIENT_SECRET=github-app-client-secret-placeholder
GITHUB_WEBHOOK_SECRET=github-webhook-secret-placeholder

# =========================
# Feature flags
# =========================
FEATURE_ENABLE_BETA=false
FEATURE_ENABLE_SOCIAL_LOGIN=true
FEATURE_ENABLE_MAPS=true

# =========================
# Badge system
# =========================
# ISO 8601 date (YYYY-MM-DD) for the early_member badge cutoff.
# Users whose accounts were created before this date receive the badge.
# Leave blank (or unset) until the cutoff date is officially decided.
# Safe default: not configured = badge not awarded in production.
# Example: EARLY_MEMBER_CUTOFF_DATE=2026-07-01
EARLY_MEMBER_CUTOFF_DATE=
# ---------------------------------------------------------------------------
# Push notification token encryption
# ---------------------------------------------------------------------------
# Required in production. Must be a high-entropy secret (>= 32 chars).
# TODO: Replace with Azure Key Vault in production instead of env var.
# Leave blank in development (falls back to a safe dev placeholder).
PUSH_TOKEN_ENCRYPTION_KEY=
