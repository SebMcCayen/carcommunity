{
  "name": "@carcommunity/functions",
  "version": "0.1.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:emulator": "vitest run --config vitest.emulator.config.ts",
    "emulators:start": "firebase emulators:start --config ../firebase.json",
    "emulators:test": "pnpm build && node scripts/run-emulator-tests.mjs",
    "backfill:display-name-lower": "node scripts/backfill-display-name-lower.mjs",
    "backfill:block-visibility": "node scripts/backfill-block-visibility.mjs",
    "backfill:partner-stats-optin": "node scripts/backfill-partner-stats-optin.mjs",
    "set-first-admin": "node scripts/set-first-admin.mjs",
    "lockfile:check": "node scripts/deploy-lockfile.mjs check",
    "lockfile:sync": "node scripts/deploy-lockfile.mjs sync"
  },
  "overrides": {
    "uuid@<11.1.1": "^11.1.1",
    "@opentelemetry/core@<2.8.0": "^2.8.0",
    "fast-xml-parser@<5.10.1": "^5.10.1"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^7.3.2",
    "google-auth-library": "^10.9.1",
    "h3-js": "^4.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.1",
    "firebase": "^12.18.0",
    "firebase-tools": "^15.28.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
