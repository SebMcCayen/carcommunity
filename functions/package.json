{
  "name": "@carcommunity/functions",
  "version": "0.1.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:emulator": "vitest run --config vitest.emulator.config.ts",
    "emulators:start": "firebase emulators:start --config ../firebase.json",
    "emulators:test": "pnpm build && firebase emulators:exec --only auth,functions,firestore,database,storage --project demo-test --config ../firebase.json 'pnpm test:emulator'",
    "backfill:display-name-lower": "node scripts/backfill-display-name-lower.mjs",
    "set-first-admin": "node scripts/set-first-admin.mjs",
    "lockfile:check": "node scripts/deploy-lockfile.mjs check",
    "lockfile:sync": "node scripts/deploy-lockfile.mjs sync"
  },
  "overrides": {
    "uuid@<11.1.1": "^11.1.1",
    "@opentelemetry/core@<2.8.0": "^2.8.0"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^7.2.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.6.0",
    "firebase": "^12.16.0",
    "firebase-tools": "^15.23.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
