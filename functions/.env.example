# Optional finance evidence integration. Copy entries to the git-ignored .env
# only during an intentional backend release. No keys or secrets belong here.
FINANCE_MONITORING_ENABLED=false
# Fully qualified standard Cloud Billing export table; empty disables import.
FINANCE_BILLING_TABLE=
# Must match the export dataset location.
FINANCE_BILLING_LOCATION=EU
# Optional dedicated runtime service account email (selected at deployment).
FINANCE_CAPTURE_SERVICE_ACCOUNT=
