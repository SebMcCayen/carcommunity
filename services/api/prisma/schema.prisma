generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id           String               @id @default(uuid()) @db.Uuid
  name         String               @db.VarChar(200)
  shortName    String               @map("short_name") @db.VarChar(50)
  slug         String               @unique @db.VarChar(100)
  brandConfig  Json?                @map("brand_config")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  deletedAt    DateTime?            @map("deleted_at")
  featureFlags FeatureFlag[]
  members      OrganizationMember[]

  @@index([deletedAt])
  @@map("organizations")
}

model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  displayName                String?                  @map("display_name") @db.VarChar(120)
  email                      String?                  @db.VarChar(320)
  role                       UserRole                 @default(user)
  status                     UserStatus               @default(active)
  subscriptionEntitlement    SubscriptionEntitlement  @default(none) @map("subscription_entitlement")
  onboardingCompletedAt      DateTime?                @map("onboarding_completed_at")
  ageConfirmedAt             DateTime?                @map("age_confirmed_at")
  termsAcceptedAt            DateTime?                @map("terms_accepted_at")
  privacyPolicyAcceptedAt    DateTime?                @map("privacy_policy_accepted_at")
  anonymousPartnerStatsOptIn Boolean                  @default(false) @map("anonymous_partner_stats_opt_in")
  lastActiveAt               DateTime?                @map("last_active_at")
  createdAt                  DateTime                 @default(now()) @map("created_at")
  updatedAt                  DateTime                 @updatedAt @map("updated_at")
  deletedAt                  DateTime?                @map("deleted_at")
  identities              UserIdentity[]
  memberships             OrganizationMember[]
  sessions                Session[]
  liveLocationSessions    LiveLocationSession[]
  liveLocationPositions   LiveLocationLatestPosition[]
  moderationActionsTarget ModerationAction[]       @relation("ModerationTargetUser")
  moderationActionsActor  ModerationAction[]       @relation("ModerationActorUser")
  auditLogsActor          AuditLog[]               @relation("AuditActorUser")
  eventRsvps              EventRsvp[]
  subscriptionRecords     SubscriptionRecord[]
  diagnosticsReports      DiagnosticsReport[]
  blocksInitiated         UserBlock[]              @relation("BlockerUser")
  blocksReceived          UserBlock[]              @relation("BlockedUser")
  chatMessages            EventChatMessage[]       @relation("ChatMessageAuthor")
  chatMessagesRemoved     EventChatMessage[]       @relation("ChatMessageRemovedBy")
  chatMessageReports      EventChatMessageReport[] @relation("ChatReportReporter")
  chatReportsReviewed     EventChatMessageReport[] @relation("ChatReportReviewedBy")

  @@index([deletedAt])
  @@index([status])
  @@index([subscriptionEntitlement])
  @@map("users")
}

model UserIdentity {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  provider        IdentityProvider
  providerSubject String           @map("provider_subject") @db.VarChar(255)
  providerEmail   String?          @map("provider_email") @db.VarChar(320)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@index([providerEmail])
  @@map("user_identities")
}

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole @default(user)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

model FeatureFlag {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  key            String       @db.VarChar(100)
  name           String       @db.VarChar(150)
  description    String?      @db.Text
  enabled        Boolean      @default(false)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("feature_flags")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

model LiveLocationSession {
  id            String                    @id @default(uuid()) @db.Uuid
  userId        String                    @map("user_id") @db.Uuid
  status        LiveLocationSessionStatus @default(active)
  startedAt     DateTime                  @map("started_at")
  expiresAt     DateTime                  @map("expires_at")
  stoppedAt     DateTime?                 @map("stopped_at")
  createdAt     DateTime                  @default(now()) @map("created_at")
  updatedAt     DateTime                  @updatedAt @map("updated_at")
  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  latestPosition LiveLocationLatestPosition?

  @@index([userId, status])
  @@index([status, expiresAt])
  @@index([expiresAt])
  @@map("live_location_sessions")
}

model LiveLocationLatestPosition {
  id                  String              @id @default(uuid()) @db.Uuid
  sessionId           String              @unique @map("session_id") @db.Uuid
  userId              String              @map("user_id") @db.Uuid
  latitude            Float               @db.DoublePrecision
  longitude           Float               @db.DoublePrecision
  accuracyMeters      Float?              @map("accuracy_meters") @db.DoublePrecision
  headingDegrees      Float?              @map("heading_degrees") @db.DoublePrecision
  speedMetersPerSecond Float?             @map("speed_meters_per_second") @db.DoublePrecision
  recordedAt          DateTime            @map("recorded_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  session             LiveLocationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([recordedAt])
  @@map("live_location_latest_positions")
}

model ModerationAction {
  id           String               @id @default(uuid()) @db.Uuid
  targetUserId String               @map("target_user_id") @db.Uuid
  actorUserId  String?              @map("actor_user_id") @db.Uuid
  actionType   ModerationActionType @map("action_type")
  reason       String               @db.Text
  createdAt    DateTime             @default(now()) @map("created_at")
  expiresAt    DateTime?            @map("expires_at")
  metadata     Json?
  targetUser   User                 @relation("ModerationTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  actorUser    User?                @relation("ModerationActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([targetUserId])
  @@index([actorUserId])
  @@index([actionType])
  @@index([createdAt])
  @@map("moderation_actions")
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  actorUserId String?   @map("actor_user_id") @db.Uuid
  action      String    @db.VarChar(120)
  entityType  String    @map("entity_type") @db.VarChar(120)
  entityId    String?   @map("entity_id") @db.Uuid
  reason      String?   @db.Text
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  actorUser   User?     @relation("AuditActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

enum IdentityProvider {
  apple
  google
}

enum UserRole {
  user
  admin
  owner
}

enum UserStatus {
  active
  warned
  temporarily_suspended
  permanently_suspended
  deleted
}

enum SubscriptionEntitlement {
  none
  member_monthly
}

enum LiveLocationSessionStatus {
  active
  stopped
  expired
}

enum ModerationActionType {
  warning
  temporary_suspension
  permanent_suspension
  restriction
  restore_access
}

enum OrganizationRole {
  owner
  admin
  user
  moderator
  event_manager
  partner_manager
  support
}

// ---------------------------------------------------------------------------
// Diagnostics
// ---------------------------------------------------------------------------

enum DiagnosticsSeverity {
  info
  warning
  error
  critical
}

enum DiagnosticsPlatform {
  ios
  android
  web
  unknown
}

enum DiagnosticsFeatureArea {
  auth
  live_location
  events
  subscription
  admin
  map
  network
  unknown
}

/// Stores sanitized crash/error reports from the app.
/// No raw tokens, credentials, exact coordinates, routes, or personal messages.
model DiagnosticsReport {
  id          String                 @id @default(uuid()) @db.Uuid
  /// Optional — associated with the authenticated user who submitted the report.
  userId      String?                @map("user_id") @db.Uuid
  user        User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  platform    DiagnosticsPlatform
  featureArea DiagnosticsFeatureArea @map("feature_area")
  appVersion  String?                @map("app_version") @db.VarChar(50)
  buildNumber String?                @map("build_number") @db.VarChar(50)
  osVersion   String?                @map("os_version") @db.VarChar(100)
  severity    DiagnosticsSeverity    @default(info)
  errorCode   String?                @map("error_code") @db.VarChar(100)
  /// Human-readable, privacy-safe message. Max 2000 chars enforced at route layer.
  safeMessage String                 @map("safe_message") @db.VarChar(2000)
  /// Optional deduplication fingerprint for future grouping.
  fingerprint String?                @db.VarChar(128)
  /// Sanitized structured metadata. No tokens, credentials, or exact coordinates.
  metadata    Json?
  createdAt   DateTime               @default(now()) @map("created_at")

  @@index([severity])
  @@index([platform])
  @@index([featureArea])
  @@index([createdAt])
  @@index([fingerprint])
  @@map("diagnostics_reports")
}

model Event {
  id              String      @id @default(uuid()) @db.Uuid
  title           String      @db.VarChar(200)
  summary         String?     @db.Text
  description     String?     @db.Text
  status          EventStatus @default(draft)
  startsAt        DateTime    @map("starts_at")
  endsAt          DateTime?   @map("ends_at")
  approximateArea String      @map("approximate_area") @db.VarChar(200)
  locationName    String?     @map("location_name") @db.VarChar(200)
  address         String?     @db.VarChar(400)
  latitude        Float?      @db.DoublePrecision
  longitude       Float?      @db.DoublePrecision
  isOfficial      Boolean     @default(false) @map("is_official")
  createdByUserId String?     @map("created_by_user_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  cancelledAt     DateTime?   @map("cancelled_at")
  rsvps           EventRsvp[]
  chatMessages    EventChatMessage[]

  @@index([status])
  @@index([startsAt])
  @@index([isOfficial])
  @@map("events")
}

model EventRsvp {
  id        String          @id @default(uuid()) @db.Uuid
  eventId   String          @map("event_id") @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  status    EventRsvpStatus
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_rsvps")
}

enum EventStatus {
  draft
  published
  cancelled
  completed
}

enum EventRsvpStatus {
  going
  maybe
  not_going
}

enum SubscriptionPlatform {
  apple
  google
  manual
}

enum SubscriptionRecordStatus {
  inactive
  active
  grace_period
  expired
  revoked
  cancelled
}

// ---------------------------------------------------------------------------
// User Blocking
// ---------------------------------------------------------------------------

/**
 * Records a blocking relationship created by one user against another.
 *
 * Safe-delete behaviour: on-delete Cascade for both sides — when a user is
 * hard-deleted, all blocks they created or received are removed with them.
 * This prevents orphaned block records and avoids leaking that a deleted user
 * ever existed.
 *
 * Self-blocking is prevented at the service layer, not the database layer.
 *
 * TODO: Enforce the same blocking relationship for:
 *   - event chat
 *   - group driving interactions
 *   - mentions
 *   - private interactions if ever introduced
 *   - partner/community interaction features where relevant
 */
model UserBlock {
  id            String   @id @default(uuid()) @db.Uuid
  blockerUserId String   @map("blocker_user_id") @db.Uuid
  blockedUserId String   @map("blocked_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  blocker       User     @relation("BlockerUser", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blocked       User     @relation("BlockedUser", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockerUserId, blockedUserId])
  @@index([blockerUserId])
  @@index([blockedUserId])
  @@map("user_blocks")
}

model SubscriptionRecord {
  id                            String                   @id @default(uuid()) @db.Uuid
  userId                        String                   @map("user_id") @db.Uuid
  platform                      SubscriptionPlatform
  status                        SubscriptionRecordStatus @default(inactive)
  entitlement                   SubscriptionEntitlement  @default(none)
  externalProductId             String?                  @map("external_product_id") @db.VarChar(255)
  externalOriginalTransactionId String?                  @map("external_original_transaction_id") @db.VarChar(255)
  /// Hashed purchase token only — never store raw tokens.
  externalPurchaseTokenHash     String?                  @map("external_purchase_token_hash") @db.VarChar(128)
  startsAt                      DateTime?                @map("starts_at")
  expiresAt                     DateTime?                @map("expires_at")
  revokedAt                     DateTime?                @map("revoked_at")
  createdAt                     DateTime                 @default(now()) @map("created_at")
  updatedAt                     DateTime                 @updatedAt @map("updated_at")
  metadata                      Json?
  user                          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([status])
  @@index([entitlement])
  @@index([expiresAt])
  @@map("subscription_records")
}

// ---------------------------------------------------------------------------
// Event Chat
// ---------------------------------------------------------------------------

enum ChatMessageReportReason {
  harassment
  hate_or_abuse
  spam
  unsafe_driving
  privacy
  other
}

enum ChatMessageReportStatus {
  new
  under_review
  resolved
  dismissed
}

/**
 * A single text message posted to an event's chat.
 *
 * Soft-delete behaviour: messages are never hard-deleted. Moderated messages
 * have removedAt set and return a neutral placeholder to clients. The original
 * text is preserved for audit purposes and accessible to admin only.
 *
 * Blocking: filtering of blocked-user messages is done at the query layer;
 * no block data is stored on the message itself.
 */
model EventChatMessage {
  id              String    @id @default(uuid()) @db.Uuid
  eventId         String    @map("event_id") @db.Uuid
  authorUserId    String    @map("author_user_id") @db.Uuid
  /// Plain text only — never rendered as HTML. Max 1000 chars enforced at route layer.
  message         String    @db.VarChar(1000)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  removedAt       DateTime? @map("removed_at")
  removedByUserId String?   @map("removed_by_user_id") @db.Uuid
  removalReason   String?   @map("removal_reason") @db.Text
  event           Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  author          User      @relation("ChatMessageAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  removedBy       User?     @relation("ChatMessageRemovedBy", fields: [removedByUserId], references: [id], onDelete: SetNull)
  reports         EventChatMessageReport[]

  @@index([eventId, createdAt])
  @@index([authorUserId])
  @@index([removedAt])
  @@map("event_chat_messages")
}

/**
 * A report filed by a member against a specific chat message.
 *
 * Unique constraint prevents the same user from filing the same reason twice
 * for the same message. Additional reasons are still permitted.
 *
 * Reports are never hard-deleted to preserve moderation evidence.
 */
model EventChatMessageReport {
  id               String                  @id @default(uuid()) @db.Uuid
  messageId        String                  @map("message_id") @db.Uuid
  reporterUserId   String                  @map("reporter_user_id") @db.Uuid
  reason           ChatMessageReportReason
  /// Optional reporter-supplied context. Max 500 chars enforced at route layer.
  details          String?                 @db.VarChar(500)
  status           ChatMessageReportStatus @default(new)
  createdAt        DateTime                @default(now()) @map("created_at")
  reviewedAt       DateTime?               @map("reviewed_at")
  reviewedByUserId String?                 @map("reviewed_by_user_id") @db.Uuid
  message          EventChatMessage        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter         User                    @relation("ChatReportReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)
  reviewedBy       User?                   @relation("ChatReportReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([messageId, reporterUserId, reason])
  @@index([messageId])
  @@index([reporterUserId])
  @@index([status])
  @@map("event_chat_message_reports")
}
