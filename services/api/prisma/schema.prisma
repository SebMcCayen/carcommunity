generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id           String               @id @default(uuid()) @db.Uuid
  name         String               @db.VarChar(200)
  shortName    String               @map("short_name") @db.VarChar(50)
  slug         String               @unique @db.VarChar(100)
  brandConfig  Json?                @map("brand_config")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  deletedAt    DateTime?            @map("deleted_at")
  featureFlags FeatureFlag[]
  members      OrganizationMember[]

  @@index([deletedAt])
  @@map("organizations")
}

model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  displayName                String?                  @map("display_name") @db.VarChar(120)
  email                      String?                  @db.VarChar(320)
  role                       UserRole                 @default(user)
  status                     UserStatus               @default(active)
  subscriptionEntitlement    SubscriptionEntitlement  @default(none) @map("subscription_entitlement")
  onboardingCompletedAt      DateTime?                @map("onboarding_completed_at")
  ageConfirmedAt             DateTime?                @map("age_confirmed_at")
  termsAcceptedAt            DateTime?                @map("terms_accepted_at")
  privacyPolicyAcceptedAt    DateTime?                @map("privacy_policy_accepted_at")
  anonymousPartnerStatsOptIn Boolean                  @default(false) @map("anonymous_partner_stats_opt_in")
  lastActiveAt               DateTime?                @map("last_active_at")
  createdAt                  DateTime                 @default(now()) @map("created_at")
  updatedAt                  DateTime                 @updatedAt @map("updated_at")
  deletedAt                  DateTime?                @map("deleted_at")
  identities              UserIdentity[]
  memberships             OrganizationMember[]
  sessions                Session[]
  liveLocationSessions    LiveLocationSession[]
  liveLocationPositions   LiveLocationLatestPosition[]
  moderationActionsTarget ModerationAction[]       @relation("ModerationTargetUser")
  moderationActionsActor  ModerationAction[]       @relation("ModerationActorUser")
  auditLogsActor          AuditLog[]               @relation("AuditActorUser")
  eventRsvps              EventRsvp[]
  subscriptionRecords     SubscriptionRecord[]
  diagnosticsReports      DiagnosticsReport[]
  blocksInitiated         UserBlock[]              @relation("BlockerUser")
  blocksReceived          UserBlock[]              @relation("BlockedUser")
  chatMessages            EventChatMessage[]       @relation("ChatMessageAuthor")
  chatMessagesRemoved     EventChatMessage[]       @relation("ChatMessageRemovedBy")
  chatMessageReports      EventChatMessageReport[] @relation("ChatReportReporter")
  chatReportsReviewed     EventChatMessageReport[] @relation("ChatReportReviewedBy")
  groupDriveParticipations EventGroupDriveParticipant[]
  savedDrives             SavedDrive[]
  vehicles                Vehicle[]
  badges                  UserBadge[]
  badgesAwarded           UserBadge[]              @relation("BadgeAwardedBy")
  pointsLedgerEntries     PointsLedgerEntry[]
  pointsLedgerEntriesCreated PointsLedgerEntry[]   @relation("PointsEntryCreatedBy")
  crownHuntClaims         CrownHuntClaim[]         @relation("CrownHuntClaimUser")
  crownHuntPointsCreated  CrownHuntPoint[]         @relation("CrownHuntPointCreatedBy")
  crownHuntPointsApproved CrownHuntPoint[]         @relation("CrownHuntPointApprovedBy")
  partnerApplicationsSubmitted PartnerApplication[] @relation("PartnerApplicationSubmittedBy")
  partnerApplicationsReviewed  PartnerApplication[] @relation("PartnerApplicationReviewedBy")
  partnerCompaniesCreated      PartnerCompany[]     @relation("PartnerCompanyCreatedBy")
  partnerCompaniesUpdated      PartnerCompany[]     @relation("PartnerCompanyUpdatedBy")
  partnerOffersCreated         PartnerOffer[]        @relation("PartnerOfferCreatedBy")
  partnerOffersUpdated         PartnerOffer[]        @relation("PartnerOfferUpdatedBy")
  savedPartnerOffers           SavedPartnerOffer[]
  billboardsApproved      SponsoredBillboard[]     @relation("BillboardApprovedBy")
  billboardsCreated       SponsoredBillboard[]     @relation("BillboardCreatedBy")
  billboardsUpdated       SponsoredBillboard[]     @relation("BillboardUpdatedBy")
  pushDeviceRegistrations PushDeviceRegistration[]
  notificationPreferences NotificationPreference[]
  notifications           UserNotification[]

  @@index([deletedAt])
  @@index([status])
  @@index([subscriptionEntitlement])
  @@map("users")
}

model UserIdentity {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  provider        IdentityProvider
  providerSubject String           @map("provider_subject") @db.VarChar(255)
  providerEmail   String?          @map("provider_email") @db.VarChar(320)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@index([providerEmail])
  @@map("user_identities")
}

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole @default(user)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

model FeatureFlag {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  key            String       @db.VarChar(100)
  name           String       @db.VarChar(150)
  description    String?      @db.Text
  enabled        Boolean      @default(false)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("feature_flags")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

model LiveLocationSession {
  id            String                    @id @default(uuid()) @db.Uuid
  userId        String                    @map("user_id") @db.Uuid
  status        LiveLocationSessionStatus @default(active)
  startedAt     DateTime                  @map("started_at")
  expiresAt     DateTime                  @map("expires_at")
  stoppedAt     DateTime?                 @map("stopped_at")
  createdAt     DateTime                  @default(now()) @map("created_at")
  updatedAt     DateTime                  @updatedAt @map("updated_at")
  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  latestPosition LiveLocationLatestPosition?

  @@index([userId, status])
  @@index([status, expiresAt])
  @@index([expiresAt])
  @@map("live_location_sessions")
}

model LiveLocationLatestPosition {
  id                  String              @id @default(uuid()) @db.Uuid
  sessionId           String              @unique @map("session_id") @db.Uuid
  userId              String              @map("user_id") @db.Uuid
  latitude            Float               @db.DoublePrecision
  longitude           Float               @db.DoublePrecision
  accuracyMeters      Float?              @map("accuracy_meters") @db.DoublePrecision
  headingDegrees      Float?              @map("heading_degrees") @db.DoublePrecision
  speedMetersPerSecond Float?             @map("speed_meters_per_second") @db.DoublePrecision
  recordedAt          DateTime            @map("recorded_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  session             LiveLocationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([recordedAt])
  @@map("live_location_latest_positions")
}

model ModerationAction {
  id           String               @id @default(uuid()) @db.Uuid
  targetUserId String               @map("target_user_id") @db.Uuid
  actorUserId  String?              @map("actor_user_id") @db.Uuid
  actionType   ModerationActionType @map("action_type")
  reason       String               @db.Text
  createdAt    DateTime             @default(now()) @map("created_at")
  expiresAt    DateTime?            @map("expires_at")
  metadata     Json?
  targetUser   User                 @relation("ModerationTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  actorUser    User?                @relation("ModerationActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([targetUserId])
  @@index([actorUserId])
  @@index([actionType])
  @@index([createdAt])
  @@map("moderation_actions")
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  actorUserId String?   @map("actor_user_id") @db.Uuid
  action      String    @db.VarChar(120)
  entityType  String    @map("entity_type") @db.VarChar(120)
  entityId    String?   @map("entity_id") @db.Uuid
  reason      String?   @db.Text
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  actorUser   User?     @relation("AuditActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

enum IdentityProvider {
  apple
  google
}

enum UserRole {
  user
  admin
  owner
}

enum UserStatus {
  active
  warned
  temporarily_suspended
  permanently_suspended
  deleted
}

enum SubscriptionEntitlement {
  none
  member_monthly
}

enum LiveLocationSessionStatus {
  active
  stopped
  expired
}

enum ModerationActionType {
  warning
  temporary_suspension
  permanent_suspension
  restriction
  restore_access
}

enum OrganizationRole {
  owner
  admin
  user
  moderator
  event_manager
  partner_manager
  support
}

// ---------------------------------------------------------------------------
// Diagnostics
// ---------------------------------------------------------------------------

enum DiagnosticsSeverity {
  info
  warning
  error
  critical
}

enum DiagnosticsPlatform {
  ios
  android
  web
  unknown
}

enum DiagnosticsFeatureArea {
  auth
  live_location
  events
  subscription
  admin
  map
  network
  unknown
}

/// Stores sanitized crash/error reports from the app.
/// No raw tokens, credentials, exact coordinates, routes, or personal messages.
model DiagnosticsReport {
  id          String                 @id @default(uuid()) @db.Uuid
  /// Optional — associated with the authenticated user who submitted the report.
  userId      String?                @map("user_id") @db.Uuid
  user        User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  platform    DiagnosticsPlatform
  featureArea DiagnosticsFeatureArea @map("feature_area")
  appVersion  String?                @map("app_version") @db.VarChar(50)
  buildNumber String?                @map("build_number") @db.VarChar(50)
  osVersion   String?                @map("os_version") @db.VarChar(100)
  severity    DiagnosticsSeverity    @default(info)
  errorCode   String?                @map("error_code") @db.VarChar(100)
  /// Human-readable, privacy-safe message. Max 2000 chars enforced at route layer.
  safeMessage String                 @map("safe_message") @db.VarChar(2000)
  /// Optional deduplication fingerprint for future grouping.
  fingerprint String?                @db.VarChar(128)
  /// Sanitized structured metadata. No tokens, credentials, or exact coordinates.
  metadata    Json?
  createdAt   DateTime               @default(now()) @map("created_at")

  @@index([severity])
  @@index([platform])
  @@index([featureArea])
  @@index([createdAt])
  @@index([fingerprint])
  @@map("diagnostics_reports")
}

model Event {
  id              String      @id @default(uuid()) @db.Uuid
  title           String      @db.VarChar(200)
  summary         String?     @db.Text
  description     String?     @db.Text
  status          EventStatus @default(draft)
  startsAt        DateTime    @map("starts_at")
  endsAt          DateTime?   @map("ends_at")
  approximateArea String      @map("approximate_area") @db.VarChar(200)
  locationName    String?     @map("location_name") @db.VarChar(200)
  address         String?     @db.VarChar(400)
  latitude        Float?      @db.DoublePrecision
  longitude       Float?      @db.DoublePrecision
  isOfficial      Boolean     @default(false) @map("is_official")
  createdByUserId String?     @map("created_by_user_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  cancelledAt     DateTime?   @map("cancelled_at")
  rsvps           EventRsvp[]
  chatMessages    EventChatMessage[]
  groupDriveParticipants EventGroupDriveParticipant[]

  @@index([status])
  @@index([startsAt])
  @@index([isOfficial])
  @@map("events")
}

model EventRsvp {
  id        String          @id @default(uuid()) @db.Uuid
  eventId   String          @map("event_id") @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  status    EventRsvpStatus
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_rsvps")
}

enum EventStatus {
  draft
  published
  cancelled
  completed
}

enum EventRsvpStatus {
  going
  maybe
  not_going
}

// ---------------------------------------------------------------------------
// Group Drive
// ---------------------------------------------------------------------------

/**
 * Participation status for an event group drive.
 *
 * Transitions: joined → on_the_way → arrived
 * Any active status → left (via leave endpoint only)
 * left → joined (rejoin is allowed if event is still eligible)
 */
enum GroupDriveParticipantStatus {
  joined
  on_the_way
  arrived
  left
}

/**
 * Records a user's participation in an event group drive.
 *
 * Design decisions:
 *  - No location data stored here. Reuses LiveLocationLatestPosition.
 *  - No route tables or position history.
 *  - Rejoining is supported: a left participant can be reactivated via upsert.
 *  - Unique constraint on (eventId, userId) ensures one record per participant per event.
 *  - Soft-departure: leftAt is set rather than hard-deleting, for operational visibility.
 */
model EventGroupDriveParticipant {
  id        String                      @id @default(uuid()) @db.Uuid
  eventId   String                      @map("event_id") @db.Uuid
  userId    String                      @map("user_id") @db.Uuid
  status    GroupDriveParticipantStatus @default(joined)
  joinedAt  DateTime                    @map("joined_at")
  leftAt    DateTime?                   @map("left_at")
  createdAt DateTime                    @default(now()) @map("created_at")
  updatedAt DateTime                    @updatedAt @map("updated_at")
  event     Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([eventId, status])
  @@map("event_group_drive_participants")
}

enum SubscriptionPlatform {
  apple
  google
  manual
}

enum SubscriptionRecordStatus {
  inactive
  active
  grace_period
  expired
  revoked
  cancelled
}

// ---------------------------------------------------------------------------
// User Blocking
// ---------------------------------------------------------------------------

/**
 * Records a blocking relationship created by one user against another.
 *
 * Safe-delete behaviour: on-delete Cascade for both sides — when a user is
 * hard-deleted, all blocks they created or received are removed with them.
 * This prevents orphaned block records and avoids leaking that a deleted user
 * ever existed.
 *
 * Self-blocking is prevented at the service layer, not the database layer.
 *
 * TODO: Enforce the same blocking relationship for:
 *   - event chat
 *   - group driving interactions
 *   - mentions
 *   - private interactions if ever introduced
 *   - partner/community interaction features where relevant
 */
model UserBlock {
  id            String   @id @default(uuid()) @db.Uuid
  blockerUserId String   @map("blocker_user_id") @db.Uuid
  blockedUserId String   @map("blocked_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  blocker       User     @relation("BlockerUser", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blocked       User     @relation("BlockedUser", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockerUserId, blockedUserId])
  @@index([blockerUserId])
  @@index([blockedUserId])
  @@map("user_blocks")
}

model SubscriptionRecord {
  id                            String                   @id @default(uuid()) @db.Uuid
  userId                        String                   @map("user_id") @db.Uuid
  platform                      SubscriptionPlatform
  status                        SubscriptionRecordStatus @default(inactive)
  entitlement                   SubscriptionEntitlement  @default(none)
  externalProductId             String?                  @map("external_product_id") @db.VarChar(255)
  externalOriginalTransactionId String?                  @map("external_original_transaction_id") @db.VarChar(255)
  /// Hashed purchase token only — never store raw tokens.
  externalPurchaseTokenHash     String?                  @map("external_purchase_token_hash") @db.VarChar(128)
  startsAt                      DateTime?                @map("starts_at")
  expiresAt                     DateTime?                @map("expires_at")
  revokedAt                     DateTime?                @map("revoked_at")
  createdAt                     DateTime                 @default(now()) @map("created_at")
  updatedAt                     DateTime                 @updatedAt @map("updated_at")
  metadata                      Json?
  user                          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([status])
  @@index([entitlement])
  @@index([expiresAt])
  @@map("subscription_records")
}

// ---------------------------------------------------------------------------
// Event Chat
// ---------------------------------------------------------------------------

enum ChatMessageReportReason {
  harassment
  hate_or_abuse
  spam
  unsafe_driving
  privacy
  other
}

enum ChatMessageReportStatus {
  new
  under_review
  resolved
  dismissed
}

/**
 * A single text message posted to an event's chat.
 *
 * Soft-delete behaviour: messages are never hard-deleted. Moderated messages
 * have removedAt set and return a neutral placeholder to clients. The original
 * text is preserved for audit purposes and accessible to admin only.
 *
 * Blocking: filtering of blocked-user messages is done at the query layer;
 * no block data is stored on the message itself.
 */
model EventChatMessage {
  id              String    @id @default(uuid()) @db.Uuid
  eventId         String    @map("event_id") @db.Uuid
  authorUserId    String    @map("author_user_id") @db.Uuid
  /// Plain text only — never rendered as HTML. Max 1000 chars enforced at route layer.
  message         String    @db.VarChar(1000)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  removedAt       DateTime? @map("removed_at")
  removedByUserId String?   @map("removed_by_user_id") @db.Uuid
  removalReason   String?   @map("removal_reason") @db.Text
  event           Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  author          User      @relation("ChatMessageAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  removedBy       User?     @relation("ChatMessageRemovedBy", fields: [removedByUserId], references: [id], onDelete: SetNull)
  reports         EventChatMessageReport[]

  @@index([eventId, createdAt])
  @@index([authorUserId])
  @@index([removedAt])
  @@map("event_chat_messages")
}

/**
 * A report filed by a member against a specific chat message.
 *
 * Unique constraint prevents the same user from filing the same reason twice
 * for the same message. Additional reasons are still permitted.
 *
 * Reports are never hard-deleted to preserve moderation evidence.
 */
model EventChatMessageReport {
  id               String                  @id @default(uuid()) @db.Uuid
  messageId        String                  @map("message_id") @db.Uuid
  reporterUserId   String                  @map("reporter_user_id") @db.Uuid
  reason           ChatMessageReportReason
  /// Optional reporter-supplied context. Max 500 chars enforced at route layer.
  details          String?                 @db.VarChar(500)
  status           ChatMessageReportStatus @default(new)
  createdAt        DateTime                @default(now()) @map("created_at")
  reviewedAt       DateTime?               @map("reviewed_at")
  reviewedByUserId String?                 @map("reviewed_by_user_id") @db.Uuid
  message          EventChatMessage        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter         User                    @relation("ChatReportReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)
  reviewedBy       User?                   @relation("ChatReportReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([messageId, reporterUserId, reason])
  @@index([messageId])
  @@index([reporterUserId])
  @@index([status])
  @@map("event_chat_message_reports")
}

// ---------------------------------------------------------------------------
// Saved Drives
// ---------------------------------------------------------------------------

/**
 * A saved drive record created by explicit user action after a live location
 * session has stopped or expired.
 *
 * Privacy rules:
 *  - Belongs only to the authenticated user; no cross-user access.
 *  - No top-speed field — never stored or returned.
 *  - No speed rankings.
 *  - approximateStartArea and approximateEndArea are optional labels only;
 *    never exact addresses or GPS coordinates.
 *  - routeOverview is a minimized JSON path for members only.
 *    Raw temporary route points are never stored here.
 *  - sourceLiveLocationSessionId is opaque; never exposed as a way to
 *    reconstruct the original live session or its exact route.
 *
 * Summary-only MVP:
 *  distanceMeters, averageSpeedMetersPerSecond, and routeOverview are null
 *  until the TemporaryDrivePoint architecture is implemented.
 *  TODO: Populate these fields once TemporaryDrivePoint collection is safe.
 *
 * Cleanup:
 *  Hard deletion removes the drive and its associated routeOverview JSON.
 *  No soft-delete; drive removal is always final and privacy-preserving.
 */
model SavedDrive {
  id                         String    @id @default(uuid()) @db.Uuid
  userId                     String    @map("user_id") @db.Uuid
  /// Opaque reference to the source session; optional (session may have been deleted).
  sourceLiveLocationSessionId String?  @map("source_live_location_session_id") @db.Uuid
  startedAt                  DateTime  @map("started_at")
  endedAt                    DateTime  @map("ended_at")
  durationSeconds            Int       @map("duration_seconds")
  /// Null in summary-only mode. Populated when route buffer is implemented.
  distanceMeters             Float?    @map("distance_meters") @db.DoublePrecision
  /// Null in summary-only mode. Populated when route buffer is implemented.
  averageSpeedMetersPerSecond Float?   @map("average_speed_meters_per_second") @db.DoublePrecision
  /// Approximate area label only. Never an exact address or coordinate.
  approximateStartArea       String?   @map("approximate_start_area") @db.VarChar(200)
  /// Approximate area label only. Never an exact address or coordinate.
  approximateEndArea         String?   @map("approximate_end_area") @db.VarChar(200)
  /// Minimized route overview points for eligible members; null otherwise.
  /// Stored as JSON array of {latitude, longitude} only — no speed/heading/telemetry.
  /// Maximum array size enforced at service layer.
  /// TODO: Populate once TemporaryDrivePoint collection is implemented.
  routeOverview              Json?     @map("route_overview")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")
  user                       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceLiveLocationSessionId])
  @@index([userId, startedAt(sort: Desc)])
  @@index([createdAt])
  @@map("saved_drives")
}

// ---------------------------------------------------------------------------
// Garage
// ---------------------------------------------------------------------------

/**
 * Powertrain options for a vehicle profile.
 * Stored as a DB enum to constrain values at the database level.
 */
enum VehiclePowertrain {
  petrol
  diesel
  hybrid
  plug_in_hybrid
  electric
  other
}

/**
 * A private vehicle profile belonging to one user.
 *
 * Privacy rules:
 *  - No registration number, VIN, or insurance data — must never be added here.
 *  - No vehicle location data.
 *  - Vehicle profiles are private in the MVP; no public visibility flag yet.
 *  - Hard deletion is final and privacy-preserving.
 *
 * Access rules:
 *  - Only the owning user may read or modify their vehicles.
 *  - Backend enforces ownership and member_monthly entitlement.
 *  - Admin must not receive individual vehicle details (aggregate counts only).
 *
 * Future preparation:
 *  - TODO: Add optional public visibility flag when public profiles are introduced.
 *  - TODO: Add image/attachment relation once moderated upload is designed.
 *  - TODO: Add event participation junction once vehicle selection is supported.
 */
model Vehicle {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @map("user_id") @db.Uuid
  make              String            @db.VarChar(80)
  model             String            @db.VarChar(80)
  modelYear         Int               @map("model_year")
  powertrain        VehiclePowertrain
  engineDescription String?           @map("engine_description") @db.VarChar(120)
  description       String?           @db.VarChar(500)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("vehicles")
}

// ---------------------------------------------------------------------------
// Badges
// ---------------------------------------------------------------------------

/**
 * A badge awarded to a user.
 *
 * Design rules:
 *  - Each user receives each badge at most once (unique constraint on userId + badgeKey).
 *  - Badges are never automatically removed — not even on suspension or vehicle deletion.
 *  - awardedByUserId records the admin who manually awarded the badge, if applicable.
 *  - source distinguishes automatic awards from admin-manual ones.
 *  - metadata is minimal and must never contain personal data, tokens, or location.
 *  - No points, rankings, or competitive fields.
 *
 * Privacy rules:
 *  - Only the owning user may read their own badges via the user API.
 *  - Admins access aggregate counts only via the admin summary endpoint.
 *  - No public badge profiles in this step.
 */
model UserBadge {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  badgeKey        String    @map("badge_key") @db.VarChar(100)
  awardedAt       DateTime  @map("awarded_at")
  awardedByUserId String?   @map("awarded_by_user_id") @db.Uuid
  source          String?   @db.VarChar(50)
  metadata        Json?
  createdAt       DateTime  @default(now()) @map("created_at")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  awardedByUser   User?     @relation("BadgeAwardedBy", fields: [awardedByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, badgeKey])
  @@index([userId])
  @@index([badgeKey])
  @@index([awardedAt])
  @@map("user_badges")
}

// ---------------------------------------------------------------------------
// Kronpoäng (KP) Points Ledger
// ---------------------------------------------------------------------------

/**
 * Transaction type for a points ledger entry.
 *
 * - earn: awarded by the backend for completing an eligible activity.
 * - spend: deducted for a cosmetic or in-app use (not implemented in MVP).
 * - adjustment_credit: manual admin credit.
 * - adjustment_debit: manual admin debit.
 * - reversal: compensating entry that corrects a prior transaction.
 */
enum PointsTransactionType {
  earn
  spend
  adjustment_credit
  adjustment_debit
  reversal
}

/**
 * Source system or feature area that produced the ledger entry.
 *
 * `future_crown_hunt` is retained for backward-compatibility and must not be
 * used for new entries. Use `crown_hunt` for all Kronjakt awards.
 */
enum PointsTransactionSource {
  badge
  event
  garage
  admin_adjustment
  system
  crown_hunt
  future_crown_hunt
}

/**
 * Append-only ledger of all Kronpoäng transactions.
 *
 * Design rules:
 *  - Entries are never updated or deleted in normal application flows.
 *  - Corrections must use a new compensating entry (reversal or adjustment).
 *  - `amount` is a signed integer; positive = credit, negative = debit.
 *  - `balanceAfter` caches the running balance for display and audit purposes.
 *  - The authoritative balance is always computed from SUM(amount) inside a
 *    database transaction with serialization safeguards.
 *  - `idempotencyKey` prevents duplicate automated awards; unique where present.
 *  - `metadata` must be minimal and must not contain personal data or tokens.
 *
 * Balance architecture:
 *  - Balance is calculated as SUM(amount) from this table for the MVP.
 *  - Spend/debit operations use a PostgreSQL advisory lock inside a database
 *    transaction to prevent concurrent overdraft.
 *  - `balanceAfter` is stored for display and is set atomically with each entry.
 */
model PointsLedgerEntry {
  id                String               @id @default(uuid()) @db.Uuid
  userId            String               @map("user_id") @db.Uuid
  transactionType   PointsTransactionType @map("transaction_type")
  source            PointsTransactionSource
  /// Signed integer KP amount. Positive = credit, negative = debit.
  amount            Int
  /// Running balance after this entry was applied. Set atomically.
  balanceAfter      Int                  @map("balance_after")
  /// Swedish human-readable description. Safe for display to the user.
  description       String               @db.VarChar(500)
  /// Optional idempotency key for repeatable automated awards.
  /// Unique where present to prevent duplicate entries.
  idempotencyKey    String?              @unique @map("idempotency_key") @db.VarChar(200)
  /// Optional opaque entity type for traceability (e.g. "badge", "event").
  relatedEntityType String?              @map("related_entity_type") @db.VarChar(100)
  /// Optional opaque entity ID for traceability.
  relatedEntityId   String?              @map("related_entity_id") @db.Uuid
  /// Admin user who created this entry, if applicable.
  createdByUserId   String?              @map("created_by_user_id") @db.Uuid
  /// Minimal sanitized metadata. Must not contain personal data or tokens.
  metadata          Json?
  createdAt         DateTime             @default(now()) @map("created_at")

  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdByUser     User?                @relation("PointsEntryCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([source])
  @@map("points_ledger_entries")
}

// ---------------------------------------------------------------------------
// Kronjakt (Crown Hunt)
// ---------------------------------------------------------------------------

/**
 * Status of a Kronjakt point.
 *
 *  - draft:  Created by admin, not yet visible to users. Requires admin approval to activate.
 *  - active: Visible and claimable by eligible users.
 *  - paused: Temporarily hidden. No new claims allowed.
 *  - ended:  Permanently closed. Points are not hard-deleted.
 */
enum CrownHuntPointStatus {
  draft
  active
  paused
  ended
}

/**
 * How often a user may claim the same point.
 *
 *  - once:   The user may claim the point at most once, ever.
 *  - daily:  The user may claim the point once per calendar day.
 *  - weekly: The user may claim the point once per calendar week.
 */
enum CrownHuntRepeatRule {
  once
  daily
  weekly
}

/**
 * The authoritative result of a claim attempt.
 * Returned by the backend and stored on the claim record.
 */
enum CrownHuntClaimResult {
  awarded
  already_claimed
  outside_geofence
  moving_too_fast
  position_too_old
  point_inactive
  cooldown_active
  daily_limit_reached
  risk_review
  feature_disabled
  not_eligible
}

/**
 * A Kronjakt collection point.
 *
 * Design rules:
 *  - Only active admin-approved points may be claimed.
 *  - Points start in `draft` status. Activation requires admin safety confirmation.
 *  - Active and previously-claimed points must not be hard-deleted. Use paused/ended.
 *  - Points must only be placed at safe public stopping locations.
 *  - Points must not be placed on active road lanes, motorways, or intersections.
 *  - No first-to-arrive, speed-bonus, or route-history fields.
 *  - No public leaderboard fields.
 *
 * Privacy rules:
 *  - Internal fraud metadata is never exposed to mobile clients.
 *  - Other users' claim details are never returned.
 */
model CrownHuntPoint {
  id                    String                @id @default(uuid()) @db.Uuid
  title                 String                @db.VarChar(100)
  description           String?               @db.VarChar(500)
  latitude              Float                 @db.DoublePrecision
  longitude             Float                 @db.DoublePrecision
  geofenceRadiusMeters  Int                   @map("geofence_radius_meters")
  rewardPoints          Int                   @map("reward_points")
  status                CrownHuntPointStatus  @default(draft)
  repeatRule            CrownHuntRepeatRule   @default(once) @map("repeat_rule")
  availableFrom         DateTime?             @map("available_from")
  availableUntil        DateTime?             @map("available_until")
  approvedAt            DateTime?             @map("approved_at")
  approvedByUserId      String?               @map("approved_by_user_id") @db.Uuid
  createdByUserId       String                @map("created_by_user_id") @db.Uuid
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  approvedBy            User?                 @relation("CrownHuntPointApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  createdBy             User                  @relation("CrownHuntPointCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  claims                CrownHuntClaim[]

  @@index([status])
  @@index([availableFrom])
  @@index([availableUntil])
  @@index([latitude, longitude])
  @@map("crown_hunt_points")
}

/**
 * A single Kronjakt claim attempt by a user.
 *
 * Design rules:
 *  - Claims are never created automatically. The user must press the claim button.
 *  - Backend is the sole authority for eligibility, result, and points awarded.
 *  - An idempotencyKey prevents duplicate claims for the same button press.
 *  - Risk metadata is stored for admin review but never exposed to mobile clients.
 *  - Exact claim coordinates are not stored — distanceMeters is sufficient evidence.
 *  - No permanent route history is created.
 *  - Claim results are stored for all attempts (including rejections) for audit.
 *  - Points are awarded only when result = awarded.
 *
 * Privacy rules:
 *  - riskScore and riskReasons are internal — never return to mobile clients.
 *  - Other users' claims are never exposed.
 *  - No public leaderboard fields.
 */
model CrownHuntClaim {
  id                          String               @id @default(uuid()) @db.Uuid
  pointId                     String               @map("point_id") @db.Uuid
  userId                      String               @map("user_id") @db.Uuid
  /// Links to the Kronpoäng ledger entry created by an `awarded` claim.
  pointsLedgerEntryId         String?              @unique @map("points_ledger_entry_id") @db.Uuid
  result                      CrownHuntClaimResult
  claimedAt                   DateTime             @map("claimed_at")
  /// Distance from user's reported position to the point centre, in meters.
  /// Stored as evidence. Exact coordinates are NOT stored.
  distanceMeters              Float?               @map("distance_meters") @db.DoublePrecision
  reportedSpeedMetersPerSecond Float?              @map("reported_speed_meters_per_second") @db.DoublePrecision
  positionRecordedAt          DateTime?            @map("position_recorded_at")
  /// Internal risk score for this claim (0–100). Never exposed to mobile clients.
  riskScore                   Float?               @map("risk_score") @db.DoublePrecision
  /// Internal risk reason labels. Never exposed to mobile clients.
  riskReasons                 Json?                @map("risk_reasons")
  /// Prevents duplicate awards for the same button press.
  idempotencyKey              String               @unique @map("idempotency_key") @db.VarChar(200)
  createdAt                   DateTime             @default(now()) @map("created_at")

  point                       CrownHuntPoint       @relation(fields: [pointId], references: [id], onDelete: Restrict)
  user                        User                 @relation("CrownHuntClaimUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, claimedAt(sort: Desc)])
  @@index([pointId, claimedAt(sort: Desc)])
  @@index([result])
  @@map("crown_hunt_claims")
}

// ---------------------------------------------------------------------------
// KCC Företagspartner (Business Partner)
// ---------------------------------------------------------------------------

/**
 * Status of a partner application.
 *
 *  - submitted:    Application received, awaiting admin review.
 *  - under_review: An admin has started reviewing the application.
 *  - approved:     Application approved; a draft partner company may be created.
 *  - rejected:     Application rejected by admin (review reason required).
 *  - withdrawn:    Applicant or admin withdrew the application.
 */
enum PartnerApplicationStatus {
  submitted
  under_review
  approved
  rejected
  withdrawn
}

/**
 * Status of a partner company.
 *
 *  - draft:  Created by admin, not yet publicly visible.
 *  - active: Approved and publicly visible on the map.
 *  - paused: Temporarily hidden from the public map.
 *  - ended:  Partnership has ended; never hard-deleted.
 */
enum PartnerCompanyStatus {
  draft
  active
  paused
  ended
}

/**
 * Category of a partner company.
 */
enum PartnerCategory {
  workshop
  car_care
  parts
  tires
  charging
  restaurant
  retail
  other
}

/**
 * A partner application submitted via the app or the KCC website.
 *
 * Privacy rules:
 *  - Contact fields (contactName, contactEmail, contactPhone) are internal only.
 *    They must never appear in the public partner company response.
 *  - reviewReason is internal; never returned to the applicant or the public.
 *  - submittedByUserId is opaque and never exposed publicly.
 *
 * Access rules:
 *  - Admins and owners may list, review, approve, and reject applications.
 *  - The submitting user receives a status-only acknowledgement after submission.
 *  - Unauthenticated website submissions are prepared for (submittedByUserId is nullable).
 *
 * Soft-delete: applications are never hard-deleted; use withdrawn/rejected.
 */
model PartnerApplication {
  id                  String                  @id @default(uuid()) @db.Uuid
  companyName         String                  @db.VarChar(150)
  organizationNumber  String?                 @map("organization_number") @db.VarChar(30)
  category            PartnerCategory
  contactName         String                  @map("contact_name") @db.VarChar(120)
  /// Internal contact email — never exposed publicly.
  contactEmail        String                  @map("contact_email") @db.VarChar(254)
  contactPhone        String?                 @map("contact_phone") @db.VarChar(30)
  websiteUrl          String?                 @map("website_url") @db.VarChar(500)
  proposedDescription String?                 @map("proposed_description") @db.VarChar(1000)
  proposedAddress     String?                 @map("proposed_address") @db.VarChar(300)
  /// Applicant message. Plain text only.
  message             String?                 @db.VarChar(2000)
  status              PartnerApplicationStatus @default(submitted)
  /// Null for website submissions; set for authenticated app submissions.
  submittedByUserId   String?                 @map("submitted_by_user_id") @db.Uuid
  reviewedByUserId    String?                 @map("reviewed_by_user_id") @db.Uuid
  reviewedAt          DateTime?               @map("reviewed_at")
  /// Reason for rejection or review note. Internal only.
  reviewReason        String?                 @map("review_reason") @db.Text
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  submittedBy         User?                   @relation("PartnerApplicationSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  reviewedBy          User?                   @relation("PartnerApplicationReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  partnerCompany      PartnerCompany?

  @@index([status])
  @@index([createdAt])
  @@index([contactEmail])
  @@map("partner_applications")
}

/**
 * A partner company publicly visible on the KCC map.
 *
 * Design rules:
 *  - Partners start as `draft`. Activation requires explicit admin action.
 *  - Only `active` partners are visible through public APIs.
 *  - Partners are placed at their actual business location (latitude + longitude).
 *  - Partners cannot choose arbitrary advertising locations.
 *  - Do not hard-delete previously active partners; prefer `paused` or `ended`.
 *  - No offer, analytics, billboard, or invoice fields.
 *
 * Privacy rules:
 *  - publicPhone and publicWebsiteUrl are the only contact fields exposed.
 *  - Internal application contact details are never stored here.
 *  - No revenue, billing, or subscription data.
 */
model PartnerCompany {
  id                String               @id @default(uuid()) @db.Uuid
  /// Optional link to the approved application this company was created from.
  applicationId     String?              @unique @map("application_id") @db.Uuid
  companyName       String               @map("company_name") @db.VarChar(150)
  category          PartnerCategory
  /// Safe public-facing description. Plain text only.
  publicDescription String               @map("public_description") @db.VarChar(1000)
  address           String               @db.VarChar(300)
  latitude          Float                @db.DoublePrecision
  longitude         Float                @db.DoublePrecision
  /// Optional public phone number.
  publicPhone       String?              @map("public_phone") @db.VarChar(30)
  /// Optional public website URL.
  publicWebsiteUrl  String?              @map("public_website_url") @db.VarChar(500)
  status            PartnerCompanyStatus @default(draft)
  activatedAt       DateTime?            @map("activated_at")
  pausedAt          DateTime?            @map("paused_at")
  endedAt           DateTime?            @map("ended_at")
  createdByUserId   String               @map("created_by_user_id") @db.Uuid
  updatedByUserId   String?              @map("updated_by_user_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  application       PartnerApplication?      @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  createdBy         User                     @relation("PartnerCompanyCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy         User?                    @relation("PartnerCompanyUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  offers               PartnerOffer[]
  interactionEvents    PartnerInteractionEvent[]
  metricAggregates     PartnerMetricAggregate[]
  passbyContributions  PartnerPassByContribution[]
  sponsoredBillboards  SponsoredBillboard[]

  @@index([status])
  @@index([category])
  @@index([companyName])
  @@index([latitude, longitude])
  @@map("partner_companies")
}

enum PartnerOfferStatus {
  draft
  active
  paused
  ended
  expired
}

enum PartnerOfferType {
  discount_code
  percentage_discount
  fixed_discount
  member_benefit
  special_offer
  other
}

model PartnerOffer {
  id                         String              @id @default(uuid()) @db.Uuid
  partnerCompanyId           String              @map("partner_company_id") @db.Uuid
  title                      String              @db.VarChar(150)
  teaserText                 String              @map("teaser_text") @db.VarChar(250)
  description                String?             @db.Text
  offerType                  PartnerOfferType    @map("offer_type")
  status                     PartnerOfferStatus  @default(draft)
  /// Sensitive — must never appear in logs, teaser responses, or list responses.
  discountCode               String?             @map("discount_code") @db.VarChar(100)
  redemptionInstructions     String?             @map("redemption_instructions") @db.Text
  terms                      String?             @db.Text
  percentageDiscount         Float?              @map("percentage_discount") @db.DoublePrecision
  fixedDiscountMinorUnits    Int?                @map("fixed_discount_minor_units")
  currencyCode               String?             @map("currency_code") @db.VarChar(3)
  availableFrom              DateTime?           @map("available_from")
  availableUntil             DateTime?           @map("available_until")
  activatedAt                DateTime?           @map("activated_at")
  pausedAt                   DateTime?           @map("paused_at")
  endedAt                    DateTime?           @map("ended_at")
  createdByUserId            String              @map("created_by_user_id") @db.Uuid
  updatedByUserId            String?             @map("updated_by_user_id") @db.Uuid
  createdAt                  DateTime            @default(now()) @map("created_at")
  updatedAt                  DateTime            @updatedAt @map("updated_at")

  partnerCompany             PartnerCompany      @relation(fields: [partnerCompanyId], references: [id], onDelete: Restrict)
  createdBy                  User                @relation("PartnerOfferCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy                  User?               @relation("PartnerOfferUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  savedByUsers               SavedPartnerOffer[]

  @@index([partnerCompanyId])
  @@index([status])
  @@index([availableFrom])
  @@index([availableUntil])
  @@index([partnerCompanyId, status])
  @@map("partner_offers")
}

model SavedPartnerOffer {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  offerId   String       @map("offer_id") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at")

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer     PartnerOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([userId, offerId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([offerId])
  @@map("saved_partner_offers")
}


enum PartnerInteractionType {
  map_view
  profile_view
  navigate
  phone
  website
  offer_view
  show_code
  save_offer
  anonymous_pass_by
}

enum AggregationPeriodType {
  day
  week
  month
}

enum InsightResultStatus {
  available
  insufficient_data
  no_data
}

/**
 * Short-lived raw partner interaction event.
 *
 * Privacy rules:
 *  - userReferenceHash is a scoped pseudonymous value — not reversible or cross-partner-correlatable.
 *  - No exact coordinates, IP addresses, device IDs, or offer codes.
 *  - Raw events expire after INTERACTION_EVENT_TTL_DAYS (7 days by default).
 *  - expiresAt is set at insert time; a scheduled cleanup job removes expired rows.
 *  - Only allowlisted metadata may be stored (see PartnerInsightsService).
 *  - Explicit actions (map view, profile view, etc.) do not require anonymousPartnerStatsOptIn.
 *  - anonymous_pass_by type requires explicit opt-in — enforced in PartnerInsightsService.
 */
model PartnerInteractionEvent {
  id                String                 @id @default(uuid()) @db.Uuid
  partnerCompanyId  String                 @map("partner_company_id") @db.Uuid
  interactionType   PartnerInteractionType @map("interaction_type")
  /// Scoped pseudonymous hash — not the real user ID. Null for truly anonymous events.
  userReferenceHash String?                @map("user_reference_hash") @db.VarChar(64)
  occurredAt        DateTime               @map("occurred_at")
  aggregationDate   DateTime               @map("aggregation_date") @db.Date
  expiresAt         DateTime               @map("expires_at")
  /// Allowlisted metadata only — no codes, coordinates, or PII.
  metadata          Json?
  createdAt         DateTime               @default(now()) @map("created_at")

  partnerCompany    PartnerCompany         @relation(fields: [partnerCompanyId], references: [id], onDelete: Cascade)

  @@index([partnerCompanyId, aggregationDate])
  @@index([interactionType])
  @@index([expiresAt])
  @@index([partnerCompanyId, interactionType, aggregationDate])
  @@map("partner_interaction_events")
}

/**
 * Aggregated partner interaction metrics.
 *
 * Privacy rules:
 *  - No user-level data. totalCount and uniqueContributorCount are aggregate values only.
 *  - resultStatus reflects threshold enforcement (insufficient_data suppresses totalCount).
 *  - uniqueContributorCount is only populated when resultStatus = 'available'.
 *  - Aggregates are retained for reporting; raw events are cleaned up separately.
 */
model PartnerMetricAggregate {
  id                     String                 @id @default(uuid()) @db.Uuid
  partnerCompanyId       String                 @map("partner_company_id") @db.Uuid
  interactionType        PartnerInteractionType @map("interaction_type")
  periodType             AggregationPeriodType  @map("period_type")
  periodStart            DateTime               @map("period_start") @db.Date
  periodEnd              DateTime               @map("period_end") @db.Date
  totalCount             Int                    @map("total_count") @default(0)
  uniqueContributorCount Int?                   @map("unique_contributor_count")
  resultStatus           InsightResultStatus    @map("result_status") @default(no_data)
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")

  partnerCompany         PartnerCompany         @relation(fields: [partnerCompanyId], references: [id], onDelete: Cascade)

  @@unique([partnerCompanyId, interactionType, periodType, periodStart])
  @@index([partnerCompanyId, periodStart])
  @@index([interactionType])
  @@index([periodType])
  @@map("partner_metric_aggregates")
}

/**
 * Temporary pass-by contribution tracker.
 *
 * Purpose: Prevents double-counting a single user's pass-by for the same partner
 * on the same aggregation date. Deleted after aggregation.
 *
 * Privacy rules:
 *  - scopedContributorHash is a scoped pseudonymous hash — not the real user ID.
 *  - No exact coordinates, timestamps, or routes.
 *  - Expires after PASS_BY_CONTRIBUTION_TTL_DAYS (2 days by default).
 *  - Delete records immediately after aggregation.
 */
model PartnerPassByContribution {
  id                    String         @id @default(uuid()) @db.Uuid
  partnerCompanyId      String         @map("partner_company_id") @db.Uuid
  scopedContributorHash String         @map("scoped_contributor_hash") @db.VarChar(64)
  aggregationDate       DateTime       @map("aggregation_date") @db.Date
  expiresAt             DateTime       @map("expires_at")
  createdAt             DateTime       @default(now()) @map("created_at")

  partnerCompany        PartnerCompany @relation(fields: [partnerCompanyId], references: [id], onDelete: Cascade)

  @@unique([partnerCompanyId, scopedContributorHash, aggregationDate])
  @@index([partnerCompanyId, aggregationDate])
  @@index([expiresAt])
  @@map("partner_pass_by_contributions")
}


// ---------------------------------------------------------------------------
// Digital billboards
// ---------------------------------------------------------------------------

enum BillboardStatus {
  draft
  active
  paused
  ended
}

enum BillboardPlacementType {
  map_billboard
  event_area
  partner_area
  other_approved_location
}

enum BillboardCallToActionType {
  navigate
  phone
  website
  offer_view
  partner_profile
}

/**
 * A sponsored digital billboard placement on the map.
 *
 * Design rules:
 *  - Billboards are separate from the partner's real business location.
 *  - Billboards always start as draft.
 *  - Activation requires explicit admin safety confirmation.
 *  - Do not hard-delete active or previously-active billboards.
 *  - Status transitions only via dedicated service operations.
 *  - No scripts, HTML, executable content, or targeting profiles.
 *  - No image/video uploads in this step.
 *  - No auction or billing fields.
 *
 * Privacy rules:
 *  - safetyNote and approvalReason are internal only — never exposed publicly.
 *  - No user-level analytics on this model.
 *  - No personalisation or targeting fields.
 */
model SponsoredBillboard {
  id                  String                     @id @default(uuid()) @db.Uuid
  partnerCompanyId    String                     @map("partner_company_id") @db.Uuid
  /// Plain text only. Max 100 characters.
  headline            String                     @db.VarChar(100)
  /// Plain text only. Max 300 characters.
  message             String                     @db.VarChar(300)
  placementType       BillboardPlacementType     @map("placement_type")
  latitude            Float                      @db.DoublePrecision
  longitude           Float                      @db.DoublePrecision
  status              BillboardStatus            @default(draft)
  availableFrom       DateTime?                  @map("available_from")
  availableUntil      DateTime?                  @map("available_until")
  callToActionType    BillboardCallToActionType? @map("call_to_action_type")
  /// Phone or URL only where callToActionType requires it. Max 500 chars.
  callToActionValue   String?                    @map("call_to_action_value") @db.VarChar(500)
  /// Internal note for admin reference. Never exposed publicly. Max 500 chars.
  safetyNote          String?                    @map("safety_note") @db.VarChar(500)
  /// Approval reason written at activation. Internal only.
  approvalReason      String?                    @map("approval_reason") @db.Text
  approvedAt          DateTime?                  @map("approved_at")
  approvedByUserId    String?                    @map("approved_by_user_id") @db.Uuid
  activatedAt         DateTime?                  @map("activated_at")
  pausedAt            DateTime?                  @map("paused_at")
  endedAt             DateTime?                  @map("ended_at")
  createdByUserId     String                     @map("created_by_user_id") @db.Uuid
  updatedByUserId     String?                    @map("updated_by_user_id") @db.Uuid
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")

  partnerCompany      PartnerCompany             @relation(fields: [partnerCompanyId], references: [id], onDelete: Restrict)
  approvedBy          User?                      @relation("BillboardApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  createdBy           User                       @relation("BillboardCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy           User?                      @relation("BillboardUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([partnerCompanyId])
  @@index([availableFrom])
  @@index([availableUntil])
  @@index([latitude, longitude])
  @@map("sponsored_billboards")
}


// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

enum NotificationCategory {
  event_reminder
  event_updated
  event_cancelled
  admin_message
  account_warning
  account_suspension
  subscription_status
  system_notice
}

enum NotificationChannel {
  in_app
  push
}

enum NotificationDeliveryStatus {
  pending
  sent
  delivered
  failed
  skipped
}

enum NotificationDevicePlatform {
  ios
  android
}

/**
 * Push device registration.
 *
 * Design rules:
 *  - User ID is always derived from the authenticated session — never accepted from the client.
 *  - Raw push tokens are stored encrypted and must not appear in logs or API responses.
 *  - pushTokenHash is used for lookup and deduplication only.
 *  - A user may have more than one active device.
 *  - Stale registrations are deactivated, not deleted.
 *  - revokedAt records explicit revocation (e.g. logout).
 *
 * Privacy rules:
 *  - Never expose pushTokenHash or encryptedPushToken through any API.
 *  - Do not log push tokens at any log level.
 */
model PushDeviceRegistration {
  id                 String                    @id @default(uuid()) @db.Uuid
  userId             String                    @map("user_id") @db.Uuid
  platform           NotificationDevicePlatform
  /// SHA-256 hash of the push token for lookup and deduplication. Never expose directly.
  pushTokenHash      String                    @unique @map("push_token_hash") @db.VarChar(128)
  /// Encrypted push token. Decrypt only at delivery time. Never expose in responses or logs.
  encryptedPushToken String                    @map("encrypted_push_token") @db.Text
  appVersion         String?                   @map("app_version") @db.VarChar(50)
  buildNumber        String?                   @map("build_number") @db.VarChar(50)
  isActive           Boolean                   @default(true) @map("is_active")
  lastSeenAt         DateTime                  @default(now()) @map("last_seen_at")
  revokedAt          DateTime?                 @map("revoked_at")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryAttempts   NotificationDeliveryAttempt[]

  @@index([userId])
  @@index([platform])
  @@index([isActive])
  @@index([userId, isActive])
  @@map("push_device_registrations")
}

/**
 * Per-user per-category notification preference.
 *
 * Design rules:
 *  - Push is disabled until explicit device permission and registration.
 *  - In-app is enabled for all supported categories by default.
 *  - Essential account categories (account_warning, account_suspension) must keep inAppEnabled true.
 *  - Backend enforces essential category restrictions — client preferences are not a security boundary.
 *  - Do not combine push opt-in with terms acceptance.
 */
model NotificationPreference {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @map("user_id") @db.Uuid
  category    NotificationCategory
  pushEnabled Boolean              @default(false) @map("push_enabled")
  inAppEnabled Boolean             @default(true) @map("in_app_enabled")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
  @@map("notification_preferences")
}

/**
 * An in-app notification delivered to a single user.
 *
 * Design rules:
 *  - Content is plain text only. No HTML.
 *  - previewText must not contain protected details.
 *  - body may contain more detail but is still plain text.
 *  - Notifications expire per retention policy (90 days normal, longer for account notices).
 *  - Ownership is enforced at the service and route layer.
 *  - relatedEntityId is an opaque ID — never include exact coordinates or personal data.
 *
 * Retention:
 *  - Normal notifications: 90 days (expiresAt set at creation).
 *  - Account notices: up to 365 days.
 *  - Delivery attempts: shorter retention (see NotificationDeliveryAttempt).
 */
model UserNotification {
  id                String               @id @default(uuid()) @db.Uuid
  userId            String               @map("user_id") @db.Uuid
  category          NotificationCategory
  /// Plain text title. Max 100 chars.
  title             String               @db.VarChar(100)
  /// Safe preview text. Max 200 chars. Must not contain protected details.
  previewText       String               @map("preview_text") @db.VarChar(200)
  /// Plain text body. Optional. Max 1000 chars. No HTML.
  body              String?              @db.VarChar(1000)
  actionType        String?              @map("action_type") @db.VarChar(50)
  relatedEntityType String?              @map("related_entity_type") @db.VarChar(50)
  /// Opaque entity ID. Never store exact coordinates or personal data here.
  relatedEntityId   String?              @map("related_entity_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at")
  readAt            DateTime?            @map("read_at")
  expiresAt         DateTime?            @map("expires_at")
  /// Optional batch ID linking notifications sent by the same admin action.
  batchId           String?              @map("batch_id") @db.Uuid

  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryAttempts  NotificationDeliveryAttempt[]

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([category])
  @@index([expiresAt])
  @@index([batchId])
  @@map("user_notifications")
}

/**
 * Safe delivery tracking record per notification, channel, and device.
 *
 * Design rules:
 *  - Do not store raw provider responses; they may contain tokens or personal data.
 *  - providerMessageId is stored for correlation only; never expose in public API responses.
 *  - safeErrorCode contains only internal error codes, never token values.
 *  - Retry counts are bounded.
 */
model NotificationDeliveryAttempt {
  id                     String                     @id @default(uuid()) @db.Uuid
  userNotificationId     String                     @map("user_notification_id") @db.Uuid
  deviceRegistrationId   String?                    @map("device_registration_id") @db.Uuid
  channel                NotificationChannel
  status                 NotificationDeliveryStatus @default(pending)
  /// Internal provider correlation ID only. Never expose in public API responses.
  providerMessageId      String?                    @map("provider_message_id") @db.VarChar(255)
  attemptedAt            DateTime                   @default(now()) @map("attempted_at")
  completedAt            DateTime?                  @map("completed_at")
  /// Safe error code for diagnostics. Never include token values or personal data.
  safeErrorCode          String?                    @map("safe_error_code") @db.VarChar(100)

  userNotification       UserNotification           @relation(fields: [userNotificationId], references: [id], onDelete: Cascade)
  deviceRegistration     PushDeviceRegistration?    @relation(fields: [deviceRegistrationId], references: [id], onDelete: SetNull)

  @@index([userNotificationId])
  @@index([deviceRegistrationId])
  @@index([status])
  @@map("notification_delivery_attempts")
}

/**
 * Admin notification batch — tracks a mass send operation.
 *
 * Design rules:
 *  - idempotencyKey prevents duplicate sends.
 *  - Reason is mandatory and written to the audit log.
 *  - No full recipient list is stored here — per-user records are in UserNotification.
 *  - all_users and free_users audiences require confirmed=true.
 */
model AdminNotificationBatch {
  id               String                   @id @default(uuid()) @db.Uuid
  category         NotificationCategory
  audience         String                   @db.VarChar(50)
  title            String                   @db.VarChar(100)
  previewText      String                   @map("preview_text") @db.VarChar(200)
  body             String                   @db.VarChar(1000)
  actionType       String?                  @map("action_type") @db.VarChar(50)
  relatedEntityId  String?                  @map("related_entity_id") @db.Uuid
  recipientCount   Int                      @default(0) @map("recipient_count")
  reason           String                   @db.Text
  idempotencyKey   String                   @unique @map("idempotency_key") @db.VarChar(255)
  createdByUserId  String                   @map("created_by_user_id") @db.Uuid
  createdAt        DateTime                 @default(now()) @map("created_at")

  @@index([createdByUserId])
  @@index([createdAt])
  @@map("admin_notification_batches")
}
